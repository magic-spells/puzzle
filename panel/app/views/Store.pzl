<puzzle-view class="block p-3">
  <div class="rounded border border-dashed border-line bg-surface p-4">
    <h1 class="m-0 text-[13px] font-semibold text-ink">Store</h1>
    <p class="mt-1.5 mb-0 text-[12px] text-muted leading-relaxed">
      Record browsing by type, inline editing through the real
      <code class="font-mono text-accent">record.update()</code> path, and the
      subscription graph land here. This build ships the shell only.
    </p>
  </div>

  <section class="mt-3 rounded border border-line bg-surface overflow-hidden">
    <h2 class="m-0 flex items-center gap-2 px-3 py-1.5 border-b border-line text-[11px] font-semibold uppercase tracking-wide text-faint">
      Record types
      <button
        type="button"
        class="ml-auto rounded border border-line bg-raised px-1.5 py-0.5 text-[10px] font-normal normal-case tracking-normal text-ink hover:border-accent hover:text-accent"
        @click={ load }>
        { loading ? 'Loading…' : 'Load snapshot' }
      </button>
    </h2>

    {#if error}
      <p class="px-3 py-2 m-0 font-mono text-[11px] text-danger">{ error }</p>
    {:else if types.length === 0}
      <p class="px-3 py-2 m-0 text-[11px] text-faint">No snapshot loaded.</p>
    {:else}
      <ul class="m-0 p-0 list-none">
        {#for type in types}
          <li class="flex items-baseline gap-2 px-3 py-1 border-b border-line last:border-b-0">
            <span class="font-mono text-[12px] text-ink">{ type.id }</span>
            {#if type.dirty}
              <span class="font-mono text-[10px] text-warn">stale</span>
            {/if}
            <span class="ml-auto font-mono text-[11px] text-muted tabular-nums">{ type.count }</span>
          </li>
        {/for}
      </ul>
    {/if}
  </section>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import { api } from '../bridge.js';

export default class StoreView extends PuzzleView {
  created() {
    this.setData({ loading: false, error: '' });
  }

  data() {
    const local = this.getData();
    return {
      types: this.ctx.store.findMany('recordType'),
      loading: local.loading,
      error: local.error,
    };
  }

  events = {
    load: async () => {
      this.setData({ loading: true, error: '' });
      this.refresh();
      try {
        const result = await api.snapshotRecords();
        const buckets = result?.types ?? {};
        for (const [type, records] of Object.entries(buckets)) {
          const rows = Array.isArray(records) ? records : [];
          this.ctx.store.upsert('recordType', {
            id: type,
            records: rows,
            count: rows.length,
            dirty: false,
            snapshotAt: Date.now(),
          });
        }
      } catch (err) {
        this.setData('error', err?.message ?? String(err));
      } finally {
        this.setData('loading', false);
        this.refresh();
      }
    },
  };
}
</script>
