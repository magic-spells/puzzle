<puzzle-view class="h-full flex flex-col bg-canvas text-ink">
  <header class="shrink-0 flex items-center gap-2 h-8 px-2 border-b border-line bg-surface">
    <span class="font-mono text-[11px] font-semibold tracking-wider text-accent">PUZZLE</span>
    <span class="h-3 w-px bg-line"></span>
    <span class="inline-flex items-center gap-1.5 text-[11px] text-muted">
      <span class="h-1.5 w-1.5 rounded-full { statusDotClass }"></span>
      { statusLabel }
    </span>
    <span class="ml-auto font-mono text-[10px] text-faint tabular-nums">
      { eventCount } msg
    </span>
  </header>

  <div class="flex-1 flex min-h-0">
    <nav class="w-32 shrink-0 border-r border-line bg-surface overflow-y-auto py-1" aria-label="Panels">
      {#for item in nav}
        <a
          key={ item.path }
          class="flex items-baseline gap-1.5 px-2.5 py-1.5 text-[12px] no-underline { item.cls }"
          href="{ item.path | link }">
          <span>{ item.label }</span>
          {#if item.soon}
            <span class="ml-auto font-mono text-[9px] uppercase tracking-wide text-faint">soon</span>
          {/if}
        </a>
      {/for}
    </nav>

    <main class="flex-1 min-w-0 overflow-y-auto">
      <Slot/>
    </main>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import { CONNECTION_ID, CONNECTION_STATE } from '../models/connection.js';

const NAV = [
  { path: '/', label: 'Connection', soon: false },
  { path: '/views', label: 'Views', soon: true },
  { path: '/store', label: 'Store', soon: true },
];

const ACTIVE = 'bg-accent-soft text-accent font-medium';
const IDLE = 'text-muted hover:bg-raised hover:text-ink';

export default class Shell extends PuzzleView {
  data() {
    // Subscribes to the singleton, so the status chip tracks the connection
    // without the layout knowing anything about the transport.
    const connection = this.ctx.store.findOne('connection', CONNECTION_ID);
    const here = this.route?.pathname ?? '/';

    return {
      nav: NAV.map((item) => ({
        ...item,
        cls: item.path === here ? ACTIVE : IDLE,
      })),
      statusLabel: this.statusLabel(connection),
      statusDotClass: this.statusDotClass(connection),
      eventCount: connection?.eventCount ?? 0,
    };
  }

  statusLabel(connection) {
    if (!connection) return 'starting';
    if (connection.port === 'disconnected') return 'disconnected';
    if (connection.state === CONNECTION_STATE.MISMATCH) return 'version mismatch';
    if (connection.state === CONNECTION_STATE.CONNECTED) {
      return connection.appMounted ? 'connected' : 'app unmounted';
    }
    return 'no app';
  }

  statusDotClass(connection) {
    if (!connection) return 'bg-faint';
    if (connection.port === 'disconnected') return 'bg-danger';
    if (connection.state === CONNECTION_STATE.MISMATCH) return 'bg-warn';
    if (connection.state === CONNECTION_STATE.CONNECTED && connection.appMounted) return 'bg-ok';
    return 'bg-faint';
  }
}
</script>
