<puzzle-view>
  <div
    class={ rootClass }
    id={ rootId }
    role="slider"
    data-thumb="single"
    tabindex={ tabindex }
    aria-orientation={ ariaOrientation }
    aria-label={ ariaLabel }
    aria-valuemin={ minStr }
    aria-valuemax={ maxStr }
    aria-valuenow={ valueStr }
    aria-valuetext={ ariaValueText }
    aria-disabled={ ariaDisabled }
    @pointerdown={ onPointerDown(event) }
    @keydown={ onKeyDown(event) }
    @click={ onClick(event) }>

    <div class="absolute inset-0" data-slider-track>
      {#for tick in ticks}
        <span class={ tick.class } style={ tick.style } key={ tick.key }></span>
      {/for}
      <div class={ fillClass } style={ fillStyle }></div>
      <div class={ handleClass } style={ handleStyle }></div>
    </div>

    <div class={ textRowClass } aria-hidden="true">
      <span class={ labelClass }>{ labelText }</span>
      {#if showValue}
        <span class={ valueClass }>{ readout }</span>
      {/if}
    </div>

    {#if name}
      <input type="hidden" name={ name } value={ valueStr } />
    {/if}
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import {
  configFrom,
  quantize,
  clampBounds,
  round,
  normalize,
  valueToPercent,
  percentToValue,
  tickValues,
  edgeShift,
} from '../../lib/slider-math.js';

// Fader — a tall filled parameter row (DAW / Blender / After Effects style): a
// rounded row with an inline label on the left, a right-aligned value readout,
// faint interior ticks, and a thin bar handle. Functionally the same control as
// Slider, but it reads as a flat dial you turn UP rather than a scale you pick a
// point on. A CONTROLLED component: the parent owns the value and passes it as a
// prop; the fader keeps only its live drag position internally (setData draft)
// and reports changes through value-first callbacks.
//
//   <Fader label="Feather" value={ feather } max={ 20 } unit="px"
//          @input={ preview } @change={ commit } />
//
// SINGLE VALUE ONLY — no valueMin / valueMax, no range mode. Two 3px handles
// stacked in one row are invisible and undraggable, and the focus ring belongs
// to the whole row rather than to either of them. Need two thumbs? Use Slider.
//
// Props
//   value                number  — committed value
//   min (0) / max (100)  number  — bounds
//   step (1)             number | 'any'  — quantize detent; 'any' = continuous
//   disabled             boolean — blocks pointer + keyboard interaction
//   label                string  — VISIBLE inline label; doubles as the
//                                  accessible name (falls back to 'Value')
//   showValue (true)     boolean — render the right-aligned readout
//   formatValue          (value) => string — full control of the readout text
//   unit                 string  — appended verbatim when formatValue is absent
//                                  ('%' gives "60%"; pass ' dB' for a space)
//   ticks                boolean | number[] | {value, class?}[] — faint interior
//                                  marks. A per-tick `class` REPLACES the piece's
//                                  colour (two bg-* utilities on one element
//                                  resolve by CSS source order, not by attribute
//                                  order). Tick `label`s are ignored — a fader
//                                  has no label row; use formatValue for a
//                                  value-specific readout like 'Off'.
//   tickStep             number  — interval when ticks={ true }; auto-coarsened
//                                  from step when omitted
//   orientation          'horizontal' (default) | 'vertical'
//   name                 string  — emits a hidden input for form posts
//   id                   string  — id on the root
//   class                string  — extra utilities merged onto the root
//
// Callbacks (value-first)
//   @input   — live during drag / on each key step
//   @change  — commit on pointer release, row tap, and each key (native
//              <input type=range> parity)
//
// GESTURE MODEL — the gesture model is intentionally duplicated from Slider.pzl
// — fix pointer bugs in both. It is the same machine with every two-thumb path
// removed (no _isRange, no _nearestThumb, no crossover clamp, no deferred
// stacked-thumb resolution, no thumb-press branch):
//   1. GESTURE ARMING — there is no thumb to grab, so EVERY press only ARMS.
//      More than 3px of MAIN-axis movement promotes it to a drag and the value
//      jumps under the pointer; a press that never moves settles as a tap.
//   2. TOUCH CAPTURE AVOIDANCE — setPointerCapture is called for mouse/pen ONLY;
//      touch rides implicit capture (explicit capture mid-touch fires a spurious
//      pointercancel on some mobile engines). The root's touch-action makes the
//      INITIAL axis decision; a window touchmove listener preventDefaults once a
//      drag is live to axis-lock against cross-axis creep.
//   3. NORMALIZE IDEMPOTENCY — every value is quantized to step, clamped to
//      [min,max] and rounded by lib/slider-math.js; update loops are guarded by
//      value EQUALITY, not flags.
//   4. TAP-VS-DRAG TRANSITIONS — a `dragging` flag swaps the fill and handle to
//      transition-none so drags track the pointer raw, while a row tap (armed,
//      no move) and keyboard steps animate across (transitions on).
//
// ORIENTATION — all geometry runs through the AXIS table below, so the two
// orientations differ in data, never in branches. Two consequences:
//   - vertical measures DOWNWARD from rect.top while its BOTTOM is min, so the
//     raw percent is flipped (invert: true).
//   - SCROLL TRADE-OFF: a vertical fader cannot share the vertical axis with the
//     page, so it claims the axis outright (touch-none) and a touch that starts
//     on it will never scroll the page. Put vertical faders in fixed panels and
//     channel strips, not in the middle of a long scrolling page. A horizontal
//     fader keeps touch-pan-y and hands a vertical-first gesture back to the
//     browser — which is why disarming on cross-axis movement is gated on
//     `yieldsToScroll` instead of firing for both orientations.
//   Keyboard needs no branch at all: ArrowUp and ArrowRight both increase.

const DRAG_THRESHOLD = 3;

// normalize()'s crossover clamp only fires for the 'min' / 'max' thumbs, so a
// single-thumb caller has no opposing value to hand it.
const NO_PAIR = Object.freeze({});

// edgeShift() is written for an axis anchored at its START (left): interior
// marks pull back half their size, the far end pulls back fully. The vertical
// axis is anchored at the BOTTOM and grows upward, so the identical pull-back
// has to point DOWN the screen — negate it rather than re-deriving thresholds.
function flipShift(shift) {
  return shift === '0%' ? '0%' : shift.slice(1);
}

const ROOT_BASE =
  'relative flex select-none items-center overflow-hidden rounded-lg ' +
  'border border-border bg-surface-sunken ' +
  'outline-ring focus-visible:outline-2 focus-visible:outline-offset-2';

// Marks, fills and handles are positioned through the inline `translate`
// PROPERTY, never a Tailwind translate utility: the utility writes the same
// property, so the two would not compose — one would silently win. Keeping every
// shift inline means both axes of the translate are always stated together.
const TICK_COLOR = 'bg-faint';

const AXIS = {
  horizontal: {
    main: (e) => e.clientX,
    cross: (e) => e.clientY,
    extent: (r) => r.width,
    origin: (r) => r.left,
    invert: false,
    // The cross axis IS the page-scroll axis, so leave panning to the browser.
    touch: 'touch-pan-y',
    yieldsToScroll: true,
    size: 'h-10 w-full',
    cursor: 'cursor-ew-resize',
    ariaOrientation: 'horizontal',
    fillClass: 'absolute inset-y-0 left-0 bg-brand/25',
    fillStyle: (p) => `width:${p}%`,
    fillTrans: 'transition-[width] duration-150 ease-out',
    handleClass: 'absolute inset-y-1 w-[3px] rounded-full bg-brand',
    handleStyle: (p) => `left:${p}%;translate:${edgeShift(p)} 0`,
    handleTrans: 'transition-[left,translate] duration-150 ease-out',
    tickBase: 'absolute top-1/2 h-2 w-px',
    tickStyle: (p) => `left:${p}%;translate:${edgeShift(p)} -50%`,
    textRow: 'pointer-events-none relative flex w-full items-center gap-3 px-3',
    labelClass: 'min-w-0 flex-1 truncate text-sm font-medium text-ink',
    valueClass: 'shrink-0 text-sm tabular-nums text-ink',
  },
  vertical: {
    main: (e) => e.clientY,
    cross: (e) => e.clientX,
    extent: (r) => r.height,
    origin: (r) => r.top,
    // Measured downward from rect.top, but the BOTTOM of the strip is min.
    invert: true,
    // Nothing to yield: this fader owns the vertical axis. See the header note.
    touch: 'touch-none',
    yieldsToScroll: false,
    size: 'h-40 w-14 flex-col',
    cursor: 'cursor-ns-resize',
    ariaOrientation: 'vertical',
    fillClass: 'absolute inset-x-0 bottom-0 bg-brand/25',
    fillStyle: (p) => `height:${p}%`,
    fillTrans: 'transition-[height] duration-150 ease-out',
    handleClass: 'absolute inset-x-1 h-[3px] rounded-full bg-brand',
    handleStyle: (p) => `bottom:${p}%;translate:0 ${flipShift(edgeShift(p))}`,
    handleTrans: 'transition-[bottom,translate] duration-150 ease-out',
    tickBase: 'absolute left-1/2 h-px w-2',
    tickStyle: (p) => `bottom:${p}%;translate:-50% ${flipShift(edgeShift(p))}`,
    // column-reverse puts the readout on top and the label at the bottom, the
    // classic channel-strip order, without reordering the DOM.
    textRow:
      'pointer-events-none relative flex h-full w-full flex-col-reverse items-center justify-between gap-2 px-2 py-2',
    labelClass: 'max-w-full truncate text-xs font-medium text-ink',
    valueClass: 'shrink-0 text-xs tabular-nums text-ink',
  },
};

export default class Fader extends PuzzleView {
  created() {
    this._resetDrag();
    this._suppressClick = false;
    this._overlayTimer = null;
    this._listening = false;
    this._tickCache = null;
    this._onWinMove = (e) => this._pointerMove(e);
    this._onWinEnd = (e) => this._pointerEnd(e);
    this._onTouchMove = (e) => {
      // axis-lock: once a drag is live, stop the page creeping along the cross
      // axis — touch-action only made the INITIAL decision.
      if (this._drag.dragging && e.cancelable) e.preventDefault();
    };
    // Local draft (drives rendering while dragging / settling). draftValue null
    // means "render the committed value straight from props".
    this.setData({ dragging: false, draftValue: null });
  }

  destroyed() {
    this._removeWindowListeners();
    if (this._overlayTimer) clearTimeout(this._overlayTimer);
  }

  data(params, props) {
    const cfg = configFrom(props);
    const axis = this._axis(props);
    const committed = this._committed(props, cfg);
    const d = this.getData();
    const dragging = !!d.dragging;

    // Overlay the internal draft over the committed value: while dragging (or
    // during the brief settle window before props catch up) the fader renders
    // from the draft.
    const renderValue = d.draftValue === null ? committed : d.draftValue;
    const percent = valueToPercent(renderValue, cfg);
    const disabled = !!props.disabled;

    const labelText = props.label == null ? '' : String(props.label);
    const readout = this._format(renderValue, props);
    const valueStr = String(renderValue);

    return {
      rootId: props.id || false,
      rootClass: [
        ROOT_BASE,
        axis.size,
        axis.touch,
        disabled ? 'cursor-not-allowed opacity-50' : axis.cursor,
        props.class || '',
      ]
        .filter(Boolean)
        .join(' '),
      ticks: this._ticks(props, cfg, axis),
      fillClass: `${axis.fillClass} ${dragging ? 'transition-none' : axis.fillTrans}`,
      fillStyle: axis.fillStyle(percent),
      handleClass: `${axis.handleClass} ${dragging ? 'transition-none' : axis.handleTrans}`,
      handleStyle: axis.handleStyle(percent),
      textRowClass: axis.textRow,
      labelClass: axis.labelClass,
      valueClass: axis.valueClass,
      labelText,
      readout,
      showValue: props.showValue !== false,
      tabindex: disabled ? '-1' : '0',
      ariaOrientation: axis.ariaOrientation,
      ariaLabel: labelText || 'Value',
      ariaDisabled: disabled ? 'true' : false,
      // aria-valuetext REPLACES the announced number, so only send it when the
      // readout actually says something the raw value doesn't. `false` omits it.
      ariaValueText: readout && readout !== valueStr ? readout : false,
      minStr: String(cfg.min),
      maxStr: String(cfg.max),
      valueStr,
      name: props.name || false,
    };
  }

  // Once props reflect the committed draft, drop the overlay silently (no visual
  // change). Deferred out of the render stack to avoid afterUpdate re-entrancy.
  afterUpdate() {
    const d = this.getData();
    if (this._pendingClearCheck || d.dragging || d.draftValue === null) return;
    const cfg = configFrom(this.props);
    if (this._committed(this.props, cfg) !== d.draftValue) return;
    this._pendingClearCheck = true;
    queueMicrotask(() => {
      this._pendingClearCheck = false;
      const now = this.getData();
      if (now.draftValue !== null && !now.dragging) {
        this.setData({ draftValue: null });
        this.refresh();
      }
    });
  }

  // --- config / committed-state derivation -----------------------------------

  _axis(props) {
    return props.orientation === 'vertical' ? AXIS.vertical : AXIS.horizontal;
  }

  // The committed value straight from props, normalized.
  _committed(props, cfg) {
    const raw = Number(props.value);
    return round(clampBounds(quantize(Number.isFinite(raw) ? raw : cfg.min, cfg), cfg), cfg);
  }

  _format(value, props) {
    const fn = props.formatValue;
    if (typeof fn === 'function') {
      const out = fn(value);
      return out == null ? '' : String(out);
    }
    return props.unit ? `${value}${props.unit}` : String(value);
  }

  // Ticks are static geometry — unlike Slider's they carry no active/inactive
  // state (the translucent fill lets them show THROUGH rather than occluding
  // them), so the whole list is cached by identity and rebuilt only when the
  // spec, the bounds or the orientation actually change. Identity, never
  // JSON.stringify: stringifying the array every frame of a drag would cost
  // more than everything else in data() combined.
  _ticks(props, cfg, axis) {
    const cache = this._tickCache;
    if (
      cache &&
      cache.spec === props.ticks &&
      cache.tickStep === props.tickStep &&
      cache.min === cfg.min &&
      cache.max === cfg.max &&
      cache.step === cfg.step &&
      cache.axis === axis
    ) {
      return cache.list;
    }
    const list = tickValues(cfg, props.ticks, props.tickStep).map((t, i) => ({
      key: `t${i}`,
      // A custom class REPLACES the piece's colour instead of appending to it.
      class: `${axis.tickBase} ${t.class ? t.class : TICK_COLOR}`,
      style: axis.tickStyle(valueToPercent(t.value, cfg)),
    }));
    this._tickCache = {
      spec: props.ticks,
      tickStep: props.tickStep,
      min: cfg.min,
      max: cfg.max,
      step: cfg.step,
      axis,
      list,
    };
    return list;
  }

  // --- geometry --------------------------------------------------------------

  _percentFromEvent(event, axis) {
    const track = this.element && this.element.querySelector('[data-slider-track]');
    if (!track) return 0;
    const rect = track.getBoundingClientRect();
    const extent = axis.extent(rect);
    if (!extent) return 0;
    const raw = ((axis.main(event) - axis.origin(rect)) / extent) * 100;
    // Vertical is measured downward from the top edge but its bottom is min.
    const pct = axis.invert ? 100 - raw : raw;
    return Math.max(0, Math.min(100, pct));
  }

  // --- gesture bookkeeping (transient — never setData, must not re-render) ----

  _resetDrag() {
    this._drag = {
      pointerId: null,
      armed: false,
      dragging: false,
      startMain: 0,
      startCross: 0,
      startValue: 0,
    };
  }

  _teardownGesture() {
    this._resetDrag();
    this._removeWindowListeners();
  }

  _addWindowListeners() {
    if (this._listening || typeof window === 'undefined') return;
    this._listening = true;
    window.addEventListener('pointermove', this._onWinMove);
    window.addEventListener('pointerup', this._onWinEnd);
    window.addEventListener('pointercancel', this._onWinEnd);
    window.addEventListener('lostpointercapture', this._onWinEnd);
    window.addEventListener('touchmove', this._onTouchMove, { passive: false });
  }

  _removeWindowListeners() {
    if (!this._listening || typeof window === 'undefined') return;
    this._listening = false;
    window.removeEventListener('pointermove', this._onWinMove);
    window.removeEventListener('pointerup', this._onWinEnd);
    window.removeEventListener('pointercancel', this._onWinEnd);
    window.removeEventListener('lostpointercapture', this._onWinEnd);
    window.removeEventListener('touchmove', this._onTouchMove, { passive: false });
  }

  _capturePointer(event) {
    // Mouse/pen only — see gesture note 2 (touch capture avoidance).
    if (event.pointerType === 'touch') return;
    try {
      this.element.setPointerCapture(event.pointerId);
    } catch (_) {
      /* best effort */
    }
  }

  _releasePointer(event) {
    try {
      if (this.element && this.element.hasPointerCapture && this.element.hasPointerCapture(event.pointerId)) {
        this.element.releasePointerCapture(event.pointerId);
      }
    } catch (_) {
      /* best effort */
    }
  }

  _emit(type, value) {
    const fn = this.props[type];
    if (typeof fn === 'function') fn(value);
  }

  // Keep the draft overlaid until props reflect the commit (afterUpdate drops it
  // when they match); this fallback reverts to the committed value if the parent
  // never applies the change (uncontrolled usage).
  _scheduleOverlayClear() {
    if (this._overlayTimer) clearTimeout(this._overlayTimer);
    this._overlayTimer = setTimeout(() => {
      this._overlayTimer = null;
      const d = this.getData();
      if (d.draftValue !== null && !d.dragging) {
        this.setData({ draftValue: null });
        this.refresh();
      }
    }, 90);
  }

  // --- pointer flow (move/end run off window listeners during a gesture) ------

  _pointerMove(event) {
    const drag = this._drag;
    if (drag.pointerId !== event.pointerId) return;

    // mouse/pen released where we couldn't hear the up
    if (event.pointerType !== 'touch' && event.buttons === 0) {
      this._pointerEnd(event);
      return;
    }

    const props = this.props;
    const cfg = configFrom(props);
    const axis = this._axis(props);

    if (!drag.dragging) {
      const deltaMain = Math.abs(axis.main(event) - drag.startMain);
      const deltaCross = Math.abs(axis.cross(event) - drag.startCross);
      // Cross-axis-first intent hands the gesture back to the browser to scroll
      // with — but ONLY when the cross axis is the page-scroll axis. A vertical
      // fader already claimed the scroll axis (touch-none), so it has nothing to
      // hand back and disarming there would just make it feel dead.
      if (axis.yieldsToScroll && deltaCross > deltaMain) {
        this._teardownGesture();
        return;
      }
      if (deltaMain <= DRAG_THRESHOLD) return;
      // promote: the value jumps under the pointer. There is no thumb to grab,
      // so this one rule covers every press.
      drag.startValue = this._committed(props, cfg);
      drag.dragging = true;
      this._suppressClick = true;
      this._capturePointer(event);
    }

    const raw = percentToValue(this._percentFromEvent(event, axis), cfg);
    const nv = normalize(raw, 'single', cfg, NO_PAIR);
    const d = this.getData();
    if (d.draftValue !== nv || !d.dragging) {
      this.setData({ dragging: true, draftValue: nv });
      this.refresh();
      this._emit('input', nv);
    }
  }

  _pointerEnd(event) {
    const drag = this._drag;
    if (drag.pointerId !== event.pointerId) return;
    this._releasePointer(event);

    const armed = drag.armed;
    const dragging = drag.dragging;
    const startValue = drag.startValue;
    const props = this.props;
    const cfg = configFrom(props);
    const axis = this._axis(props);
    const committed = this._committed(props, cfg);
    this._teardownGesture();

    if (dragging) {
      const finalValue = this.getData().draftValue;
      // dragging → false re-enables transitions; the overlay stays until props
      // catch up (afterUpdate) or the fallback timer reverts it.
      this.setData({ dragging: false });
      this.refresh();
      if (finalValue !== startValue) this._emit('change', finalValue);
      this._scheduleOverlayClear();
    } else if (armed && event.type === 'pointerup') {
      // row TAP (armed, never moved): the fill animates over (transitions are on
      // because dragging is false).
      const nv = normalize(percentToValue(this._percentFromEvent(event, axis), cfg), 'single', cfg, NO_PAIR);
      this._suppressClick = true;
      if (nv !== committed) {
        this.setData({ dragging: false, draftValue: nv });
        this.refresh();
        this._emit('input', nv);
        this._emit('change', nv);
        this._scheduleOverlayClear();
      }
      if (this.element && this.element.focus) this.element.focus({ preventScroll: true });
    }
  }

  events = {
    onPointerDown: (event) => {
      this._suppressClick = false;
      if (this.props.disabled) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      // self-heal a stale armed gesture, but never hijack a live drag
      if (this._drag.pointerId !== null) {
        if (this._drag.dragging) return;
        this._teardownGesture();
      }
      if (this._overlayTimer) {
        clearTimeout(this._overlayTimer);
        this._overlayTimer = null;
      }

      // Every press only ARMS, wherever in the row it lands — the visual handle
      // is decorative, so there is no unambiguous grab that could start a drag
      // outright. It may still resolve as a page scroll or as a tap.
      const axis = this._axis(this.props);
      this._drag = {
        pointerId: event.pointerId,
        armed: true,
        dragging: false,
        startMain: axis.main(event),
        startCross: axis.cross(event),
        startValue: 0,
      };
      this._addWindowListeners();
    },

    onKeyDown: (event) => {
      if (this.props.disabled) return;
      const cfg = configFrom(this.props);
      const current = this._committed(this.props, cfg);
      const stepSize = cfg.step === 'any' ? (cfg.max - cfg.min) / 100 : cfg.step;
      const pageSize = stepSize * 10;

      let next = null;
      switch (event.key) {
        // No orientation branch: up and right both increase in either
        // orientation, which is what a vertical slider is specified to do too.
        case 'ArrowRight':
        case 'ArrowUp':
          next = current + stepSize;
          break;
        case 'ArrowLeft':
        case 'ArrowDown':
          next = current - stepSize;
          break;
        case 'PageUp':
          next = current + pageSize;
          break;
        case 'PageDown':
          next = current - pageSize;
          break;
        case 'Home':
          next = cfg.min;
          break;
        case 'End':
          next = cfg.max;
          break;
        default:
          return;
      }
      event.preventDefault();
      const nv = normalize(next, 'single', cfg, NO_PAIR);
      if (nv === current) return;
      // Keys are commits (native <input type=range> parity): fire @input AND
      // @change. Overlay optimistically so the fill animates even before props
      // land (transitions on because dragging is false).
      this.setData({ dragging: false, draftValue: nv });
      this.refresh();
      this._emit('input', nv);
      this._emit('change', nv);
      this._scheduleOverlayClear();
    },

    onClick: (event) => {
      // swallow the click that trails a real drag or a row tap
      if (!this._suppressClick) return;
      this._suppressClick = false;
      event.preventDefault();
      event.stopPropagation();
    },
  };
}
</script>
