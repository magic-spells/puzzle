<puzzle-view>
  <dialog-panel ref="panel">
    <dialog-backdrop class={ backdropClass }></dialog-backdrop>

    <dialog
      class={ panelClass }
      role="dialog"
      aria-modal="true"
      aria-label={ ariaLabel }>
      <div class="flex items-center gap-2 border-b border-border px-3">
        <svg
          class="size-4 shrink-0 text-muted"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true">
          <circle cx="9" cy="9" r="6" />
          <path d="M14 14l4 4" stroke-linecap="round" />
        </svg>
        <input
          data-command-input
          id={ inputId }
          type="text"
          class="h-11 w-full bg-transparent text-sm text-ink placeholder:text-muted focus:outline-none"
          role="combobox"
          aria-expanded="true"
          aria-controls={ listId }
          aria-activedescendant={ activeId }
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder={ placeholder }
          value={ query }
          @input={ onInput(event) }
          @keydown:down:prevent={ moveDown }
          @keydown:up:prevent={ moveUp }
          @keydown:enter={ onEnter(event) } />
      </div>

      <div class="max-h-72 overflow-y-auto p-1" id={ listId } role="listbox">
        {#if empty}
          <p class="py-6 text-center text-sm text-muted">{ emptyText }</p>
        {:else}
          {#for row in rows}
            <div
              id={ row.id }
              role={ row.role }
              data-opt-index={ row.optIndex }
              aria-selected={ row.ariaSelected }
              aria-disabled={ row.ariaDisabled }
              class={ row.cls }
              @click={ choose(row, event) }
              @mouseenter={ hover(row) }>
              {#if row.kind === 'option'}
                <Slot
                  name="option"
                  item={ row.item }
                  active={ row.active }
                  selected={ row.selected }
                  disabled={ row.disabled }>
                  <span class="truncate">{ row.label }</span>
                  {#if row.hint}
                    <span class="shrink-0 text-xs text-muted">{ row.hint }</span>
                  {/if}
                </Slot>
              {:else}
                { row.label }
              {/if}
            </div>
          {/for}
        {/if}
      </div>
    </dialog>
  </dialog-panel>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// Command — a command palette, self-contained: no other pieces imported. Built
// on the native <dialog> element so the browser does the hard parts —
// showModal() traps focus and inerts the page, the top layer comes free, and
// Escape arrives as the `cancel` event. Filtering, grouping, ranking, and
// roving keyboard navigation are Puzzle-native: local UI state (query,
// activeIndex) via setData + refresh(), imperative DOM only for focus and
// scrollIntoView.
//
// THE OVERLAY IS A WRAPPER, NOT A PORT. Like Dialog, AlertDialog, Sheet and
// BottomSheet, the palette renders the real <dialog-panel> / <dialog-backdrop>
// custom elements from @magic-spells/dialog-panel and lets them run the
// open/close machine: the scrim and panel fade in AND out (a raw showModal()
// has no exit and its ::backdrop is unreachable from dialog.animate()),
// Escape, the backdrop click, the page scroll lock and focus return are all
// upstream. One base for every overlay in the registry means one loaded
// module and one close-and-notify contract. <dialog-backdrop> is THE scrim
// surface across the family — the native ::backdrop stays transparent — so
// the overlay colour is two utilities on that element, the same pair Dialog
// uses.
//
//   <Command
//     open={ open }
//     items={ commands }
//     @select={ (value) => runCommand(value) }
//     @close={ () => this.setData('open', false) } />
//
// Each `items` entry is { value, label, group?, keywords?, disabled?, hint? }:
//   value     — passed back to @select on activation
//   label     — visible text (falls back to String(value))
//   group?    — optional heading; ungrouped items render first, then each group
//   keywords? — string[] of extra terms that also match the query
//   disabled? — rendered but not selectable, skipped by keyboard nav
//   hint?     — right-aligned kbd-ish hint text (⌘K, ⏎, "Recent"…)
//
// OPTION SNIPPET. A direct-child <Snippet fits="option" item active selected
// disabled> replaces only the visual content inside each option element. `item`
// is the original authored option/item object; `active` is the current keyboard/
// pointer highlight; `selected` is persistent controlled-value membership (false
// in Command, which has no persistent selection, and in MultiSelect's dropdown,
// where selected entries are hidden); `disabled` mirrors item.disabled. The
// piece still owns the option element's id, role, aria state, and handlers. The
// Snippet body cannot contain composition markers or ref=. With no snippet, the
// marker fallback renders the stock row unchanged.
//
// CONTROLLED BY THE PARENT, EDGE-TRIGGERED. The parent owns `open`, but only a
// CHANGE to it acts: true → panel.show(), false → panel.hide(). The palette
// re-renders on every keystroke, so a level-triggered sync would re-open a
// palette the user just dismissed while the parent's state still said open.
// Command never sets `open` itself — it only *asks* the parent to close via
// the `close` callback, and the parent's flip to false is then a no-op edge
// against an already-closed panel.
//
// TWO CALLBACKS, TWO MEANINGS:
//   @select(value, event) — fires when an item is activated (Enter or click).
//     The parent decides what happens next, INCLUDING whether to close (flip
//     `open`). Command does NOT auto-close after a select — a palette often runs
//     an action and stays open, so that call belongs to the parent.
//   @close() — fires ONLY for user-driven dismissal: Escape, a backdrop click,
//     or a [data-action-hide-dialog] descendant. dialog-panel closes itself
//     on those and reports through its `hidden` event once the exit fade has
//     finished; a close the parent asked for by flipping `open` is flagged
//     at `beforeHide` and never reported back. The parent flips `open` false
//     in @close so the next open is a fresh edge.
//
// LOADING. The package registers its custom elements at module scope with
// `class extends HTMLElement`, a ReferenceError under Node — so a top-level
// import would crash the prerender pass. The import lives in mounted()
// instead, and an `open` that is already true when the view mounts is applied
// the moment the module arrives.
//
// STYLESHEET. Add it once to your app's style entry — Dialog, AlertDialog,
// Sheet and BottomSheet need the same one import:
//   @import "@magic-spells/dialog-panel/css" layer(components);
// The layer matters: the stylesheet uses plain element selectors, and an
// unlayered import would outrank every utility on the panel.
//
// WHAT DIALOG-PANEL OWNS, AND THIS PIECE MUST NOT SET: `opacity`, `transform`
// and `transition` on the <dialog>, plus `display` / `opacity` / `transition`
// on <dialog-backdrop>, all keyed off the [state] attribute. The one motion
// utility here is `motion-reduce:duration-1`, which shortens both fades to a
// millisecond under prefers-reduced-motion — a duration, not a transition, so
// dialog-panel still gets the `transitionend` it waits on before it closes
// the native element (`transition-none` would leave an invisible modal open
// until the 700ms fallback).
//
// GLOBAL HOTKEY IS NOT THIS COMPONENT'S JOB — the parent (usually a layout) binds
// it and flips `open`. A layout-level idea:
//   <div @keydown={ onHotkey(event) }> … <Command open={ cmdOpen } … /> </div>
//   onHotkey: (e) => {
//     if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
//       e.preventDefault();
//       this.setData('cmdOpen', true);
//     }
//   }
let uid = 0;

// The overlay: the look the rest of the overlay family lands on.
const OVERLAY = 'bg-black/50 backdrop-blur-sm motion-reduce:duration-1';

// The panel. `m-auto` is not decoration: a modal <dialog> is centred by the
// browser through `margin: auto` against four zeroed insets, and Tailwind's
// preflight resets margin to 0 on every element.
const PANEL_BASE =
  'm-auto mt-[15vh] w-full max-w-lg rounded-xl border border-border bg-surface p-0 ' +
  'text-body shadow-xl overflow-hidden motion-reduce:duration-1';

const OPTION_BASE =
  'flex items-center justify-between gap-3 rounded-md px-2 py-1.5 text-sm select-none';
const GROUP_CLS = 'px-2 pt-2 pb-1 text-xs font-medium text-muted';

// A query "matches" a term as a word-prefix (query starts the term, or any
// space-delimited word within it) or, more loosely, as a substring anywhere.
function wordPrefix(text, q) {
  if (text.startsWith(q)) return true;
  return text.split(/\s+/).some((w) => w.startsWith(q));
}

export default class Command extends PuzzleView {
  created() {
    this._uid = ++uid;
    this._base = `pp-command-${this._uid}`;
    this._scrollActive = false; // scroll the active option into view after next render
    this._panel = null;
    this._live = false;
    this._ready = false;
    this._lastOpen = false;
    // A hide the wrapper asked for (read by beforeHide, set for one synchronous
    // stretch only) and a hide the user asked for (carried to `hidden`).
    this._selfHiding = false;
    this._userHide = false;
    // Seed local UI state so the first data() run can read it back.
    this.setData({ query: '', activeIndex: -1 });
  }

  // Normalize `items` into a flat render list (`rows` — a mix of group headings
  // and options) plus the option-only list keyboard nav walks (`options`).
  // Filtering is case-insensitive against label + keywords; ranking is a stable
  // two-tier sort (word-prefix matches above substring-only matches); grouping
  // renders ungrouped items first, then each group (ordered by first appearance
  // in the ranked list) with its heading.
  _build(props, query) {
    const base = this._base;
    const raw = Array.isArray(props.items) ? props.items : [];
    const q = String(query || '').trim().toLowerCase();

    const matched = [];
    raw.forEach((entry, i) => {
      if (entry == null) return;
      const label = entry.label != null ? String(entry.label) : String(entry.value ?? '');
      const keywords = Array.isArray(entry.keywords) ? entry.keywords.map(String) : [];
      let tier;
      if (!q) {
        tier = 0;
      } else {
        const hay = [label, ...keywords].map((t) => t.toLowerCase());
        if (hay.some((t) => wordPrefix(t, q))) tier = 0;
        else if (hay.some((t) => t.includes(q))) tier = 1;
        else return; // no match — drop it
      }
      matched.push({
        item: entry,
        value: entry.value,
        label,
        hint: entry.hint != null ? String(entry.hint) : '',
        group: entry.group != null ? String(entry.group) : null,
        disabled: !!entry.disabled,
        tier,
        order: i,
      });
    });

    // Stable two-tier sort: word-prefix (0) before substring (1); original
    // order preserved within a tier (Array.sort is stable).
    matched.sort((a, b) => a.tier - b.tier || a.order - b.order);

    // Partition: ungrouped first, then groups in first-appearance order.
    const ungrouped = [];
    const groupOrder = [];
    const groupMap = new Map();
    matched.forEach((m) => {
      if (m.group == null) {
        ungrouped.push(m);
        return;
      }
      if (!groupMap.has(m.group)) {
        groupMap.set(m.group, []);
        groupOrder.push(m.group);
      }
      groupMap.get(m.group).push(m);
    });

    const rows = [];
    const options = [];
    let optIndex = 0;
    const pushOption = (m) => {
      const row = {
        kind: 'option',
        id: `${base}-opt-${optIndex}`,
        optIndex,
        item: m.item,
        value: m.value,
        label: m.label,
        hint: m.hint,
        disabled: m.disabled,
        active: false,
        selected: false,
      };
      rows.push(row);
      options.push(row);
      optIndex++;
    };

    ungrouped.forEach(pushOption);
    groupOrder.forEach((g, gi) => {
      rows.push({ kind: 'group', id: `${base}-grp-${gi}`, label: g });
      groupMap.get(g).forEach(pushOption);
    });

    return { rows, options };
  }

  data(params, props) {
    const prev = this.getData();
    const query = prev.query ?? '';
    const activeIndex = prev.activeIndex ?? -1;

    const { rows, options } = this._build(props, query);
    const activeOpt =
      activeIndex >= 0 && options[activeIndex] && !options[activeIndex].disabled
        ? options[activeIndex]
        : null;
    if (activeOpt) activeOpt.active = true;

    // Precompute per-row presentation. The template renders every row through
    // one shared <div> wrapper (a {#for} body needs a single element root), so
    // role / class / aria-* are resolved here where the dynamic `active` state
    // is known. Group rows report presentation-only fields; their click/hover
    // handlers are inert (guarded in JS by row.kind).
    rows.forEach((r) => {
      if (r.kind === 'group') {
        r.role = 'presentation';
        r.cls = GROUP_CLS;
        r.optIndex = false;
        r.ariaSelected = false;
        r.ariaDisabled = false;
        r.hint = '';
      } else {
        r.role = 'option';
        r.cls =
          OPTION_BASE +
          (r.disabled ? ' text-faint pointer-events-none' : ' cursor-pointer text-body') +
          (r.active ? ' bg-surface-sunken text-ink' : '');
        r.ariaSelected = r.active ? 'true' : 'false';
        r.ariaDisabled = r.disabled ? 'true' : false;
      }
    });

    return {
      rows,
      options,
      query,
      activeIndex,
      activeId: activeOpt ? activeOpt.id : false,
      empty: options.length === 0,
      inputId: `${this._base}-input`,
      listId: `${this._base}-list`,
      placeholder: props.placeholder || 'Type a command or search…',
      emptyText: props.emptyText || 'No results found.',
      ariaLabel: props.label || 'Command palette',
      backdropClass: OVERLAY,
      panelClass: [PANEL_BASE, props.class || ''].join(' '),
    };
  }

  // ---- open / close (dialog-panel reconciled with the `open` prop) ----------

  mounted() {
    if (typeof window === 'undefined') return;
    this._live = true;
    this._panel = this.refs.panel;
    this._lastOpen = !!this.props.open;

    // Bound before the upgrade on purpose: addEventListener works on an
    // un-upgraded element, so no dispatch can be missed in the gap.
    this._panel?.addEventListener('beforeHide', this._onBeforeHide);
    this._panel?.addEventListener('hidden', this._onHidden);

    import('@magic-spells/dialog-panel')
      .then(() => {
        if (!this._live) return;
        this._ready = true;
        // A palette that mounted already open opens now.
        this._sync();
      })
      .catch((error) => {
        console.error(
          '[Command] failed to load @magic-spells/dialog-panel — the palette will not open.',
          error
        );
      });
  }

  afterUpdate() {
    if (!this._live) return;
    const open = !!this.props.open;
    if (open !== this._lastOpen) {
      this._lastOpen = open;
      this._sync();
    }
    if (this._scrollActive) {
      this._scrollActive = false;
      this._scrollActiveIntoView();
    }
  }

  destroyed() {
    this._live = false;
    this._panel?.removeEventListener('beforeHide', this._onBeforeHide);
    this._panel?.removeEventListener('hidden', this._onHidden);
    // Unbound FIRST: this close is a teardown, not a user dismissal, and must
    // not call back into a parent that is being torn down with us.
    if (this._panel?.isOpen) this._panel.hide();
    this._panel = null;
  }

  // dialog-panel's events bubble, so a nested overlay's close would otherwise
  // reach this panel's listeners too.
  _mine(event) {
    return event.target === this._panel;
  }

  // Every close path passes beforeHide synchronously, inside hide(). One the
  // wrapper asked for is flagged for that stretch; anything else is the user.
  _onBeforeHide = (event) => {
    if (!this._mine(event)) return;
    if (!this._selfHiding) this._userHide = true;
  };

  _onHidden = (event) => {
    if (!this._mine(event)) return;
    const user = this._userHide;
    this._userHide = false;
    if (!user) return;
    const { close } = this.props;
    if (typeof close === 'function') close();
  };

  // Edge-triggered, never level-triggered: called only when `open` actually
  // changed (or when the module finally landed on a palette that mounted
  // open). The isOpen guards make a redundant edge a no-op. On the
  // closed→open edge we clear the query, seat the active row on the first
  // enabled result, and focus the input — show() opens the native element
  // synchronously, so it can take focus straight away.
  _sync() {
    if (!this._ready || !this._panel) return;
    if (this._lastOpen) {
      if (this._panel.isOpen) return;
      this._panel.show(this._trigger());
      this._resetForOpen();
      this._panel.querySelector('[data-command-input]')?.focus();
    } else if (this._panel.isOpen) {
      this._selfHiding = true;
      try {
        this._panel.hide();
      } finally {
        this._selfHiding = false;
      }
    }
  }

  // The element show() returns focus to: whatever the user was on when the
  // parent opened the palette.
  _trigger() {
    const active = document.activeElement;
    return active && active !== document.body && active.focus ? active : undefined;
  }

  _resetForOpen() {
    const { options } = this._build(this.props, '');
    this._scrollActive = false;
    this.setData({ query: '', activeIndex: this._firstEnabled(options) });
    this.refresh();
  }

  // ---- active-row movement --------------------------------------------------

  _firstEnabled(options) {
    for (let i = 0; i < options.length; i++) if (!options[i].disabled) return i;
    return -1;
  }

  // Move the active row by `dir`, wrapping around the ends and skipping disabled
  // rows. Starts one step past the current index (or from either edge when
  // nothing is active yet).
  _move(dir) {
    const { options, activeIndex } = this.getData();
    const n = options.length;
    if (!n) return;
    let i = activeIndex;
    for (let step = 0; step < n; step++) {
      i = (i + dir + n) % n;
      if (!options[i].disabled) {
        this._setActive(i, true);
        return;
      }
    }
  }

  _setActive(i, scroll) {
    if (i < 0) return;
    this._scrollActive = !!scroll;
    this.setData({ activeIndex: i });
    this.refresh();
  }

  _scrollActiveIntoView() {
    const { activeIndex } = this.getData();
    if (activeIndex < 0 || !this.element) return;
    this.element
      .querySelector(`[data-opt-index="${activeIndex}"]`)
      ?.scrollIntoView({ block: 'nearest' });
  }

  events = {
    // Every keystroke re-filters and reseats the active row on the first enabled
    // result (per spec). setData writes the local layer; refresh() re-runs data()
    // so the ranked/grouped rows recompute.
    onInput: (event) => {
      const query = event.target.value;
      const { options } = this._build(this.props, query);
      this._scrollActive = false;
      this.setData({ query, activeIndex: this._firstEnabled(options) });
      this.refresh();
    },

    moveDown: () => this._move(1),
    moveUp: () => this._move(-1),

    onEnter: (event) => {
      // IME composition confirm must not act.
      if (event.isComposing) return;
      event.preventDefault();
      const { options, activeIndex } = this.getData();
      const opt = options[activeIndex];
      if (!opt || opt.disabled) return;
      const { select } = this.props;
      if (typeof select === 'function') select(opt.value, event);
    },

    // Pointer hover seats the active row (no scroll — the pointer is already
    // there). Click activates.
    hover: (row) => {
      if (row.kind !== 'option' || row.disabled) return;
      if (this.getData().activeIndex === row.optIndex) return;
      this._setActive(row.optIndex, false);
    },

    choose: (row, event) => {
      if (row.kind !== 'option' || row.disabled) return;
      const { select } = this.props;
      if (typeof select === 'function') select(row.value, event);
    },
  };
}
</script>
