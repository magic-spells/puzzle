<puzzle-view>
  <DropdownPanel.Panel
    class={ contentClass }
    align={ align }
    opens={ opens }
    wide={ wide }
    effect={ effect }><Children/></DropdownPanel.Panel>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import DropdownPanel from '../DropdownPanel/index.js';

// Menubar.Content — the panel one menu drops. A member of the Menubar family
// (D167); it composes DropdownPanel.Panel and adds the menu's tighter padding, so
// it renders <dropdown-panel> as its single root with no wrapper — the
// direct-children contract holds.
//
//   <Menubar.Content>
//     <Menubar.Item value="new" @press={ run }>New file</Menubar.Item>
//   </Menubar.Content>
//
// A submenu's Content takes opens="right", which puts it beside its trigger and
// rotates the hover bridge onto the horizontal axis.
//
// Never overflow-hidden, here or above it: it clips a nested submenu at this
// panel's edge. The old rAF right-edge clamp is gone with the wrap — a menu near
// the right edge takes align="end" instead, which is pure CSS.
//
// Props (forwarded to DropdownPanel.Panel unless noted)
//   align   'start' (default) | 'end'
//   opens   'down' (default) | 'right' for a submenu
//   wide    a full-width panel spanning the <nav>
//   effect  'fade' | 'slide' | 'scale' | 'blur' | 'swing' (effects sheet only)
//   class   merged onto <dropdown-panel>.
//           Merging is not precedence: a utility of yours on a property the
//           stock chrome already sets wins only if Tailwind emits it LATER in
//           the stylesheet (mt-1 or mt-1.5 cannot beat mt-2, ml-2 cannot beat
//           ml-3, p-1 cannot beat p-2). Add the ! suffix (mt-1!) to force it.

// All chrome — border, surface, shadow, rounding, min-w-48, z-40 AND the p-2
// padding — is the base Panel's. (This member used to add p-1, which never
// rendered: Tailwind emits .p-1 before .p-2, so the base's p-2 always won, and
// the submenu offsets in Panel.pzl are tuned to that 8px.)

export default class Content extends PuzzleView {
  data(params, props) {
    return {
      contentClass: props.class || false,
      align: props.align,
      opens: props.opens,
      wide: props.wide ? true : false,
      effect: props.effect,
    };
  }
}
</script>
