<puzzle-view>
  <nav class={ rootClass } aria-label={ label }>
    {#if menu}
      <DropdownMenu>
        <DropdownMenu.Trigger>
          <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20" />
          </svg>
          <span class="sr-only">{ labelPrefix }</span>
          <span lang={ activeLocale }>{ activeLabel }</span>
          <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </DropdownMenu.Trigger>
        <DropdownMenu.Content align={ align }>
          {#if routed}
            {#for option in options}
              <a
                key={ option.locale }
                href={ option.href }
                hreflang={ option.locale }
                lang={ option.locale }
                class={ option.rowClass }
                aria-current={ option.current }
                @click={ follow(event, option.locale) }>
                { option.label }
                {#if option.active}
                  <svg class="ml-auto size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                {/if}
              </a>
            {/for}
          {:else}
            {#for option in options}
              <button
                type="button"
                key={ option.locale }
                lang={ option.locale }
                class={ option.rowClass }
                aria-current={ option.current }
                @click={ pick(event, option.locale) }>
                { option.label }
                {#if option.active}
                  <svg class="ml-auto size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                {/if}
              </button>
            {/for}
          {/if}
        </DropdownMenu.Content>
      </DropdownMenu>
    {:else}
      <ul class="flex flex-wrap items-center gap-1">
        {#if routed}
          {#for option in options}
            <li key={ option.locale }>
              <a
                href={ option.href }
                hreflang={ option.locale }
                lang={ option.locale }
                class={ option.pillClass }
                aria-current={ option.current }
                @click={ follow(event, option.locale) }>{ option.label }</a>
            </li>
          {/for}
        {:else}
          {#for option in options}
            <li key={ option.locale }>
              <button
                type="button"
                lang={ option.locale }
                class={ option.pillClass }
                aria-current={ option.current }
                @click={ pick(event, option.locale) }>{ option.label }</button>
            </li>
          {/for}
        {/if}
      </ul>
    {/if}
  </nav>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import DropdownMenu from './DropdownMenu/index.js';

// LanguageSwitcher — one entry per configured locale, from the app's
// `i18n.locales` list (D177): `{ locale, label, href, active }`, in config
// order, `label` being the language's own name (`Español`, `日本語`).
//
//   <LanguageSwitcher locales={ locales }/>
//   <LanguageSwitcher locales={ locales } variant="menu" align="end"/>
//
// THE LIST IS A PROP — PASS IT FROM THE LAYOUT OR VIEW. Do not move the read in
// here. `i18n.locales` describes the page being shown (every `href` is THIS
// page in that language), and inside a persistent layout only the layout's
// own data() re-runs for each navigation; a component that read
// `this.ctx.i18n.locales` itself would keep the first page's list and send
// every later switch back to it. So the parent reads it and passes it down:
//
//   data() {
//     return { locales: this.ctx.i18n.locales };
//   }
//
// LINKS OR BUTTONS — DECIDED FROM THE LIST. Under `i18n.routing: 'prefix'`
// every language has its own URL, so each entry's `href` is distinct (`/about`,
// `/es/about`) and the piece renders real links: `href`, `hreflang` and `lang`
// set to the locale, `aria-current="true"` on the active one. Crawlers follow
// them, and a modified or middle click, open-in-new-tab and copy-link-address
// all work natively. A PLAIN click goes through `ctx.i18n.setLocale(locale)`
// instead (default prevented): it stores the viewer's choice — which the
// first-visit redirect honours on their next visit to an unprefixed URL — and
// then loads the same page under the other prefix.
//
// Without prefix routing there is one URL for every language, so the runtime
// gives every entry the SAME `href` (the current page; `''` where the host has
// no page to name). A link there would only reload the page in whatever locale
// is stored, so when the hrefs are not all present and distinct the piece
// renders <button>s that call `setLocale` — the client-side swap of D175.
//
// `@change(locale)` is an optional hook that fires before `setLocale` — close a
// mobile nav, send analytics. In an app with no `i18n` configured (no
// `ctx.i18n`) it is the only thing a click does; with neither, a link is left to
// the browser.
//
// ACCESSIBILITY. The root is a <nav> named by `label` ('Language' — pass your
// own translation, e.g. `label={ t('language') }`). Each entry carries
// `lang={ locale }` so a screen reader speaks `Deutsch` as German. The inline
// list is a <ul>, so its size is announced. The menu variant composes
// DropdownMenu, whose web component owns role="menu", the roving tabindex,
// arrow keys, typeahead and Escape — so NO role or tabindex is authored here.
// Its trigger reads "Language: English" (an sr-only prefix before the active
// language's name, which carries its own `lang`).
//
// Props
//   locales  the parent's `this.ctx.i18n.locales`: [{ locale, label, href, active }]
//   variant  'inline' (default) — a wrapping row of pills
//            'menu'             — a compact dropdown over DropdownMenu
//   label    the nav's accessible name (default 'Language')
//   align    menu only: 'start' (default) | 'end', for a switcher near the right edge
//   class    merged onto the <nav>
// Callbacks
//   @change(locale)  a plain click chose `locale`; fires before setLocale
//
// STYLESHEETS (menu variant only). Through DropdownMenu this piece needs the
// dropdown-panel CSS in your app's style entry:
//   @import "@magic-spells/dropdown-panel/css" layer(components);

const FOCUS =
  'focus-visible:outline-2 focus-visible:outline-offset-2 outline-ring focus-visible:outline-ring';

// Inline pills: muted at rest, a faint ground on the active one.
const PILL =
  'inline-flex h-8 items-center rounded-md px-2.5 text-sm whitespace-nowrap select-none ' +
  'cursor-pointer no-underline transition-colors ' + FOCUS;
const PILL_OFF = 'text-muted hover:bg-surface-sunken hover:text-ink';
const PILL_ON = 'bg-faint font-medium text-ink';

// Menu rows: DropdownMenu.Link's box, with the check pushed to the trailing edge.
const ROW =
  'flex w-full items-center gap-6 rounded-md px-2.5 py-1.5 text-sm cursor-pointer ' +
  'no-underline transition-colors hover:bg-surface-sunken hover:text-ink ' + FOCUS;
const ROW_OFF = 'text-body';
const ROW_ON = 'font-medium text-ink';

// Real links only when every entry has its own URL — prefix routing. Without
// it the runtime hands every entry the current page (or '').
const hasOwnUrls = (list) => {
  const hrefs = list.map((entry) => entry.href);
  return (
    hrefs.length > 0 &&
    hrefs.every((href) => typeof href === 'string' && href !== '') &&
    new Set(hrefs).size === hrefs.length
  );
};

export default class LanguageSwitcher extends PuzzleView {
  data(params, props) {
    const list = (Array.isArray(props.locales) ? props.locales : []).filter(
      (entry) => entry && entry.locale != null
    );
    const options = list.map((entry) => {
      const active = !!entry.active;
      return {
        locale: String(entry.locale),
        label: entry.label != null ? String(entry.label) : String(entry.locale),
        href: entry.href,
        active,
        // the string form; false omits the attribute
        current: active ? 'true' : false,
        pillClass: [PILL, active ? PILL_ON : PILL_OFF].join(' '),
        rowClass: [ROW, active ? ROW_ON : ROW_OFF].join(' '),
      };
    });
    const current = options.find((option) => option.active) ?? options[0];
    const label = props.label != null ? String(props.label) : 'Language';

    return {
      options,
      routed: hasOwnUrls(list),
      menu: props.variant === 'menu',
      label,
      labelPrefix: label + ': ',
      activeLocale: current ? current.locale : false,
      activeLabel: current ? current.label : '',
      align: props.align === 'end' ? 'end' : 'start',
      rootClass: props.class || false,
    };
  }

  events = {
    // A link. A modified or middle click (new tab, new window, download) is the
    // browser's; a plain one stores the choice through setLocale, which loads
    // the same page under the other prefix.
    follow: (event, tag) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const i18n = this.ctx?.i18n;
      if (!i18n && !this.props.change) return;
      event.preventDefault();
      this.props.change?.(tag);
      i18n?.setLocale(tag);
    },

    // A button (no prefix routing): nothing native to defer to.
    pick: (event, tag) => {
      this.props.change?.(tag);
      this.ctx?.i18n?.setLocale(tag);
    },
  };
}
</script>
