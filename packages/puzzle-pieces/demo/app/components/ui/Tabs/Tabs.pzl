<puzzle-view>
  <tab-group class={ rootClass } data-variant={ variant }><Children/></tab-group>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// Tabs — an accessible tablist. A FAMILY (D167) that WRAPS the
// @magic-spells/tab-group web component, so the roving tabindex, the
// arrow/Home/End keyboard model, every role/id/aria-controls/aria-selected
// attribute, the disabled-tab skipping and panel visibility all live upstream.
//
//   import Tabs from '@/components/ui/Tabs';
//
//   <Tabs value={ tab } @change={ setTab }>
//     <Tabs.List>
//       <Tabs.Tab value="account">Account</Tabs.Tab>
//       <Tabs.Tab value="billing">Billing</Tabs.Tab>
//     </Tabs.List>
//     <Tabs.Panel value="account">…real markup…</Tabs.Panel>
//     <Tabs.Panel value="billing">…real markup…</Tabs.Panel>
//   </Tabs>
//
// BREAKING CHANGE in 0.7.0: the `tabs` config array is gone, and so is the
// parent-owned-panels doctrine it forced. The old piece rendered ONLY the
// tablist and made you wire role="tabpanel" ids by hand; panels are real
// members now and their bodies take arbitrary markup.
//
// VALUE ↔ INDEX. Upstream identifies a tab by its 0-BASED INDEX; this piece
// keeps the registry's string-handle convention and maps between them by
// reading `data-value` off the buttons. `:scope > tab-list > tab-button` is
// the lookup, so a nested Tabs' own list never answers for this one.
//
// TABS AND PANELS PAIR BY INDEX, NOT BY VALUE. Upstream pairs
// `:scope > tab-list > tab-button` with `:scope > tab-panel` positionally, so
// the Tab order and the Panel order MUST match. The root dev-asserts that and
// warns once per instance when they diverge. If both come from a {#for}, drive
// BOTH loops from the same array in the same commit — Puzzle applies both
// patches together, so the counts can never diverge mid-patch.
//
// CONTROLLED value, DRIVEN THROUGH THE DOM. There is no cross-component context
// in Puzzle, so the root reaches its members through the DOM: it resolves
// `value` to an index and writes it. Two things follow.
//
//   1. `active` IS NEVER BOUND IN THE TEMPLATE. The component observes AND
//      reflects that attribute, so a live binding would fight the patcher every
//      render. The seed is written imperatively in mounted() BEFORE the upgrade
//      lands — an authored `active` is applied silently by connectedCallback,
//      with no tabchange and no animation, which is the no-flash path.
//      (It cannot be a frozen template attribute the way Accordion's is: the
//      index is only knowable once the buttons exist, and data() runs under
//      Node with no DOM.)
//   2. EDGE-TRIGGERED, plus the member set. afterUpdate() acts when `value`
//      changed OR when the tab SET changed — a keyed {#for} row inserted
//      mid-list shifts every index after it, and the value never moved.
//
// PROGRAMMATIC ACTIVATION NEVER MOVES FOCUS. tab-group 1.2.0 routes the
// `active` setter through _select(..., { focus: false }); only a real click or
// keypress focuses the tab. So flipping `value` from a button elsewhere on the
// page leaves focus exactly where the user put it, and this piece needs no
// focus-restore workaround.
//
// AN IGNORED CHANGE IS NOT REVERTED (D-WRAP contract). The component
// self-manages and reports; the parent re-syncs. #last tracks props.value and
// nothing else — never the value we reported — so a parent that drops a
// @change leaves no pending edge for a later unrelated render to act on.
//
// VARIANT WITHOUT CONTEXT. The root stamps `data-variant`; List and Tab carry
// every look and switch on a descendant attribute selector. Documented
// limitation: a nested Tabs with a DIFFERENT variant collides, because the
// descendant match has equal specificity at both depths. The same specificity
// means a plain call-site utility on a List or Tab loses to any property a
// pills/buttons rule sets: override with the `!` suffix (`px-6!`) or the same
// `[tab-group[data-variant=…]_&]:` prefix, on the inner members.
//
// LAYOUT AND THE LIST↔PANEL GAP LIVE ON THIS ROOT. The host is a flex column
// with a 1rem gap, for every variant. Two reasons it sits here rather than on a
// member:
//
//   1. <tab-panel> is a custom element, so it is INLINE by default — upstream's
//      stylesheet only hides it. Inline, a panel's `pt-*` never pushes it off
//      the list and a border/padding "box" wraps each line of text instead of
//      the body. A flex item is blockified, so the panel becomes a real block
//      WITHOUT a display utility on the host (which would outrank
//      tab-panel[hidden] — see Panel.pzl).
//   2. A hidden panel generates no box, so the flex gap separates the list
//      from the ONE visible panel and nothing else.
//
// The gap is emitted as `:where(.…) { gap }` — zero specificity — so ANY
// `gap-*` (or `gap-y-*`) you pass in `class` wins, whatever order Tailwind
// generates the two in. `class="gap-0"` removes it.
//
// STYLESHEET. Add it once to your style entry:
//   @import "@magic-spells/tab-group/css" layer(components);
//
// TODO: switch to ^1.2.0 once published — this repo's demo pins the package by
// file: path while 1.2.0 is unreleased. Consumers install ^1.2.0.
//
// Props
//   value         controlled: the active tab's `value` string
//   defaultValue  uncontrolled seed, applied once at mount
//   variant       'underline' (default) | 'pills' | 'buttons'
//                   underline — text tabs on a hairline, brand underline when active
//                   pills     — a segmented control: a sunken track, the active
//                               tab a raised neutral pill
//                   buttons   — separate bordered buttons with a gap; the active
//                               one filled brand. Wraps instead of scrolling.
//   class         merged onto <tab-group>; a `gap-*` here replaces the default gap
//   @change(value)  value-first, fired once per activation

const ROOT = 'flex w-full flex-col [:where(&)]:gap-4';
const VARIANTS = ['underline', 'pills', 'buttons'];

export default class Tabs extends PuzzleView {
  #live = false;
  #syncing = false;
  #controlled = false;
  #warned = false;
  #paired = false;
  #last;
  #members = '';

  // Direct tabs of THIS group only — `:scope >` already excludes a nested
  // Tabs' own list, and the [data-value] filter excludes an upstream filler.
  #tabs() {
    if (!this.element) return [];
    return [...this.element.querySelectorAll(':scope > tab-list > tab-button[data-value]')];
  }

  #panels() {
    if (!this.element) return [];
    return [...this.element.querySelectorAll(':scope > tab-panel[data-value]')];
  }

  #memberKey() {
    return this.#tabs()
      .map((tab) => tab.dataset.value)
      .join('\0');
  }

  // Tabs and panels pair positionally upstream, so a mismatched order silently
  // shows the wrong body. Warn once — this is the single most likely authoring
  // mistake in the new markup shape.
  #assertPaired() {
    if (this.#paired) return;
    const tabs = this.#tabs().map((tab) => tab.dataset.value);
    const panels = this.#panels().map((panel) => panel.dataset.value);
    if (tabs.length === panels.length && tabs.every((v, i) => v === panels[i])) return;
    this.#paired = true;
    console.warn(
      '[Tabs] <tab-button> and <tab-panel> are paired by POSITION upstream, but ' +
        'this instance has tabs [' +
        tabs.join(', ') +
        '] against panels [' +
        panels.join(', ') +
        ']. Render one Tabs.Panel per Tabs.Tab, in the same order.'
    );
  }

  // Drives the element to `value`. The flag keeps our own listener from
  // reporting a write we made — the component dispatches synchronously, so it
  // covers the whole cascade.
  #sync(value) {
    if (value === undefined) return;
    const tabs = this.#tabs();
    const index = tabs.findIndex((tab) => tab.dataset.value === String(value));

    if (index === -1) {
      if (!this.#warned) {
        this.#warned = true;
        console.warn(`[Tabs] no Tabs.Tab has value "${value}" — the active tab is unchanged.`);
      }
      return;
    }
    // Upstream refuses a disabled index (_parseIndex returns null), and forcing
    // it would desync aria-selected. Say so rather than failing silently.
    if (tabs[index].hasAttribute('disabled')) {
      if (!this.#warned) {
        this.#warned = true;
        console.warn(`[Tabs] Tabs.Tab "${value}" is disabled — the active tab is unchanged.`);
      }
      return;
    }
    this.#warned = false;

    this.#syncing = true;
    try {
      if ('active' in this.element) {
        if (this.element.active === index) return; // already there — no event
        this.element.active = index;
        return;
      }
      // Not upgraded yet: leave the intent on the attribute. connectedCallback
      // reads it and selects silently, with no tabchange on first paint.
      if (this.element.getAttribute('active') === String(index)) return;
      this.element.setAttribute('active', String(index));
    } finally {
      this.#syncing = false;
    }
  }

  #onTabChange = (event) => {
    if (this.#syncing) return;
    // tabchange BUBBLES and is composed: a nested Tabs' event passes straight
    // through this element on its way up, and reporting it as ours would name a
    // tab this group does not own.
    if (event.target !== this.element) return;
    const detail = event.detail || {};
    const value =
      detail.currentTab?.dataset?.value ?? this.#tabs()[detail.currentIndex]?.dataset?.value;
    if (value === undefined) return;
    // #last is NEVER set from what we report — it tracks props.value only, so
    // an ignored @change leaves no stale edge behind.
    this.props.change?.(value);
  };

  data(params, props) {
    return {
      variant: VARIANTS.includes(props.variant) ? props.variant : 'underline',
      rootClass: [ROOT, props.class].filter(Boolean).join(' '),
    };
  }

  mounted() {
    if (typeof window === 'undefined') return;
    this.#live = true;
    this.#controlled = this.props.value !== undefined;

    // Bound before the upgrade on purpose: addEventListener works on an
    // un-upgraded element, so no dispatch can be missed in the gap.
    this.element.addEventListener('tabchange', this.#onTabChange);

    this.#last = this.props.value;
    this.#members = this.#memberKey();
    this.#assertPaired();
    this.#sync(this.#controlled ? this.props.value : this.props.defaultValue);

    import('@magic-spells/tab-group').catch((error) => {
      console.error(
        '[Tabs] failed to load @magic-spells/tab-group — the tabs will not switch.',
        error
      );
    });
  }

  afterUpdate() {
    if (!this.#live) return;
    this.#assertPaired();
    if (!this.#controlled) return;
    const value = this.props.value;
    const members = this.#memberKey();
    // Edge-triggered, never level-triggered — plus the member set, because a
    // keyed row inserted mid-list shifts every index after it while `value`
    // stays exactly where it was.
    if (value === this.#last && members === this.#members) return;
    this.#last = value;
    this.#members = members;
    this.#sync(value);
  }

  destroyed() {
    this.#live = false;
    this.element?.removeEventListener('tabchange', this.#onTabChange);
  }
}
</script>
