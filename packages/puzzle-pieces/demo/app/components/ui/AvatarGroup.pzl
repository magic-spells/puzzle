<puzzle-view>
  <div class={ rootClass } aria-label={ ariaLabel }>
    {#for item in stack}
      <span key={ item.key } class={ item.wrapperClass } style={ item.style }>
        {#if item.type === 'avatar'}
          <Avatar src={ item.src } name={ item.name } size={ size } class={ item.avatarClass }/>
        {:else}
          <span class={ item.chipClass } aria-label={ item.chipLabel }>{ item.chipText }</span>
        {/if}
      </span>
    {/for}
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Avatar from './Avatar.pzl';

// AvatarGroup — an overlapping stack of avatars rendered from an array, with a
// "+N" overflow chip once the count exceeds `max`. Composes the existing
// Avatar piece for each disc (same size scale, same image/initials/glyph
// fallback), so the group never re-implements avatar rendering itself.
//
//   <AvatarGroup avatars={[{ name:'Ada Lovelace' }, { src:'/a.jpg', name:'Grace Hopper' }]} />
//   <AvatarGroup avatars={ collaborators } max={ 4 } size="lg" label="5 collaborators" />
//
// Props:
//   avatars  [{ src?, name? }] — forwarded straight to Avatar per item.
//   max      number, default 4 — show the first `max`; the remainder folds
//            into a single "+N" chip.
//   size     'sm' | 'md' | 'lg', default 'md' — forwarded to every Avatar and
//            matched by the overflow chip's own disc size.
//   label    optional aria-label on the root (e.g. "5 collaborators").
//   class    appended to the root.
//
// No callbacks — purely presentational.
//
// STACKING: every disc (avatar or chip) sits inside a wrapper <span> sized to
// the disc. Every item after the first pulls left over its neighbour with a
// negative margin and is CUT OUT around it: the wrapper carries an SVG mask of
// a circle with a bite out of its left side. The bite is a circle concentric
// with the left neighbour, `gap` px wider than it, so the neighbour sits in
// the notch with real transparent space around it — the page background shows
// through whatever it is (no halo ring faking a cutout in one colour). The
// first item is a plain circle; the "+N" chip is bitten like any avatar.
// Nothing overlaps once cut, so there is no z-index. The overlap uses margin,
// not transform — the Tailwind v4 translate/scale gotcha (CLAUDE.md) does not
// apply here.
//
// The bite eats the left `overlap + gap` px of a disc, so centred initials and
// the chip's "+N" are nudged right in bitten items: `shift` is left padding on
// the border-box root, which moves centred content right by half its value.
// On an Avatar it rides `not-has-[img]:` so a photo (size-full img) stays
// centred while a failed image's initials fallback is still corrected. A
// three-character chip ("+12") still doesn't fully clear the bite at sm.
//
// Per size: `d` disc diameter (px, = the size-* class), `overlap` (px, = the
// -ml-* class), `gap` (px of clear space around the neighbour).
const SIZES = {
  sm: { d: 24, overlap: 8, gap: 1.5, box: 'size-6', pull: '-ml-2', shift: 'pl-2', faceShift: 'not-has-[img]:pl-2' },
  md: { d: 32, overlap: 10, gap: 2, box: 'size-8', pull: '-ml-2.5', shift: 'pl-2.5', faceShift: 'not-has-[img]:pl-2.5' },
  lg: { d: 40, overlap: 12, gap: 2.5, box: 'size-10', pull: '-ml-3', shift: 'pl-3', faceShift: 'not-has-[img]:pl-3' },
};

// The bite mask, in a viewBox that is the disc's own px box: the full square
// minus a circle, filled evenodd. The circle is the left neighbour's disc
// grown by `gap` — centred `d - overlap` px left of this disc's centre, at
// (overlap - r, r), radius r + gap. The mask only removes the bite; the
// disc's own rounded-full edge draws its outer rim, so bitten discs
// anti-alias exactly like the first one. mask-image reads the SVG's alpha.
function biteMask({ d, overlap, gap }) {
  const r = d / 2;
  const R = r + gap;
  const n = (v) => +v.toFixed(3);
  const svg =
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${d} ${d}'>` +
    `<path fill-rule='evenodd' d='M0 0H${d}V${d}H0Z` +
    `M${n(overlap - r - R)} ${r}a${R} ${R} 0 1 0 ${2 * R} 0a${R} ${R} 0 1 0 ${-2 * R} 0Z'/></svg>`;
  // Fully percent-encoded (quotes and parens too) so the unquoted url() is
  // safe inside a style attribute however it gets serialized.
  const url =
    'url(data:image/svg+xml,' +
    encodeURIComponent(svg).replace(/['()]/g, (ch) => '%' + ch.charCodeAt(0).toString(16)) +
    ')';
  return ['', '-webkit-']
    .map((p) => `${p}mask-image:${url};${p}mask-size:100% 100%;${p}mask-repeat:no-repeat`)
    .join(';');
}

// Built once per size at module load — identical for every bitten item.
const BITE = Object.fromEntries(Object.entries(SIZES).map(([k, s]) => [k, biteMask(s)]));

const CHIP_BASE =
  'inline-flex items-center justify-center rounded-full shrink-0 select-none font-medium ' +
  'bg-surface-sunken text-muted';

const CHIP_SIZE = {
  sm: 'size-6 text-[10px]',
  md: 'size-8 text-xs',
  lg: 'size-10 text-sm',
};

export default class AvatarGroup extends PuzzleView {
  data(params, props) {
    const size = SIZES[props.size] ? props.size : 'md';
    const { box, pull, shift, faceShift } = SIZES[size];
    const source = props.avatars || [];
    const max = Number(props.max) > 0 ? Math.floor(Number(props.max)) : 4;
    const visible = source.slice(0, max);
    const overflowCount = source.length > max ? source.length - max : 0;

    // Item 0 is a plain circle; every later item pulls left and is bitten.
    const wrap = (i) => ({
      wrapperClass: ['flex shrink-0', box, i === 0 ? '' : pull].filter(Boolean).join(' '),
      style: i === 0 ? false : BITE[size],
    });

    const stack = visible.map((avatar, i) => ({
      key: 'avatar-' + i,
      type: 'avatar',
      src: avatar.src || '',
      name: avatar.name || '',
      chipClass: '',
      chipText: '',
      chipLabel: '',
      avatarClass: i === 0 ? '' : faceShift,
      ...wrap(i),
    }));

    if (overflowCount > 0) {
      stack.push({
        key: 'overflow',
        type: 'chip',
        src: '',
        name: '',
        chipText: '+' + overflowCount,
        chipLabel: overflowCount + ' more',
        avatarClass: '',
        chipClass: [CHIP_BASE, CHIP_SIZE[size], visible.length === 0 ? '' : shift]
          .filter(Boolean)
          .join(' '),
        ...wrap(visible.length),
      });
    }

    return {
      size,
      stack,
      rootClass: ['flex items-center', props.class || ''].filter(Boolean).join(' '),
      ariaLabel: props.label || false,
    };
  }
}
</script>
