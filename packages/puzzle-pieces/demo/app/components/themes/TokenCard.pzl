<puzzle-view>
  <div class="rounded-xl border border-border bg-surface-card p-3 shadow-card">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <p class="truncate font-mono text-[13px] text-ink">{ name }</p>
        <p class="mt-0.5 text-xs/relaxed text-muted">{ role }</p>
      </div>
      <div class="flex shrink-0 items-center gap-1">
        {#if alpha}
          <span class="rounded bg-surface-sunken px-1.5 py-0.5 text-[10px] font-medium text-muted">alpha</span>
        {/if}
        <CopyButton value={ copyValue } size="sm"/>
      </div>
    </div>

    <div class="mt-3 grid grid-cols-3 gap-2">
      {#for col in columns}
        <div key={ col.mode } class={ col.columnClass }>
          <p class="mb-1 text-[10px] font-medium uppercase tracking-wide text-muted">{ col.label }</p>
          <div data-scheme={ col.scheme } data-theme={ col.mode }>
            {#if shadow}
              <div class="rounded-md bg-surface-panel p-2">
                <div class="h-8 w-full rounded-md bg-surface-card" style={ col.swatchStyle }></div>
              </div>
            {:else}
              <div class="h-10 w-full rounded-md border border-border" style={ col.swatchStyle }></div>
            {/if}
          </div>
          <p class="mt-1 break-all font-mono text-[11px] text-muted">{ col.value }</p>
          {#if col.chip}
            <p class={ col.chipClass }>{ col.chipText }</p>
          {/if}
        </div>
      {/for}
    </div>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import CopyButton from '@/components/ui/CopyButton.pzl';

// TokenCard — one theme token, shown in all three modes at once.
//
// Every swatch is its OWN live probe: the little block carries an inline
// `background-color: var(--color-<name>)` (or `box-shadow: var(--shadow-…)`)
// and sits inside a wrapper carrying `data-scheme` + `data-theme`, so the
// browser resolves the token in that palette × mode. The card never paints a
// colour it was handed — the swatch itself is the truth, and the text under it
// is only a readback of what the same var resolved to in the view's probe area.
//
//   <TokenCard token={ t } scheme={ scheme } values={ values } contrast={ c } mode={ mode }/>
//
// Props:
//   token     one entry of TOKEN_GROUPS[].tokens —
//             { name, prop, role, on?, min?, alpha?, shadow? }
//   scheme    the palette this card shows ('default' | 'dim' | 'warm' | 'void')
//   values    { light, medium, dark } formatted display strings; a mode may be
//             undefined before the view's probe has run
//   contrast  { light, medium, dark }, each { ratio, ground, pass } or null
//   mode      the mode to highlight (the appearance the page is in)
//
// No state, no lifecycle: the owning view resolves everything and re-renders.
const MODE_LABELS = [
  { mode: 'light', label: 'Light' },
  { mode: 'medium', label: 'Medium' },
  { mode: 'dark', label: 'Dark' },
];

const COLUMN = 'min-w-0 rounded-lg p-1.5';
const COLUMN_ON = 'min-w-0 rounded-lg p-1.5 ring-1 ring-border-strong';

const CHIP = 'mt-1 inline-block rounded px-1.5 py-0.5 text-[10px] font-medium';
const CHIP_PASS = 'mt-1 inline-block rounded px-1.5 py-0.5 text-[10px] font-medium bg-success-tint text-success';
const CHIP_FAIL = 'mt-1 inline-block rounded px-1.5 py-0.5 text-[10px] font-medium bg-danger-tint text-danger-on-tint';

/** A ground's custom property (`--color-surface`) read back as a token name. */
const groundLabel = (prop) => String(prop || '').replace('--color-', '');

export default class TokenCard extends PuzzleView {
  data(params, props) {
    const token = props.token || {};
    const name = token.name || '';
    const shadow = !!token.shadow;
    const scheme = props.scheme || 'default';
    const values = props.values || {};
    const contrast = props.contrast || {};
    const activeMode = props.mode || null;

    // The var reference the copy button hands over — exactly what a consumer
    // writes in their own CSS.
    const varRef = shadow ? 'var(--shadow-' + name + ')' : 'var(--color-' + name + ')';
    // The same reference as an inline declaration for the swatch.
    const swatchStyle = shadow
      ? 'box-shadow: var(--shadow-' + name + ')'
      : 'background-color: var(--color-' + name + ')';

    return {
      name,
      role: token.role || '',
      alpha: !!token.alpha,
      shadow,
      copyValue: varRef,
      columns: MODE_LABELS.map(({ mode, label }) => {
        const measured = contrast[mode] || null;
        const ratio = measured && Number.isFinite(measured.ratio) ? measured.ratio : null;
        return {
          mode,
          label,
          scheme,
          swatchStyle,
          value: values[mode] || '—',
          columnClass: mode === activeMode ? COLUMN_ON : COLUMN,
          chip: !!ratio,
          chipClass: ratio ? (measured.pass ? CHIP_PASS : CHIP_FAIL) : CHIP,
          chipText: ratio
            ? ratio.toFixed(2) + ' AA on ' + groundLabel(measured.ground)
            : '',
        };
      }),
    };
  }
}
</script>
