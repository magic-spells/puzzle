<puzzle-view>
  <div class="contents">
    <!-- ONE trigger, two dresses. Below lg it is an icon button the size of the
         bar's other icon buttons (hamburger, GitHub): no label, no ⌘K chip — a
         phone has no keyboard shortcut to advertise and the bar has no room for
         a field. From lg it grows into the centred search field. It stays the
         same element either way, so it is always the morph source and the
         focus-return target, and aria-label names it in both dresses. -->
    <button
      data-search-open
      type="button"
      aria-label="Search the docs"
      aria-keyshortcuts="Control+K"
      class="flex size-8 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-md text-sm text-bar-muted transition-colors hover:bg-bar-hover hover:text-bar-ink outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 lg:w-full lg:min-w-0 lg:max-w-xl lg:shrink lg:justify-start lg:bg-bar-hover lg:px-3">
      <svg class="size-4.5 shrink-0 lg:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-4-4" />
      </svg>
      <span class="hidden min-w-0 flex-1 truncate text-left lg:block">Search…</span>
      <!-- The span owns the display: Kbd's own `inline-flex` sorts after
           `hidden` in Tailwind's output, so `hidden` on the Kbd never won. -->
      <span class="hidden shrink-0 lg:inline-flex">
        <Kbd class="gap-1 border-bar-line bg-bar-hover text-bar-muted">
          <span data-search-shortcut>Ctrl</span><span>K</span>
        </Kbd>
      </span>
    </button>

    <dialog-panel ref="panel" morph-display="flex">
      <dialog-backdrop class="bg-scrim/60 backdrop-blur-sm backdrop-saturate-150"></dialog-backdrop>

      <dialog
        data-search-dialog
        aria-label="Search the docs"
        class="m-0 h-dvh max-h-dvh w-full max-w-none border-0 bg-surface p-0 text-body shadow-2xl open:flex sm:fixed sm:inset-0 sm:mx-auto sm:mt-20 sm:h-fit sm:max-h-[min(34rem,calc(100vh-10rem))] sm:w-[min(92%,38rem)] sm:border sm:border-border">
        <div data-search-frame class="flex min-h-0 w-full flex-1 flex-col overflow-hidden">
          <div class="flex items-center gap-3 border-b border-border p-4">
            <svg class="size-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg>
            <!-- String(): non-path expr keeps this one-way. The `input` listener wired in
                 mounted() owns `query` — it also recomputes results, so a bare bind would
                 write query without them (D147). -->
            <input
              data-search-input
              type="search"
              value={ String(query) }
              placeholder="Search components, demos, and pages…"
              autocomplete="off"
              spellcheck="false"
              aria-label="Search query"
              class="min-w-0 flex-1 bg-transparent text-base text-ink outline-none placeholder:text-muted" />
            <!-- data-action-hide-dialog: dialog-panel closes on this itself, no handler here. -->
            <button
              data-action-hide-dialog
              type="button"
              class="cursor-pointer rounded-md px-2 py-1 text-sm font-medium text-brand transition-colors hover:bg-brand-tint hover:text-brand-dark outline-ring focus-visible:outline-2 focus-visible:outline-offset-2">
              Close
            </button>
          </div>

          <div class="min-h-0 flex-1 overflow-y-auto p-2" data-search-scroll>
            {#if showHint}
              <p class="px-2 py-8 text-center text-sm text-muted">
                Search { indexCount } components, demos, and pages by name or description.
              </p>
            {/if}

            {#if showEmpty}
              <p class="px-2 py-8 text-center text-sm text-muted">No matches for “{ query }”.</p>
            {/if}

            {#if hasResults}
              <div class="space-y-1">
                {#for result in results}
                  <a
                    data-search-result
                    key={ result.path }
                    href={ result.href }
                    class={ result.rowClass }>
                    <span class="flex items-baseline gap-2">
                      <span class="font-medium text-ink">{ result.title }</span>
                      <span class="text-xs text-faint">{ result.section }</span>
                    </span>
                    {#if result.description}
                      <span class="mt-1 block text-sm/relaxed text-muted">{ result.description }</span>
                    {/if}
                  </a>
                {/for}
              </div>
            {/if}
          </div>

          <div class="hidden items-center gap-4 border-t border-border px-4 py-2.5 text-xs text-faint sm:flex">
            <span class="inline-flex items-center gap-1.5"><Kbd>↑</Kbd><Kbd>↓</Kbd> navigate</span>
            <span class="inline-flex items-center gap-1.5"><Kbd>↵</Kbd> open</span>
            <span class="inline-flex items-center gap-1.5"><Kbd>Esc</Kbd> close</span>
          </div>
        </div>
      </dialog>
    </dialog-panel>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import { MorphEngine } from '@magic-spells/morph-engine';
import Kbd from '@/components/ui/Kbd.pzl';
import { searchDocs, SEARCH_COUNT } from '@/docs/search.js';

// SearchDialog — the header search. Docs chrome, not a registry piece: it knows
// about nav.js and hash routing, neither of which belongs in a copy-in component.
//
// THE OVERLAY IS <dialog-panel>, like every other overlay on the site. The
// Dialog, AlertDialog, Sheet and BottomSheet pieces all wrap
// @magic-spells/dialog-panel, and this dialog rides the same transport so the
// four share one open/close machine, one scrim element and one stylesheet
// (imported once in styles.css as `@import "@magic-spells/dialog-panel/css"
// layer(components)`). What that buys over the hand-rolled showModal()/close()
// this used to be:
//
//   * <dialog-backdrop> is the ONE overlay surface across the family. The
//     shell's two overlays (this and the mobile docs Sheet in the layout)
//     share one FROSTED-GLASS recipe — a light scrim (`bg-scrim/60`, the
//     theme's scrim token at 60%), `backdrop-blur-sm` and
//     `backdrop-saturate-150` — so the page stays faintly readable through
//     it, and the site-wide grain (styles.css, `dialog-backdrop {
//     background-image }`) lands on top for free. The native ::backdrop stays transparent — the
//     family keeps it that way on purpose, because a top-layer ::backdrop
//     would paint OVER the morph blob and blur the very thing in flight.
//   * The scrim fade, the page scroll lock, Escape, the backdrop click and the
//     [data-action-hide-dialog] Close button are all dialog-panel's. No
//     `cancel` interception, no body overflow bookkeeping, no ::backdrop
//     transition rules in styles.css.
//
// THE PANEL STILL MORPHS OUT OF ITS TRIGGER. dialog-panel accepts a duck-typed
// engine on its `morphEngine` property, and @magic-spells/morph-engine speaks
// that seam as a PROXY engine (it flies a clone; the dialog itself is only
// promoted into the top layer at the engine's `reveal` point). Morph is
// opt-out, not opt-in — a narrow viewport (where the dialog is full-screen, so
// there is no box to grow into) or prefers-reduced-motion clears the engine
// before each open, and dialog-panel runs its plain CSS fade instead. The
// engine is (re)attached per open rather than once, because an attached
// engine also switches the [morph] stylesheet variant on, which turns the
// dialog's own transition off — exactly wrong for the CSS path.
//
// Two morph constraints this markup respects: the dialog is positioned with
// margins (mx-auto/mt-20), never a transform, and it carries no dynamic style
// binding — both would fight the engine's own box interpolation. `open:flex`
// rather than a bare `flex` keeps dialog:not([open]){display:none} intact;
// `morph-display="flex"` is the same display for the engine's flight.
// The corner radius of both ends (the lg field and the sm+ panel) is a literal
// 22px from styles.css ("Morph endpoints"), not a rounded-* utility, so the
// radius the engine reads is identical at both ends and never tweens.
//
// LOADING. dialog-panel registers `class extends HTMLElement` at module scope,
// so it is imported in mounted() (never top-level) like the Dialog piece does.
// A ⌘K before the module lands is a no-op — the elements are not upgraded yet.
//
// Results come from a local index (see docs/search.js). Everything is keyboard
// reachable: Cmd/Ctrl+K toggles, arrows move the selection, Enter opens it.

const ROW_BASE =
  'block scroll-my-2 rounded-lg border px-3 py-2.5 transition-colors outline-none';
const ROW_IDLE = 'border-transparent hover:bg-surface-sunken';
const ROW_ACTIVE = 'border-border-strong bg-surface-sunken';

export default class SearchDialog extends PuzzleView {
  created() {
    this.setData({ query: '', results: [], activeIndex: 0 });
  }

  data() {
    const state = this.getData();
    const query = state.query || '';
    const results = state.results || [];
    const activeIndex = state.activeIndex || 0;

    return {
      query,
      indexCount: SEARCH_COUNT,
      hasResults: results.length > 0,
      showHint: !query.trim(),
      showEmpty: !!query.trim() && results.length === 0,
      // Per-row class precomputed here — a {#for} body cannot branch on its own.
      results: results.map((result, i) => ({
        ...result,
        href: `#${result.path}`,
        rowClass: `${ROW_BASE} ${i === activeIndex ? ROW_ACTIVE : ROW_IDLE}`,
      })),
    };
  }

  mounted() {
    const root = this.element;
    this._live = true;
    this._openButton = root.querySelector('[data-search-open]');
    this._panel = this.refs.panel;
    this._dialog = root.querySelector('[data-search-dialog]');
    this._frame = root.querySelector('[data-search-frame]');
    this._input = root.querySelector('[data-search-input]');
    this._scroll = root.querySelector('[data-search-scroll]');
    this._morph = new MorphEngine();

    this._wide = window.matchMedia('(min-width: 40rem)');
    this._reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const isApple = /Mac|iPhone|iPad|iPod/i.test(navigator.platform || navigator.userAgent);
    if (isApple) {
      const key = root.querySelector('[data-search-shortcut]');
      if (key) key.textContent = '⌘';
      this._openButton.setAttribute('aria-keyshortcuts', 'Meta+K');
    }

    this._onOpen = () => this.openModal();
    this._onInput = () => this.runSearch(this._input.value);
    this._onInputKey = (event) => this.onInputKey(event);
    this._onResultClick = (event) => {
      if (event.target.closest('[data-search-result]')) this.closeModal();
    };
    this._onWindowKey = (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        this._panel?.isOpen ? this.closeModal() : this.openModal();
      }
    };
    // The morph path opens the native dialog at the engine's reveal point —
    // dialog-panel's own reveal listener does the showModal(). Deferred a
    // microtask so it runs after that listener whatever the registration
    // order, at which point the dialog is open and can take focus.
    this._onReveal = ({ to }) => {
      if (to !== this._dialog) return;
      queueMicrotask(() => {
        if (this._live && this._dialog.open) this.focusInput();
      });
    };
    this._morph.on('reveal', this._onReveal);

    this._openButton.addEventListener('click', this._onOpen);
    this._input.addEventListener('input', this._onInput);
    this._input.addEventListener('keydown', this._onInputKey);
    this._frame.addEventListener('click', this._onResultClick);
    window.addEventListener('keydown', this._onWindowKey);

    import('@magic-spells/dialog-panel').catch((error) => {
      console.error(
        '[SearchDialog] failed to load @magic-spells/dialog-panel — the search will not open.',
        error
      );
    });
  }

  destroyed() {
    this._live = false;
    this._openButton?.removeEventListener('click', this._onOpen);
    this._input?.removeEventListener('input', this._onInput);
    this._input?.removeEventListener('keydown', this._onInputKey);
    this._frame?.removeEventListener('click', this._onResultClick);
    window.removeEventListener('keydown', this._onWindowKey);
    this._morph?.off('reveal', this._onReveal);
    // Detaching the engine stops any flight and settles the panel hidden;
    // the top-layer dialog and the scroll lock are released by the element's
    // own disconnectedCallback when Puzzle removes it.
    if (this._panel && 'morphEngine' in this._panel) this._panel.morphEngine = null;
    if (this._panel?.isOpen) this._panel.hide();
    this._morph?.destroy();
    this._panel = null;
  }

  // Full-screen on a narrow viewport means there is no target box to morph into.
  shouldMorph() {
    return this._wide.matches && !this._reducedMotion.matches;
  }

  // An un-upgraded <dialog-panel> has no show() — the module is still loading.
  ready() {
    return typeof this._panel?.show === 'function';
  }

  openModal() {
    if (!this.ready() || this._panel.isOpen) return;
    this._panel.morphEngine = this.shouldMorph() ? this._morph : null;
    // The trigger doubles as the morph source and as the focus-return target.
    this._panel.show(this._openButton);
    // The CSS path calls showModal() synchronously; the morph path reaches
    // here still closed and focuses at reveal instead.
    if (this._dialog.open) this.focusInput();
  }

  closeModal() {
    if (this.ready()) this._panel.hide();
  }

  focusInput() {
    this._input.focus();
    this._input.select();
  }

  runSearch(value) {
    this.setData({ query: value, results: searchDocs(value), activeIndex: 0 });
    this.refresh();
  }

  onInputKey(event) {
    const results = this.getData().results || [];
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      if (!results.length) return;
      event.preventDefault();
      const step = event.key === 'ArrowDown' ? 1 : -1;
      const next = (this.getData().activeIndex + step + results.length) % results.length;
      this.setData({ activeIndex: next });
      this.refresh();
      this.scrollActiveIntoView(next);
      return;
    }
    if (event.key === 'Enter') {
      const active = results[this.getData().activeIndex];
      if (!active) return;
      event.preventDefault();
      window.location.hash = active.path;
      this.closeModal();
    }
  }

  // Safe to read straight away: refresh() patches synchronously, so the rows
  // already carry the new active class by the time this runs.
  scrollActiveIntoView(index) {
    const rows = this._scroll?.querySelectorAll('[data-search-result]');
    rows?.[index]?.scrollIntoView({ block: 'nearest' });
  }
}
</script>
