<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full min-w-0 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Rich Text Editor</h1>
        <p class="mt-2 text-body">
          WYSIWYG editing on Tiptap/ProseMirror with the Toolbar piece as its formatting
          bar — one row, the block-style picker (Normal text, Heading 1-4) first — or, with
          chrome="blocks", a Notion-style page with no toolbar at all.
          The value is not HTML — it is a structured JSON document tree (Shopify's rich text
          metafield shape, extended with alignment and more), controlled via
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">value</code>
          and
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">@change</code>.
          Render stored documents with the Rich Text piece.
        </p>
      </header>

      <ExampleBox code={ codeHero }>
        <div class="w-full">
          <RichTextEditor label="Post body" placeholder="Write something…"
            value={ doc } @change={ setDoc } />
        </div>
      </ExampleBox>

      <section id="installation" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Installation</h2>
        <p class="mb-3 text-sm text-body">
          Copy the piece into your app — it compiles with your build and the code is yours.
          It pulls in the toolbar piece and lib/rich-text-doc.js, and needs the Tiptap packages:
        </p>
        <CodeBlock code={ installCmd }/>
        <CodeBlock code={ installNpm } class="mt-3"/>
      </section>

      <section id="usage" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Usage</h2>
        <CodeBlock code={ usageImport }/>
        <CodeBlock code={ usageMarkup } class="mt-3"/>
      </section>

      <div class="mt-12 space-y-12">
        <ExampleBox id="live-document" title="Live document" code={ codeLive }>
          <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-2">
            <RichTextEditor label="Editor" value={ doc } @change={ setDoc } />
            <div>
              <div class="mb-1.5 text-sm font-medium text-ink">Rendered with RichText</div>
              <div class="rounded-lg border border-border bg-surface px-3 py-2">
                <RichText doc={ doc } />
              </div>
            </div>
          </div>
        </ExampleBox>

        <ExampleBox id="images-and-previews" title="Images and link previews" code={ codeMedia }>
          <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-2">
            <RichTextEditor label="Notes" placeholder="Paste a link into an empty line…"
              tools={ notesTools } value={ mediaDoc } @change={ setMediaDoc }
              resolveImage={ resolveImage } uploadImage={ uploadImage }
              fetchLinkPreview={ fetchLinkPreview } />
            <div>
              <div class="mb-1.5 text-sm font-medium text-ink">Rendered with RichText</div>
              <div class="rounded-lg border border-border bg-surface px-3 py-2">
                <RichText doc={ mediaDoc } resolveImage={ resolveImage } />
              </div>
            </div>
          </div>
        </ExampleBox>

        <ExampleBox id="block-mode" title="Block mode" code={ codeBlocks }>
          <!-- A page-like surface: the editor has no frame of its own in this
               mode; the host gives it a gutter for the handle and the scroller. -->
          <div class="h-96 w-full overflow-y-auto rounded-lg bg-surface" data-demo-scroller>
            <div class="mx-auto max-w-2xl px-12 py-10">
              <RichTextEditor chrome="blocks" class="pl-2" placeholder="Start your notes…"
                tools={ notesTools } value={ blocksDoc } @change={ setBlocksDoc }
                resolveImage={ resolveImage } uploadImage={ uploadImage }
                fetchLinkPreview={ fetchLinkPreview } />
            </div>
          </div>
        </ExampleBox>

        <ExampleBox id="disabled" title="Disabled" code={ codeDisabled }>
          <div class="w-full">
            <RichTextEditor label="Read-only" value={ doc } disabled={ true } />
          </div>
        </ExampleBox>

        <section id="data-format" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Data format</h2>
          <p class="mb-3 text-sm text-body">
            The document is a node tree — a superset of Shopify's rich text metafield format
            (their format plus align, underline/strike, blockquote, code-block, and two
            top-level atoms: image and link-preview). Store it as JSON; render it with the
            Rich Text piece or your own tree walker. lib/rich-text-doc.js also exports
            validateDoc, docLimits, plainText and imageRefs.
          </p>
          <CodeBlock code={ codeFormat }/>
        </section>
      </div>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import RichTextEditor from '@/components/ui/RichTextEditor.pzl';
import RichText from '@/components/ui/RichText.pzl';
import ExampleBox from '@/components/docs/ExampleBox.pzl';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';

// Docs page for RichTextEditor — follows the ButtonDoc exemplar shape.
const installCmd = 'puzzle add piece rich-text-editor';
const installNpm = 'npm install @tiptap/core @tiptap/pm @tiptap/starter-kit @tiptap/extension-text-align';
const usageImport = `import RichTextEditor from '@/components/ui/RichTextEditor.pzl';`;
const usageMarkup = `<RichTextEditor label="Post body" value={ doc } @change={ setDoc } />`;

const codeHero = `<RichTextEditor label="Post body" placeholder="Write something…"
  value={ doc } @change={ setDoc } />

// parent
events = {
  setDoc: (doc) => this.setData('doc', doc),
};`;

const codeLive = `<RichTextEditor label="Editor" value={ doc } @change={ setDoc } />
<RichText doc={ doc } />`;

const codeDisabled = `<RichTextEditor label="Read-only" value={ doc } disabled={ true } />`;

const codeBlocks = `<RichTextEditor chrome="blocks" placeholder="Start your notes…"
  tools={ ['style', 'marks', 'lists', 'quote', 'link', 'image'] }
  value={ doc } @change={ setDoc }
  resolveImage={ resolveImage } uploadImage={ uploadImage }
  fetchLinkPreview={ fetchLinkPreview } />

// No toolbar and no frame. Hover a line for its handle (click: turn into /
// delete; drag: move the block), type "/" for commands, select text for the
// formatting bar. Mod-/ opens the handle menu from the keyboard.`;

const codeMedia = `<RichTextEditor label="Notes" tools={ ['style', 'marks', 'lists', 'quote', 'link', 'image'] }
  value={ doc } @change={ setDoc }
  resolveImage={ resolveImage } uploadImage={ uploadImage }
  fetchLinkPreview={ fetchLinkPreview } />
<RichText doc={ doc } resolveImage={ resolveImage } />

// The doc stores image ids, never URLs — your app owns all three hooks:
resolveImage(ref, node)  // → url | null (pass a new function when URLs change)
uploadImage(file)        // → Promise<{ ref, width?, height?, alt? }>
fetchLinkPreview(url)    // → Promise<{ title?, description?, siteName?, imageRef? } | null>`;

// Demo-only stand-ins for an app's API: uploads become object URLs under a
// made-up ref, and previews return canned metadata after a short delay (any
// URL containing "nopreview" returns null and stays a plain link).
const demoImages = new Map([
	['demo-seed', 'https://picsum.photos/id/1018/1200/675'],
	['demo-preview', 'https://picsum.photos/id/1080/600/400'],
]);
let demoRefs = 0;
const resolveImage = (ref) => demoImages.get(ref) ?? null;

const uploadImage = (file) =>
	new Promise((resolve, reject) => {
		const url = URL.createObjectURL(file);
		const probe = new Image();
		probe.onload = () =>
			setTimeout(() => {
				const ref = `demo-upload-${++demoRefs}`;
				demoImages.set(ref, url);
				resolve({ ref, width: probe.naturalWidth, height: probe.naturalHeight });
			}, 900);
		probe.onerror = reject;
		probe.src = url;
	});

const fetchLinkPreview = (url) =>
	new Promise((resolve) =>
		setTimeout(() => {
			if (url.includes('nopreview')) return resolve(null);
			const host = new URL(url).hostname;
			resolve({
				title: `A page on ${host}`,
				description: 'Canned metadata from the demo’s fetchLinkPreview stub — a real app unfurls the URL on its server.',
				siteName: host,
				imageRef: 'demo-preview',
			});
		}, 900)
	);

const para = (value) => ({ type: 'paragraph', children: [{ type: 'text', value }] });
const BLOCKS_DOC = {
	type: 'root',
	children: [
		{ type: 'heading', level: 1, children: [{ type: 'text', value: 'Kickoff call' }] },
		para('Hover any line for its handle, type "/" on an empty line, or select some words.'),
		{ type: 'heading', level: 2, children: [{ type: 'text', value: 'Agenda' }] },
		{
			type: 'list',
			listType: 'unordered',
			children: ['Goals for the quarter', 'Launch timeline', 'Open questions'].map((value) => ({
				type: 'list-item',
				children: [{ type: 'text', value }],
			})),
		},
		{ type: 'heading', level: 2, children: [{ type: 'text', value: 'Notes' }] },
		...Array.from({ length: 14 }, (_, i) =>
			para(
				`Point ${i + 1}: the team walked through the plan in detail, agreed the next steps and ` +
					'noted who owns each one, so that nothing falls between the cracks before the next call.'
			)
		),
		{ type: 'blockquote', children: [para('Ship the smallest useful thing first.')] },
		para(''),
	],
};

const MEDIA_DOC = {
	type: 'root',
	children: [
		{ type: 'heading', level: 3, children: [{ type: 'text', value: 'Site walk-through' }] },
		{ type: 'paragraph', children: [{ type: 'text', value: 'Drop or paste an image, or use the image button. Paste a URL into an empty line for a preview.' }] },
		{ type: 'image', ref: 'demo-seed', caption: 'The lake, from the north trail', width: 1200, height: 675 },
		{
			type: 'link-preview',
			url: 'https://example.com/field-notes',
			title: 'Field notes',
			description: 'Everything we saw on the walk, written up the same afternoon.',
			siteName: 'example.com',
			imageRef: 'demo-preview',
		},
		{ type: 'paragraph', children: [] },
	],
};

const codeFormat = `{
  "type": "root",
  "children": [
    { "type": "heading", "level": 2,
      "children": [{ "type": "text", "value": "Shipping" }] },
    { "type": "paragraph", "align": "center",
      "children": [
        { "type": "text", "value": "Orders ship in " },
        { "type": "text", "value": "2 days", "bold": true },
        { "type": "link", "url": "/policy",
          "children": [{ "type": "text", "value": "details" }] }
      ] },
    { "type": "list", "listType": "unordered",
      "children": [
        { "type": "list-item",
          "children": [{ "type": "text", "value": "Free returns" }] }
      ] },
    { "type": "image", "ref": "img_81f2", "alt": "Box", "caption": "Packed",
      "width": 1200, "height": 800 },
    { "type": "link-preview", "url": "https://example.com/returns",
      "title": "Returns", "description": "How returns work",
      "siteName": "Example", "imageRef": "img_93c0" }
  ]
}`;

const SAMPLE_DOC = {
	type: 'root',
	children: [
		{
			type: 'heading',
			level: 2,
			children: [{ type: 'text', value: 'Hello, rich text' }],
		},
		{
			type: 'paragraph',
			children: [
				{ type: 'text', value: 'Select some text and use the toolbar — ' },
				{ type: 'text', value: 'bold', bold: true },
				{ type: 'text', value: ', ' },
				{ type: 'text', value: 'italic', italic: true },
				{ type: 'text', value: ', lists, quotes, and ' },
				{
					type: 'link',
					url: 'https://example.com',
					children: [{ type: 'text', value: 'links' }],
				},
				{ type: 'text', value: '.' },
			],
		},
	],
};

export default class RichTextEditorDoc extends PuzzleView {
	created() {
		this.setData({ doc: SAMPLE_DOC, mediaDoc: MEDIA_DOC, blocksDoc: BLOCKS_DOC });
	}

	data(params, props) {
		return {
			...this.getData(),
			installCmd,
			installNpm,
			usageImport,
			usageMarkup,
			codeHero,
			codeLive,
			codeDisabled,
			codeMedia,
			codeBlocks,
			codeFormat,
			notesTools: ['style', 'marks', 'lists', 'quote', 'link', 'image'],
			resolveImage,
			uploadImage,
			fetchLinkPreview,
			toc: [
				{ label: 'Installation', href: '#installation' },
				{ label: 'Usage', href: '#usage' },
				{ label: 'Live document', href: '#live-document' },
				{ label: 'Images and link previews', href: '#images-and-previews' },
				{ label: 'Block mode', href: '#block-mode' },
				{ label: 'Disabled', href: '#disabled' },
				{ label: 'Data format', href: '#data-format' },
			],
		};
	}

	events = {
		setDoc: (doc) => this.setData('doc', doc),
		setMediaDoc: (doc) => this.setData('mediaDoc', doc),
		setBlocksDoc: (doc) => this.setData('blocksDoc', doc),
	};
}
</script>
