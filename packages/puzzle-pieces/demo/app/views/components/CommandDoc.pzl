<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full min-w-0 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Command</h1>
        <p class="mt-2 text-body">
          A command palette — filtered, grouped, keyboard-driven quick actions in a
          modal on the native dialog element. The parent owns the open flag and decides
          what each selection does. The overlay rides
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">@magic-spells/dialog-panel</code>,
          the same web component behind Dialog, Alert Dialog, Sheet and Bottom Sheet — one
          scrim, one fade in and out, one open/close machine across the family.
        </p>
      </header>

      <ExampleBox code={ codeHero }>
        <Button variant="outline" @press={ openCommand }>Open command palette</Button>
        <Command
          open={ commandOpen }
          items={ commandItems }
          @select={ runCommand }
          @close={ closeCommand } />
      </ExampleBox>

      <section id="installation" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Installation</h2>
        <p class="mb-3 text-sm text-body">
          Copy the piece into your app — it compiles with your build and the code is yours:
        </p>
        <CodeBlock code={ installCmd }/>
        <p class="mb-3 mt-4 text-sm text-body">
          Like Dialog, Alert Dialog, Sheet and Bottom Sheet, this piece has a runtime
          dependency: the web component it wraps. If you use any of those it is installed
          once and shared.
        </p>
        <CodeBlock code={ installDep }/>
        <p class="mb-3 mt-4 text-sm text-body">
          Then merge the component's stylesheet into your app's style entry
          (<code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">app/styles/styles.css</code>).
          It owns the overlay transport — the state-driven fade of both the scrim and the
          panel, the backdrop element, and the page scroll lock. Without it the palette is
          an unstyled native dialog with no animation and no scrim:
        </p>
        <CodeBlock code={ installCss }/>
        <p class="mt-3 text-sm text-muted">
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">layer(components)</code>
          is not optional cosmetics: the stylesheet uses plain element selectors, and an unlayered
          import would outrank every Tailwind utility on the panel — including the width cap and
          the surface color this piece sets.
        </p>
        <p class="mt-3 text-sm text-muted">
          Requires the pieces.css tokens merged into your app styles (see Introduction).
        </p>
      </section>

      <section id="usage" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Usage</h2>
        <CodeBlock code={ usageImport }/>
        <CodeBlock code={ usageMarkup } class="mt-3"/>
        <CodeBlock code={ optionSnippet } class="mt-3"/>
      </section>

      <div class="mt-12 space-y-12">
        <section id="keyboard" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Keyboard</h2>
          <p class="mb-3 text-sm text-body">
            The input holds focus the moment the palette opens. Type to filter — matching
            is a word-prefix first, then a loose substring, and each item's keywords
            count too. The arrow keys move the active row, Enter runs it, and Escape
            closes the palette. Open the palette above and try it.
          </p>
          <p class="text-sm text-muted">
            The global hotkey to open the palette is the parent's job — bind
            Cmd/Ctrl+K in a layout and flip the open flag there. Command never binds a
            page-wide shortcut itself.
          </p>
          <p class="mt-3 text-sm text-muted">
            Escape and a click on the scrim close the palette themselves and report through
            @close once the exit fade has finished — flip the open flag false there. A close
            the parent asks for, by flipping open after a selection, is never reported back.
          </p>
        </section>
      </div>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Button from '@/components/ui/Button.pzl';
import Command from '@/components/ui/Command.pzl';
import ExampleBox from '@/components/docs/ExampleBox.pzl';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';
import { toast } from '@/components/ui/toast.js';

const installCmd = 'puzzle add piece command';
const installDep = 'npm install @magic-spells/dialog-panel';
const installCss = `/* app/styles/styles.css */
@import "tailwindcss";
@import "@magic-spells/dialog-panel/css" layer(components);`;
const usageImport = `import Command from '@/components/ui/Command.pzl';`;
const usageMarkup = `<Command open={ commandOpen } items={ commandItems } @select={ runCommand } @close={ closeCommand } />`;
const optionSnippet = `// The option element, ARIA, and handlers stay owned by Command.
// Command has no persistent selection, so selected is always false.
<Command open={ commandOpen } items={ commands } @select={ runCommand } @close={ closeCommand }>
  <Snippet fits="option" item active selected disabled>
    <img class="size-6 rounded-full" src={ item.avatar } alt="" />
    <span class="truncate">{ item.name }</span>
  </Snippet>
</Command>`;

const codeHero = `<Button variant="outline" @press={ openCommand }>Open command palette</Button>
<Command
  open={ commandOpen }
  items={ commandItems }
  @select={ runCommand }
  @close={ closeCommand } />

// items: { value, label, group?, keywords?, hint?, disabled? }
// @select does NOT auto-close — the parent decides what to do next.
events = {
  openCommand: () => this.setData('commandOpen', true),
  closeCommand: () => this.setData('commandOpen', false),
  runCommand: (value) => {
    this.setData('commandOpen', false);
    run(value);
  },
};`;

export default class CommandDoc extends PuzzleView {
  created() {
    this.setData({ commandOpen: false });
  }

  data(params, props) {
    return {
      ...this.getData(),
      installCmd,
      installDep,
      installCss,
      usageImport,
      usageMarkup,
      optionSnippet,
      codeHero,
      commandItems: [
        { value: 'new-file', label: 'New file', group: 'General', hint: '⌘ N' },
        { value: 'new-window', label: 'New window', group: 'General' },
        { value: 'open', label: 'Open…', group: 'General', hint: '⌘ O' },
        { value: 'undo', label: 'Undo', group: 'Edit', hint: '⌘ Z' },
        { value: 'redo', label: 'Redo', group: 'Edit' },
        { value: 'copy', label: 'Copy', group: 'Edit', hint: '⌘ C' },
        { value: 'paste', label: 'Paste', group: 'Edit', hint: '⌘ V' },
        { value: 'sidebar', label: 'Toggle sidebar', group: 'View' },
        { value: 'palette', label: 'Command palette', group: 'View', hint: '⌘ K' },
        { value: 'zoom-in', label: 'Zoom in', group: 'View' },
      ],
      toc: [
        { label: 'Installation', href: '#installation' },
        { label: 'Usage', href: '#usage' },
        { label: 'Keyboard', href: '#keyboard' },
      ],
    };
  }

  events = {
    openCommand: () => this.setData('commandOpen', true),
    closeCommand: () => this.setData('commandOpen', false),
    runCommand: (value) => {
      this.setData('commandOpen', false);
      toast({ message: 'Ran command: ' + value, variant: 'success' });
    },
  };
}
</script>
