<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full min-w-0 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Menubar</h1>
        <p class="mt-2 text-body">
          A desktop-application-style horizontal menu bar. It is a compound
          <strong class="font-medium text-ink">family</strong> composed over the shared
          <a class="text-brand underline underline-offset-2" href="#/components/dropdown-panel">Dropdown Panel</a>
          base, so hover-to-switch, click latching, nested submenus, outside-press dismissal and
          the in-menu keyboard model come from the web component rather than from 495 lines of
          ported machinery.
        </p>
        <p class="mt-3 text-body">
          Accessibility is the <strong class="font-medium text-ink">disclosure</strong> pattern,
          not <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">role="menubar"</code>.
          The component underneath is disclosure-style by design and does not implement bar-level
          roving, so claiming those roles would promise a keyboard model that is not there. Tab
          moves between triggers; inside an open menu the arrows, Home/End and Escape apply.
        </p>
        <div class="mt-4 rounded-lg border border-border bg-surface-sunken p-4">
          <p class="text-sm font-medium text-ink">Breaking change in 0.7.0</p>
          <p class="mt-1 text-sm text-body">
            The <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">menus</code>
            config array and the
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">@select</code>
            callback are gone — a nested
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">menus[].items[]</code>
            array is exactly the shape a compound family replaces. Rows fire
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">@press</code>
            per item, and submenus — which v1 did not have at all — are a nested
            <span class="font-medium text-ink">Menu</span> whose Content opens right.
          </p>
        </div>
      </header>

      <ExampleBox code={ codeHero }>
        <div class="flex w-full max-w-2xl flex-col items-start gap-4 pb-40">
          <Menubar label="Editor menu">
            <Menubar.Menu>
              <Menubar.Trigger>File</Menubar.Trigger>
              <Menubar.Content>
                <Menubar.Item value="new" @press={ run }>New file<Menubar.Shortcut>⌘N</Menubar.Shortcut></Menubar.Item>
                <Menubar.Item value="open" @press={ run }>Open…<Menubar.Shortcut>⌘O</Menubar.Shortcut></Menubar.Item>
                <Menubar.Separator/>
                <Menubar.Menu>
                  <Menubar.Trigger variant="item">Export as</Menubar.Trigger>
                  <Menubar.Content opens="right">
                    <Menubar.Item value="export-pdf" @press={ run }>PDF</Menubar.Item>
                    <Menubar.Item value="export-html" @press={ run }>HTML</Menubar.Item>
                  </Menubar.Content>
                </Menubar.Menu>
                <Menubar.Separator/>
                <Menubar.Item value="close" variant="danger" @press={ run }>Close project</Menubar.Item>
              </Menubar.Content>
            </Menubar.Menu>

            <Menubar.Menu>
              <Menubar.Trigger>Edit</Menubar.Trigger>
              <Menubar.Content>
                <Menubar.Item value="undo" @press={ run }>Undo<Menubar.Shortcut>⌘Z</Menubar.Shortcut></Menubar.Item>
                <Menubar.Item value="redo" disabled={ true } @press={ run }>Redo<Menubar.Shortcut>⇧⌘Z</Menubar.Shortcut></Menubar.Item>
                <Menubar.Separator/>
                <Menubar.Label>Clipboard</Menubar.Label>
                <Menubar.Item value="cut" @press={ run }>Cut<Menubar.Shortcut>⌘X</Menubar.Shortcut></Menubar.Item>
                <Menubar.Item value="paste" @press={ run }>Paste<Menubar.Shortcut>⌘V</Menubar.Shortcut></Menubar.Item>
              </Menubar.Content>
            </Menubar.Menu>

            <Menubar.Menu>
              <Menubar.Trigger>Help</Menubar.Trigger>
              <Menubar.Content align="end">
                <Menubar.Link href="#docs">Documentation</Menubar.Link>
                <Menubar.Link href="#shortcuts">Keyboard shortcuts</Menubar.Link>
                <Menubar.Separator/>
                <Menubar.Item value="about" @press={ run }>About</Menubar.Item>
              </Menubar.Content>
            </Menubar.Menu>
          </Menubar>

          <p class="text-sm text-muted">Last press: <span class="font-medium text-ink">{ pressed }</span></p>
        </div>
      </ExampleBox>

      <section id="installation" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Installation</h2>
        <p class="mb-3 text-sm text-body">
          Copy the family into your app. It pulls the shared
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">dropdown-panel</code>
          base along with it:
        </p>
        <CodeBlock code={ installCmd }/>
        <p class="mb-3 mt-4 text-sm text-body">
          That base has a runtime dependency — the web component it wraps:
        </p>
        <CodeBlock code={ installDep }/>
        <p class="mb-3 mt-4 text-sm text-body">
          Then merge its stylesheets into your app's style entry. The first is required; the
          second adds the entrance effects and the drawn trigger arrow:
        </p>
        <CodeBlock code={ installCss }/>
        <p class="mt-3 text-sm text-muted">
          Requires the pieces.css tokens merged into your app styles (see Introduction).
        </p>
      </section>

      <section id="usage" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Usage</h2>
        <CodeBlock code={ usageImport }/>
        <CodeBlock code={ usageMarkup } class="mt-3"/>
        <p class="mt-3 text-sm text-body">
          A submenu is a <span class="font-medium text-ink">Menu</span> nested inside a
          <span class="font-medium text-ink">Content</span>, with the inner Content set to
          <span class="font-medium text-ink">opens="right"</span>. Pressing any row closes the
          whole bar — a submenu and its parent collapse together — and returns focus to the
          trigger.
        </p>
        <p class="mt-3 text-sm text-muted">
          <span class="font-medium text-ink">Item</span> is a real button and
          <span class="font-medium text-ink">Link</span> is a real link; they are separate members
          rather than one component with an href, because a template may declare only one children
          marker and a two-branch root cannot compile.
        </p>
      </section>

      <div class="mt-12 space-y-12">
        <section id="keyboard" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Keyboard</h2>
          <p class="mb-3 text-sm text-body">
            All of it lives in the web component; this family adds no key handling of its own.
          </p>
          <div class="text-sm">
            {#for row in keyRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>
        </section>

        <section id="reference" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Reference</h2>

          {#for group in reference}
            <div key={ group.title }>
              <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">{ group.title }</h3>
              <p class="mb-2 text-sm text-muted">{ group.summary }</p>
              <div class="text-sm">
                {#for row in group.rows}
                  <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                    <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                    <span class="text-body">{ row.desc }</span>
                  </div>
                {/for}
              </div>
            </div>
          {/for}
        </section>
      </div>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Menubar from '@/components/ui/Menubar/index.js';
import ExampleBox from '@/components/docs/ExampleBox.pzl';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';

// Docs page for the Menubar family. Code samples live as template-literal
// consts because literal tag names and {#…} tokens would be parsed as template
// syntax in prose.
const installCmd = 'puzzle add piece menubar';
const installDep = 'npm install @magic-spells/dropdown-panel';
const installCss = `/* app/styles/styles.css */
@import "tailwindcss";
@import "@magic-spells/dropdown-panel/css" layer(components);         /* required */
@import "@magic-spells/dropdown-panel/css/effects" layer(components); /* optional */`;

const usageImport = `import Menubar from '@/components/ui/Menubar';`;

const usageMarkup = `<Menubar label="Editor menu">
  <Menubar.Menu>
    <Menubar.Trigger>File</Menubar.Trigger>
    <Menubar.Content>
      <Menubar.Item value="new" @press={ run }>
        New file<Menubar.Shortcut>⌘N</Menubar.Shortcut>
      </Menubar.Item>
      <Menubar.Separator />

      <Menubar.Menu>
        <Menubar.Trigger variant="item">Export as</Menubar.Trigger>
        <Menubar.Content opens="right">
          <Menubar.Item value="export-pdf" @press={ run }>PDF</Menubar.Item>
        </Menubar.Content>
      </Menubar.Menu>
    </Menubar.Content>
  </Menubar.Menu>
</Menubar>`;

const codeHero = `// One bar, three menus, one nested submenu. Hover switches between
// open menus, a click latches, and pressing a row closes everything.
<Menubar label="Editor menu">
  <Menubar.Menu>
    <Menubar.Trigger>File</Menubar.Trigger>
    <Menubar.Content>
      <Menubar.Item value="new" @press={ run }>New file<Menubar.Shortcut>⌘N</Menubar.Shortcut></Menubar.Item>
      <Menubar.Separator />
      <Menubar.Menu>
        <Menubar.Trigger variant="item">Export as</Menubar.Trigger>
        <Menubar.Content opens="right">…</Menubar.Content>
      </Menubar.Menu>
      <Menubar.Item value="close" variant="danger" @press={ run }>Close project</Menubar.Item>
    </Menubar.Content>
  </Menubar.Menu>

  <Menubar.Menu>
    <Menubar.Trigger>Help</Menubar.Trigger>
    <Menubar.Content align="end">
      <Menubar.Link href="/docs">Documentation</Menubar.Link>
    </Menubar.Content>
  </Menubar.Menu>
</Menubar>`;

const keyRows = [
  { name: 'Tab', desc: 'Moves between triggers. There is no Left/Right roving across the bar — the component is a disclosure, and the piece does not claim menubar roles it cannot honour.' },
  { name: 'Enter / Space', desc: 'On a trigger: toggle its menu. On a row: activate it.' },
  { name: 'ArrowDown / ArrowUp', desc: 'On a closed trigger: open and focus the first (or last) row. Inside an open menu: move row focus, wrapping at the ends.' },
  { name: 'Home / End', desc: 'Inside an open menu: first / last row.' },
  { name: 'ArrowRight / ArrowLeft', desc: 'Open an opens="right" submenu, and close it again returning focus to its trigger.' },
  { name: 'Escape', desc: 'Close one level and focus its trigger. Only the innermost open menu answers.' },
];

const reference = [
  {
    title: 'Menubar',
    summary: 'The bar — a plain <nav> with an aria-label, and the `relative` a wide panel positions against.',
    rows: [
      { name: 'label', desc: 'aria-label for the bar. Defaults to "Menu bar".' },
      { name: 'class', desc: 'Merged onto the bar, after its chrome.' },
    ],
  },
  {
    title: 'Menubar.Menu',
    summary: 'One menu: a trigger and the panel it opens. Nest one inside a Content for a submenu.',
    rows: [
      { name: 'trigger', desc: "'hover' | 'click' | 'both' (default) — hover opens, a click latches." },
      { name: 'arrow', desc: "'none' (default here) | 'flip' | 'static' — for a trigger that carries an arrow hook." },
      { name: 'open', desc: 'Optional-controlled and edge-triggered, forwarded to the base.' },
      { name: 'effect', desc: "'fade' | 'slide' | 'scale' | 'blur' | 'swing'. Needs the effects stylesheet." },
      { name: 'class', desc: 'Merged onto the host, after the load-bearing `block`.' },
      { name: '@show / @hide', desc: "Fired when THIS menu opens or closes; a nested submenu's events are filtered out." },
    ],
  },
  {
    title: 'Menubar.Trigger',
    summary: 'A top label, or the row that opens a submenu. Keep its content non-interactive — it is the control.',
    rows: [
      { name: 'variant', desc: "'bar' (default) for a top label, 'item' for an in-panel submenu row." },
      { name: 'class', desc: 'Merged onto the trigger, after the variant chrome.' },
    ],
  },
  {
    title: 'Menubar.Content',
    summary: 'The panel a menu drops.',
    rows: [
      { name: 'align', desc: "'start' (default) | 'end' for a menu near the right edge." },
      { name: 'opens', desc: "'down' (default) | 'right' for a submenu." },
      { name: 'wide', desc: 'A full-width panel spanning the bar.' },
      { name: 'effect', desc: "'fade' | 'slide' | 'scale' | 'blur' | 'swing'. Needs the effects stylesheet." },
      { name: 'class', desc: 'Merged onto the panel, after the padding. Never overflow-hidden.' },
    ],
  },
  {
    title: 'Menubar.Item',
    summary: 'An action row — a real button. Activating it fires @press and closes the whole bar.',
    rows: [
      { name: 'value', desc: 'Passed to @press.' },
      { name: 'variant', desc: "'default' | 'danger' for a destructive tint." },
      { name: 'disabled', desc: 'Greys the row out and swallows the press.' },
      { name: 'class', desc: 'Merged onto the row, after the chrome.' },
      { name: '@press', desc: 'Value-first: press(value). Named apart from `value` — a callback whose name equals a prop name collides in the same props object.' },
    ],
  },
  {
    title: 'Menubar.Link',
    summary: "Item's twin as a real <a>, for a row that navigates.",
    rows: [
      { name: 'href', desc: 'The destination.' },
      { name: 'value', desc: 'Passed to @press.' },
      { name: 'variant', desc: "'default' | 'danger'." },
      { name: 'disabled', desc: 'aria-disabled plus the muted treatment; the press is swallowed.' },
      { name: '@press', desc: 'A hook fired before navigation — it cannot cancel the visit.' },
    ],
  },
  {
    title: 'Menubar.Separator · Label · Shortcut',
    summary: 'Plain markup: a hairline with role="separator", a non-interactive group heading, and the <kbd> hint an Item pushes to its trailing edge.',
    rows: [{ name: 'class', desc: 'Each takes a class merged onto its element.' }],
  },
];

export default class MenubarDoc extends PuzzleView {
  created() {
    this.setData({ pressed: 'nothing yet' });
  }

  data() {
    return {
      pressed: this.getData().pressed,
      installCmd,
      installDep,
      installCss,
      usageImport,
      usageMarkup,
      codeHero,
      keyRows,
      reference,
      toc: [
        { label: 'Installation', href: '#installation' },
        { label: 'Usage', href: '#usage' },
        { label: 'Keyboard', href: '#keyboard' },
        { label: 'Reference', href: '#reference' },
      ],
    };
  }

  events = {
    run: (value) => {
      this.setData('pressed', String(value));
      this.refresh();
    },
  };
}
</script>
