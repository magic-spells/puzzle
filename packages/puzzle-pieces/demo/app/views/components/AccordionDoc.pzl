<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full min-w-0 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Accordion</h1>
        <p class="mt-2 text-body">
          A set of disclosures that coordinate: in single mode opening one closes the rest, in
          multiple mode they are independent. It is a compound
          <strong class="font-medium text-ink">family</strong> over the same
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">@magic-spells/collapsible-content</code>
          web component the
          <a class="text-brand underline underline-offset-2" href="#/components/collapsible">Collapsible</a>
          family wraps, so the exclusivity, the height animation and every ARIA attribute come from
          the component.
        </p>
        <div class="mt-4 rounded-lg border border-border bg-surface-sunken p-4">
          <p class="text-sm font-medium text-ink">Breaking change in 0.7.0</p>
          <p class="mt-1 text-sm text-body">
            The <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">items</code>
            config array is gone, and with it the plain-text
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">content</code>
            limitation it forced — Puzzle has no per-row slots, so a config array could only ever
            carry a string. Panels are written as markup now, and their bodies take anything.
          </p>
        </div>
      </header>

      <ExampleBox code={ codeHero }>
        <div class="w-full max-w-xl py-2">
          <Accordion value={ faqOpen } @change={ setFaqOpen }>
            {#for row in faq}
              <Accordion.Item key={ row.id } value={ row.id }>
                <Accordion.Trigger>{ row.title }</Accordion.Trigger>
                <Accordion.Content>
                  <p>{ row.body }</p>
                </Accordion.Content>
              </Accordion.Item>
            {/for}
          </Accordion>
          <p class="mt-3 text-sm text-muted">value = { faqLabel }</p>
        </div>
      </ExampleBox>

      <section id="installation" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Installation</h2>
        <p class="mb-3 text-sm text-body">
          Copy the family into your app. It pulls the
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">collapsible</code>
          family along with it — Accordion.Trigger and Accordion.Content compose those members:
        </p>
        <CodeBlock code={ installCmd }/>
        <p class="mb-3 mt-4 text-sm text-body">
          That base has one runtime dependency — the web component it wraps:
        </p>
        <CodeBlock code={ installDep }/>
        <p class="mb-3 mt-4 text-sm text-body">
          Then merge its stylesheet into your app's style entry. It is required: the height
          transition the whole animation runs on lives there.
        </p>
        <CodeBlock code={ installCss }/>
        <p class="mt-3 text-sm text-muted">
          Requires the pieces.css tokens merged into your app styles (see Introduction).
        </p>
      </section>

      <section id="usage" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Usage</h2>
        <CodeBlock code={ usageImport }/>
        <CodeBlock code={ usageMarkup } class="mt-3"/>
        <p class="mt-3 text-sm text-body">
          Every row needs a
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">value</code>
          on its Item. That is how the root identifies its direct members, reads the group's state
          back off the DOM and drives them. Item renders a single element, so it drops straight
          into a
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">for</code>
          block over a list of rows.
        </p>
      </section>

      <div class="mt-12 space-y-12">
        <ExampleBox id="multiple" title="Multiple open" code={ codeMultiple }>
          <div class="w-full max-w-xl py-2">
            <Accordion type="multiple" value={ specsOpen } @change={ setSpecsOpen }>
              {#for row in specs}
                <Accordion.Item key={ row.id } value={ row.id }>
                  <Accordion.Trigger>{ row.title }</Accordion.Trigger>
                  <Accordion.Content>
                    <p>{ row.body }</p>
                  </Accordion.Content>
                </Accordion.Item>
              {/for}
            </Accordion>
            <p class="mt-3 text-sm text-muted">value = { specsLabel }</p>
          </div>
        </ExampleBox>

        <ExampleBox id="controlled" title="Driven from outside" code={ codeControlled }>
          <div class="flex w-full max-w-xl flex-col gap-4 py-2">
            <Accordion value={ faqOpen } @change={ setFaqOpen }>
              {#for row in faq}
                <Accordion.Item key={ row.id } value={ row.id }>
                  <Accordion.Trigger>{ row.title }</Accordion.Trigger>
                  <Accordion.Content>
                    <p>{ row.body }</p>
                  </Accordion.Content>
                </Accordion.Item>
              {/for}
            </Accordion>
            <div class="flex flex-wrap items-center gap-2">
              {#for row in faq}
                <Button key={ row.id } variant="outline" size="sm" @press={ openRow(row.id) }>Open { row.title }</Button>
              {/for}
              <Button variant="ghost" size="sm" @press={ closeAll }>Close all</Button>
            </div>
          </div>
        </ExampleBox>

        <ExampleBox id="rich" title="Rich panels, disabled rows and nesting" code={ codeRich }>
          <div class="w-full max-w-xl py-2">
            <Accordion>
              <Accordion.Item value="order">
                <Accordion.Trigger>Track an order</Accordion.Trigger>
                <Accordion.Content>
                  <p class="mb-3">Panel bodies take arbitrary markup — including other pieces.</p>
                  <Accordion>
                    <Accordion.Item value="inner-a">
                      <Accordion.Trigger>A nested accordion</Accordion.Trigger>
                      <Accordion.Content>
                        Its rows join the nearest group, so this one coordinates with its own
                        siblings and never touches the outer accordion.
                      </Accordion.Content>
                    </Accordion.Item>
                    <Accordion.Item value="inner-b">
                      <Accordion.Trigger>Its sibling</Accordion.Trigger>
                      <Accordion.Content>Opening this closes the row above it, and nothing else.</Accordion.Content>
                    </Accordion.Item>
                  </Accordion>
                </Accordion.Content>
              </Accordion.Item>

              <Accordion.Item value="standalone">
                <Accordion.Trigger>A standalone Collapsible inside a row</Accordion.Trigger>
                <Accordion.Content>
                  <Collapsible>
                    <Collapsible.Trigger>This one is independent</Collapsible.Trigger>
                    <Collapsible.Content>
                      Collapsible renders its own non-exclusive group, which shields it from this
                      accordion's exclusivity. Open it, then open another row above — it stays open.
                    </Collapsible.Content>
                  </Collapsible>
                </Accordion.Content>
              </Accordion.Item>

              <Accordion.Item value="soon">
                <Accordion.Trigger disabled>Not available yet</Accordion.Trigger>
                <Accordion.Content>A disabled trigger is a real disabled button.</Accordion.Content>
              </Accordion.Item>
            </Accordion>
          </div>
        </ExampleBox>

        <section id="reference" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Reference</h2>

          <h3 class="mb-2 mt-6 text-sm font-semibold text-ink">Accordion</h3>
          <div class="text-sm">
            {#for row in rootRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">Accordion.Item</h3>
          <div class="text-sm">
            {#for row in itemRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">Accordion.Trigger</h3>
          <div class="text-sm">
            {#for row in triggerRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">Accordion.Content</h3>
          <div class="text-sm">
            {#for row in contentRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <p class="mt-6 text-sm text-body">
            A rejected toggle is <span class="font-medium text-ink">not</span> reverted. The
            component self-manages and then reports; a parent that ignores @change leaves the panel
            visually open while its own state says closed, and the next real change to
            <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">value</code>
            puts it right. Exactly one @change fires per user action, even in single mode where the
            component closes the previous row first.
          </p>
        </section>
      </div>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Accordion from '@/components/ui/Accordion/index.js';
import Collapsible from '@/components/ui/Collapsible/index.js';
import Button from '@/components/ui/Button.pzl';
import ExampleBox from '@/components/docs/ExampleBox.pzl';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';

// Docs page for the Accordion family. Code samples live as template-literal
// consts because literal tag names and {#…} tokens would be parsed as template
// syntax in prose.
const installCmd = 'puzzle add piece accordion';
// TODO: switch to ^1.2.0 once published — the demo pins the package by file:
// path while 1.2.0 is unreleased. Consumers install the published range.
const installDep = 'npm install @magic-spells/collapsible-content@^1.2.0';
const installCss = `/* app/styles/styles.css */
@import "tailwindcss";
@import "@magic-spells/collapsible-content/css" layer(components); /* required */`;

const usageImport = `import Accordion from '@/components/ui/Accordion';`;

const usageMarkup = `<Accordion value={ open } @change={ setOpen }>
  <Accordion.Item value="shipping">
    <Accordion.Trigger>Shipping</Accordion.Trigger>
    <Accordion.Content>
      <p>Real markup — this is not a text prop.</p>
    </Accordion.Content>
  </Accordion.Item>
</Accordion>`;

const codeHero = `// Single mode (the default): one open at a time. '' means all closed.
// Item renders a single element, so it drops straight into a for block.
<Accordion value={ open } @change={ setOpen }>
  {#for row in faq}
    <Accordion.Item key={ row.id } value={ row.id }>
      <Accordion.Trigger>{ row.title }</Accordion.Trigger>
      <Accordion.Content><p>{ row.body }</p></Accordion.Content>
    </Accordion.Item>
  {/for}
</Accordion>`;

const codeMultiple = `// type="multiple": rows are independent and value is an array.
<Accordion type="multiple" value={ open } @change={ setOpen }>
  …
</Accordion>

// setOpen: (value) => this.setData('open', value)  // string[] here`;

const codeControlled = `// The root reaches its rows through the DOM — Puzzle has no
// cross-component context — and calls show()/hide() on them. It is
// EDGE-triggered: a re-render carrying the same value does nothing,
// and a row already in the requested state is skipped, so echoing
// back the value you were just handed animates nothing.
this.setData('open', 'returns');   // opens that row
this.setData('open', '');          // closes them all`;

const codeRich = `// Bodies take arbitrary markup, nesting included. A nested Accordion
// joins the nearest group, and a standalone Collapsible carries its
// own non-exclusive group — so neither is touched by the outer
// accordion's exclusivity.
<Accordion>
  <Accordion.Item value="order">
    <Accordion.Trigger>Track an order</Accordion.Trigger>
    <Accordion.Content>
      <Accordion>…</Accordion>
    </Accordion.Content>
  </Accordion.Item>

  <Accordion.Item value="soon">
    <Accordion.Trigger disabled>Not available yet</Accordion.Trigger>
    <Accordion.Content>…</Accordion.Content>
  </Accordion.Item>
</Accordion>`;

const rootRows = [
  { name: 'type', desc: "'single' (default) — one open at a time — or 'multiple'. The shape of value wins where they disagree: an array behaves as multiple whatever type says, and a string under type=\"multiple\" still reports an array back." },
  { name: 'value', desc: "Controlled: a string in single mode ('' = all closed), a string[] in multiple mode." },
  { name: 'defaultValue', desc: 'Uncontrolled seed, applied once at mount.' },
  { name: 'class', desc: 'Merged onto the collapsible-group host, after the card chrome.' },
  { name: '@change(value)', desc: "Value-first, fired once per user action with the next value. A nested accordion's rows are filtered out by group." },
];

const itemRows = [
  { name: 'value', desc: 'The id this row reports and answers to. Required for a controlled accordion.' },
  { name: 'class', desc: 'Merged onto the collapsible-component host.' },
];

const triggerRows = [
  { name: 'disabled', desc: "Renders the disabled attribute on the real button, so the component's click listener never fires. The root can still open the row." },
  { name: 'class', desc: 'Merged onto the button, after the row padding. The chevron flips on aria-expanded — pure CSS, no prop.' },
];

const contentRows = [
  { name: 'defaultOpen', desc: 'Start this row expanded. Uncontrolled accordions only, and initial only.' },
  { name: 'speed', desc: 'px/sec pace feeding the derived duration (component default 900).' },
  { name: 'minDuration / maxDuration', desc: 'Seconds; floor and ceiling for that duration (0.25 and 0.8).' },
  { name: 'easing', desc: 'CSS timing function, forwarded as --collapsible-easing.' },
  { name: 'class', desc: 'Merged onto the panel, after the padding. Never overflow-hidden, a height utility or a transition.' },
];

const FAQ = [
  { id: 'shipping', title: 'Shipping', body: 'Free carbon-neutral 2-day shipping on every order over $75. Orders placed before 2pm ET ship the same business day.' },
  { id: 'returns', title: 'Returns and exchanges', body: '30 days, no questions. Send them back in any condition for a full refund — return shipping is on us.' },
  { id: 'warranty', title: 'Warranty', body: 'Two years against manufacturing defects, extended to three if you register within a month.' },
];

const SPECS = [
  { id: 'audio', title: 'Audio', body: '40 mm dynamic drivers, adaptive hybrid noise cancellation, 20 Hz – 20 kHz.' },
  { id: 'battery', title: 'Battery', body: '38 hours of playback; a ten-minute charge returns roughly five hours.' },
  { id: 'connectivity', title: 'Connectivity', body: 'Multipoint Bluetooth 5.3, USB-C, and a 3.5 mm analogue fallback.' },
];

export default class AccordionDoc extends PuzzleView {
  created() {
    this.setData({ faqOpen: 'shipping', specsOpen: ['audio'] });
  }

  data() {
    const d = this.getData();
    const specsOpen = Array.isArray(d.specsOpen) ? d.specsOpen : [];
    return {
      faq: FAQ,
      specs: SPECS,
      faqOpen: d.faqOpen,
      specsOpen,
      faqLabel: d.faqOpen ? `'${d.faqOpen}'` : "'' (all closed)",
      specsLabel: specsOpen.length ? `['${specsOpen.join("', '")}']` : '[]',
      installCmd,
      installDep,
      installCss,
      usageImport,
      usageMarkup,
      codeHero,
      codeMultiple,
      codeControlled,
      codeRich,
      rootRows,
      itemRows,
      triggerRows,
      contentRows,
      toc: [
        { label: 'Installation', href: '#installation' },
        { label: 'Usage', href: '#usage' },
        { label: 'Multiple open', href: '#multiple' },
        { label: 'Driven from outside', href: '#controlled' },
        { label: 'Rich panels', href: '#rich' },
        { label: 'Reference', href: '#reference' },
      ],
    };
  }

  events = {
    setFaqOpen: (value) => {
      this.setData('faqOpen', value);
      this.refresh();
    },
    setSpecsOpen: (value) => {
      this.setData('specsOpen', value);
      this.refresh();
    },
    openRow: (id) => {
      this.setData('faqOpen', id);
      this.refresh();
    },
    closeAll: () => {
      this.setData('faqOpen', '');
      this.refresh();
    },
  };
}
</script>
