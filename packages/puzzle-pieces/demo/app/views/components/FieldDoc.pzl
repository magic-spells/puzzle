<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full min-w-0 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Field</h1>
        <p class="mt-2 text-body">
          The workhorse labeled text input — label, hint or error helper text, and ARIA wiring come
          built in. Controlled: the parent owns the value and updates it from
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">@change</code>,
          or hand it a form from <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">@magic-spells/puzzle/forms</code>
          and a <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">name</code> and it wires itself.
        </p>
      </header>

      <ExampleBox code={ codeHero }>
        <div class="w-full max-w-sm">
          <Field label="Full name" placeholder="Ada Lovelace" value={ name } @change={ setName } />
        </div>
      </ExampleBox>

      <section id="installation" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Installation</h2>
        <p class="mb-3 text-sm text-body">
          Copy the piece into your app — it compiles with your build and the code is yours:
        </p>
        <CodeBlock code={ installCmd }/>
        <p class="mt-3 text-sm text-muted">
          Requires the pieces.css tokens merged into your app styles (see Introduction).
        </p>
      </section>

      <section id="usage" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Usage</h2>
        <CodeBlock code={ usageImport }/>
        <CodeBlock code={ usageMarkup } class="mt-3"/>
      </section>

      <div class="mt-12 space-y-12">
        <ExampleBox id="hint" title="Hint" code={ codeHint }>
          <div class="w-full max-w-sm">
            <Field label="Company" hint="As it appears on your invoice" placeholder="Acme Inc." />
          </div>
        </ExampleBox>

        <ExampleBox id="error" title="Error" code={ codeError }>
          <div class="w-full max-w-sm">
            <Field label="Email" value="taken@example.com" error="That address is already in use" />
          </div>
        </ExampleBox>

        <ExampleBox id="disabled" title="Disabled" code={ codeDisabled }>
          <div class="w-full max-w-sm">
            <Field label="Read-only" value="Locked field" disabled />
          </div>
        </ExampleBox>

        <ExampleBox id="form" title="With a form" code={ codeForm }>
          <form class="w-full max-w-sm space-y-3" @submit={ save(event) } novalidate>
            <Field form={ form } name="name" label="Name" />
            <Field form={ form } name="email" type="email" label="Email" hint="Leave it, then come back" />
            <button type="submit" class="h-9 rounded-lg border border-border px-3 text-sm text-ink">Save</button>
            {#if savedAs}<p class="text-sm text-muted">Saved { savedAs }</p>{/if}
          </form>
        </ExampleBox>
      </div>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView, PuzzleModel, Puzzle } from '@magic-spells/puzzle';
import { createForm } from '@magic-spells/puzzle/forms';
import Field from '@/components/ui/Field.pzl';
import ExampleBox from '@/components/docs/ExampleBox.pzl';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';

// Docs page for Field — follows the ButtonDoc exemplar shape.
const installCmd = 'puzzle add piece field';
const usageImport = `import Field from '@/components/ui/Field.pzl';`;
const usageMarkup = `<Field label="Full name" placeholder="Ada Lovelace" value={ name } @change={ setName } />`;

const codeHero = `<Field label="Full name" placeholder="Ada Lovelace" value={ name } @change={ setName } />

// parent
events = {
  setName: (v) => this.setState('name', v),
};`;

const codeHint = `<Field label="Company" hint="As it appears on your invoice" placeholder="Acme Inc." />`;

const codeError = `<Field label="Email" value="taken@example.com" error="That address is already in use" />`;

const codeDisabled = `<Field label="Read-only" value="Locked field" disabled />`;

const codeForm = `<form @submit={ save(event) } novalidate>
  <Field form={ form } name="name" label="Name" />
  <Field form={ form } name="email" type="email" label="Email" />
  <button type="submit">Save</button>
</form>

// parent: form comes from @magic-spells/puzzle/forms
created() {
  this.form = createForm(this, Signup, { fields: ['name', 'email'] });
}
events = {
  save: (event) => this.form.submit(event, (values) => api.save(values)),
};`;

// the rules the "with a form" example validates against. createForm reads
// them through the model's static validate(), so the model needs no store.
class Signup extends PuzzleModel {
  static schema = {
    name: Puzzle.string().required('Enter your name'),
    email: Puzzle.string()
      .required('Enter an email')
      .validate((v) => /^[^@\s]+@[^@\s]+$/.test(v), 'That doesn\'t look like an email'),
  };
}

export default class FieldDoc extends PuzzleView {
  created() {
    this.setState({ name: '', savedAs: '' });
    // writes the controller to state as `form`; Field reads values and errors from it
    this.form = createForm(this, Signup, { fields: ['name', 'email'] });
  }

  data(params, props) {
    return {
      ...this.getData(),
      installCmd,
      usageImport,
      usageMarkup,
      codeHero,
      codeHint,
      codeError,
      codeDisabled,
      codeForm,
      toc: [
        { label: 'Installation', href: '#installation' },
        { label: 'Usage', href: '#usage' },
        { label: 'Hint', href: '#hint' },
        { label: 'Error', href: '#error' },
        { label: 'Disabled', href: '#disabled' },
        { label: 'With a form', href: '#form' },
      ],
    };
  }

  events = {
    setName: (v) => this.setState('name', v),
    // a real app would send the values to a server here; the demo just echoes them
    save: (event) => this.form.submit(event, (values) => this.setState('savedAs', values.email)),
  };
}
</script>
