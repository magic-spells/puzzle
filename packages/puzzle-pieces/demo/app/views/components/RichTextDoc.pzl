<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full min-w-0 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Rich Text</h1>
        <p class="mt-2 text-body">
          Renders a stored rich text document — the JSON tree Rich Text Editor emits — as
          semantic HTML with the shared typography classes. A zero-dependency tree walker
          built on
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">createTextNode</code>,
          so stored content can never inject markup.
        </p>
      </header>

      <ExampleBox code={ codeHero }>
        <div class="w-full max-w-xl">
          <RichText doc={ sampleDoc } />
        </div>
      </ExampleBox>

      <section id="installation" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Installation</h2>
        <p class="mb-3 text-sm text-body">
          Copy the piece into your app — no npm packages required:
        </p>
        <CodeBlock code={ installCmd }/>
      </section>

      <section id="usage" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Usage</h2>
        <CodeBlock code={ usageImport }/>
        <CodeBlock code={ usageMarkup } class="mt-3"/>
        <p class="mt-3 text-sm text-muted">
          Content renders client-side (the walker runs after mount), so it appears after
          takeover on prerendered pages rather than in the baked markup.
        </p>
      </section>

      <div class="mt-12 space-y-12">
        <section id="data-format" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Data format</h2>
          <p class="mb-3 text-sm text-body">
            The tree is a superset of Shopify's rich text metafield format — see the Rich
            Text Editor page for the full node reference. The example above renders this
            document:
          </p>
          <CodeBlock code={ codeDoc }/>
        </section>
      </div>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import RichText from '@/components/ui/RichText.pzl';
import ExampleBox from '@/components/docs/ExampleBox.pzl';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';

// Docs page for RichText — follows the ButtonDoc exemplar shape.
const installCmd = 'puzzle add piece rich-text';
const usageImport = `import RichText from '@/components/ui/RichText.pzl';`;
const usageMarkup = `<RichText doc={ article.body } />`;
const codeHero = `<RichText doc={ sampleDoc } />`;

const SAMPLE_DOC = {
	type: 'root',
	children: [
		{ type: 'heading', level: 2, children: [{ type: 'text', value: 'Care instructions' }] },
		{
			type: 'paragraph',
			children: [
				{ type: 'text', value: 'Machine wash ' },
				{ type: 'text', value: 'cold', bold: true },
				{ type: 'text', value: ' with like colors. See the ' },
				{ type: 'link', url: 'https://example.com', children: [{ type: 'text', value: 'full guide' }] },
				{ type: 'text', value: '.' },
			],
		},
		{
			type: 'list',
			listType: 'unordered',
			children: [
				{ type: 'list-item', children: [{ type: 'text', value: 'Do not bleach' }] },
				{ type: 'list-item', children: [{ type: 'text', value: 'Tumble dry low' }] },
			],
		},
		{
			type: 'blockquote',
			children: [
				{ type: 'paragraph', children: [{ type: 'text', value: 'Lasts twice as long when you follow the label.', italic: true }] },
			],
		},
	],
};

const codeDoc = JSON.stringify(SAMPLE_DOC, null, 2);

export default class RichTextDoc extends PuzzleView {
	data(params, props) {
		return {
			sampleDoc: SAMPLE_DOC,
			installCmd,
			usageImport,
			usageMarkup,
			codeHero,
			codeDoc,
			toc: [
				{ label: 'Installation', href: '#installation' },
				{ label: 'Usage', href: '#usage' },
				{ label: 'Data format', href: '#data-format' },
			],
		};
	}
}
</script>
