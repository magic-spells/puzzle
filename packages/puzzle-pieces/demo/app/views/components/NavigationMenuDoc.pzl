<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full min-w-0 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Navigation Menu</h1>
        <p class="mt-2 text-body">
          A site-header bar with hover or click flyout panels — popover dropdowns, submenus that open
          to the side, and full-width mega panels laid out in headed columns. It is a
          compound <strong class="font-medium text-ink">family</strong> composed over the shared
          <a class="text-brand underline underline-offset-2" href="#/components/dropdown-panel">Dropdown Panel</a>
          base, so hover intent, the hover bridge, one-open-at-a-time arbitration, outside-press
          dismissal and the whole keyboard model come from the web component rather than from a
          hand-rolled copy in this file.
        </p>
        <p class="mt-3 text-body">
          Accessibility is the <strong class="font-medium text-ink">disclosure</strong> pattern, not
          menubar or menuitem roles: those promise a desktop-app keyboard model that links to pages
          do not deliver. Every trigger is a real button the component wires with
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">aria-expanded</code>,
          and every item is a real
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">{ '<a>' }</code>
          and a natural Tab stop.
        </p>
        <div class="mt-4 rounded-lg border border-border bg-surface-sunken p-4">
          <p class="text-sm font-medium text-ink">Breaking change in 0.7.0</p>
          <p class="mt-1 text-sm text-body">
            The <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">items</code>
            and <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">activePath</code>
            props are gone. The bar is now written as markup — nested
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">items[].children[]</code>
            config is exactly the shape a compound family replaces. Active state is per link
            (<code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">current</code>),
            and the old rAF viewport clamp is replaced by
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">wide</code>
            and <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">align="end"</code>,
            both pure CSS.
          </p>
        </div>
      </header>

      <ExampleBox code={ codeHero }>
        <!-- self-start + pb-96: the header sits at the top of the stage with
             room below it for the mega panel, instead of centred over it. -->
        <div class="w-full max-w-4xl self-start pb-96">
          <NavigationMenu label="Main" class="w-full">
            <li class="mr-3 flex items-center gap-2 pl-2">
              <span class="size-5 rounded-md bg-brand" aria-hidden="true"></span>
              <span class="text-sm font-semibold text-ink">Acme</span>
            </li>

            <NavigationMenu.Item>
              <NavigationMenu.Trigger>Products</NavigationMenu.Trigger>
              <NavigationMenu.Content wide={ true }>
                {#for group in productGroups}
                  <NavigationMenu.Group key={ group.label } label={ group.label }>
                    {#for row in group.links}
                      <NavigationMenu.Link key={ row.href } href={ row.href } label={ row.label } description={ row.description }/>
                    {/for}
                  </NavigationMenu.Group>
                {/for}
                <div class="flex flex-col justify-between gap-4 rounded-lg bg-surface-sunken p-4">
                  <div>
                    <Badge variant="brand">New</Badge>
                    <p class="mt-3 text-sm font-medium text-ink">Workflows 2.0</p>
                    <p class="mt-1 text-sm text-muted">Branching, retries and approvals, on every plan.</p>
                  </div>
                  <a href="#workflows" class="text-sm font-medium text-ink underline decoration-brand decoration-2 underline-offset-4">Launch post →</a>
                </div>
              </NavigationMenu.Content>
            </NavigationMenu.Item>

            <NavigationMenu.Item>
              <NavigationMenu.Trigger>Solutions</NavigationMenu.Trigger>
              <NavigationMenu.Content class="w-60">
                {#for row in solutions}
                  <NavigationMenu.Link key={ row.href } href={ row.href } label={ row.label }/>
                {/for}

                <NavigationMenu.Item>
                  <NavigationMenu.Trigger variant="card">By industry</NavigationMenu.Trigger>
                  <NavigationMenu.Content opens="right" class="w-52">
                    {#for row in industries}
                      <NavigationMenu.Link key={ row.href } href={ row.href } label={ row.label }/>
                    {/for}
                  </NavigationMenu.Content>
                </NavigationMenu.Item>
              </NavigationMenu.Content>
            </NavigationMenu.Item>

            <NavigationMenu.Item>
              <NavigationMenu.Trigger>Resources</NavigationMenu.Trigger>
              <NavigationMenu.Content class="w-72">
                {#for row in resources}
                  <NavigationMenu.Link key={ row.href } href={ row.href } label={ row.label } description={ row.description }/>
                {/for}
              </NavigationMenu.Content>
            </NavigationMenu.Item>

            <li><NavigationMenu.Link variant="bar" href="#pricing" label="Pricing" current={ true }/></li>
            <li><NavigationMenu.Link variant="bar" href="#docs" label="Docs"/></li>
            <li class="ml-auto"><Button variant="outline" size="sm">Sign in</Button></li>
          </NavigationMenu>
        </div>
      </ExampleBox>

      <section id="installation" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Installation</h2>
        <p class="mb-3 text-sm text-body">
          Copy the family into your app. It pulls the shared
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">dropdown-panel</code>
          base along with it:
        </p>
        <CodeBlock code={ installCmd }/>
        <p class="mb-3 mt-4 text-sm text-body">
          That base has a runtime dependency — the web component it wraps:
        </p>
        <CodeBlock code={ installDep }/>
        <p class="mb-3 mt-4 text-sm text-body">
          Then merge its stylesheets into your app's style entry. The first is required: it
          positions the panels and carries the <span class="font-medium text-ink">hover bridge</span>
          that keeps a menu open while the pointer crosses the gap to its panel — without it a
          hover-opened panel closes under the cursor. The second draws the trigger arrow and the
          entrance effects, and the stock trigger already carries the arrow hook:
        </p>
        <CodeBlock code={ installCss }/>
        <p class="mt-3 text-sm text-muted">
          Requires the pieces.css tokens merged into your app styles (see Introduction).
        </p>
      </section>

      <section id="usage" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Usage</h2>
        <CodeBlock code={ usageImport }/>
        <CodeBlock code={ usageMarkup } class="mt-3"/>
        <p class="mt-3 text-sm text-body">
          The <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">{ '<nav>' }</code>
          is <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">relative</code>
          and that is load-bearing: a <span class="font-medium text-ink">wide</span> mega panel's
          host goes <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">position: static</code>
          so the panel spans the nearest positioned ancestor, and this element is it. That is why
          the example above puts the logo and the sign-in button in the bar as bare
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">{ '<li>' }</code>s: the whole header is the
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">{ '<nav>' }</code>, so a mega panel spans all of it.
        </p>
        <p class="mt-3 text-sm text-muted">
          <span class="font-medium text-ink">Item</span> is the
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">{ '<li>' }</code>
          that keeps the bar valid list markup, with the dropdown inside it — which is fine, because
          the direct-children rule is about the trigger and panel being direct children of the
          dropdown component, and the list item sits outside it. Every Item is a dropdown; a plain
          top-level link needs no member at all — write a bare
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">{ '<li>' }</code>
          around a <span class="font-medium text-ink">Link</span> with
          <span class="font-medium text-ink">variant="bar"</span>.
        </p>
      </section>

      <div class="mt-12 space-y-12">
        <section id="mega" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Mega panels</h2>
          <p class="text-sm text-body">
            <span class="font-medium text-ink">wide</span> makes a Content span the whole
            <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">{ '<nav>' }</code> and switches it to the mega layout: generous
            padding, wide gutters, and one equal column per child from
            <span class="font-medium text-ink">md</span> up (two per row from
            <span class="font-medium text-ink">sm</span>, stacked below). Give it one
            <span class="font-medium text-ink">NavigationMenu.Group</span> per column — a small
            uppercase heading over a stack of links — and the column count takes care of itself.
            Anything else can be a column too, like the promo card in the Products panel above.
          </p>
          <CodeBlock code={ codeMega } class="mt-4"/>
          <p class="mt-3 text-sm text-muted">
            Each Group is a <span class="font-medium text-ink">role="group"</span> named by its
            label, so a screen reader announces the column as focus enters it.
          </p>
        </section>

        <ExampleBox id="columns" title="Wide panel with explicit columns" code={ codeColumns }>
          <div class="w-full max-w-3xl self-start pb-72">
            <NavigationMenu class="w-full">
              <NavigationMenu.Item>
                <NavigationMenu.Trigger>Platform</NavigationMenu.Trigger>
                <NavigationMenu.Content wide={ true } columns={ 3 } effect="slide">
                  {#for row in platform}
                    <NavigationMenu.Link key={ row.href } href={ row.href } label={ row.label } description={ row.description }/>
                  {/for}
                </NavigationMenu.Content>
              </NavigationMenu.Item>

              <li><NavigationMenu.Link variant="bar" href="#pricing" label="Pricing"/></li>
            </NavigationMenu>
          </div>
        </ExampleBox>

        <ExampleBox id="submenu" title="Nested submenu and right alignment" code={ codeSubmenu }>
          <div class="flex w-full flex-col items-stretch gap-3 self-start pb-56">
            <div class="flex w-full max-w-2xl justify-end">
              <NavigationMenu>
                <NavigationMenu.Item>
                  <NavigationMenu.Trigger>Company</NavigationMenu.Trigger>
                  <NavigationMenu.Content align="end" class="w-56">
                    <NavigationMenu.Link href="#about" label="About"/>
                    <NavigationMenu.Link href="#careers" label="Careers"/>

                    <NavigationMenu.Item>
                      <NavigationMenu.Trigger variant="card">Support</NavigationMenu.Trigger>
                      <NavigationMenu.Content opens="right" class="w-48">
                        <NavigationMenu.Link href="#contact" label="Contact us"/>
                        <NavigationMenu.Link href="#help" label="Help center"/>
                      </NavigationMenu.Content>
                    </NavigationMenu.Item>
                  </NavigationMenu.Content>
                </NavigationMenu.Item>
              </NavigationMenu>
            </div>
            <p class="w-full max-w-2xl text-sm text-muted">
              A submenu is an Item nested inside a Content with
              <span class="font-medium text-ink">opens="right"</span>. Escape closes one level at a
              time, and the left arrow returns from a submenu to its trigger. The outer panel is
              <span class="font-medium text-ink">align="end"</span>, which hugs the right edge with
              two utilities instead of a measuring pass.
            </p>
          </div>
        </ExampleBox>

        <section id="spacing" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Spacing and the hover bridge</h2>
          <p class="text-sm text-body">
            Every panel opens 8px clear of what opened it: below its trigger, below the bar for a
            wide panel, and beside its row for a submenu, lifted so the submenu's first link lines
            up with that row. A hover-opened panel would close the moment the pointer left the
            trigger for that gap, so the core stylesheet draws an invisible, hit-testable wedge —
            the <span class="font-medium text-ink">hover bridge</span> — under a downward trigger and
            beside a submenu's, which keeps the pointer inside the menu on the way across.
          </p>
          <p class="mt-3 text-sm text-body">
            The wedge covers a straight or steep crossing. A wide panel sits further away — the
            bar's padding and border plus the gap — and runs the whole bar, so a shallow diagonal
            to a far column leaves the wedge; so does a slant down to a submenu's lower rows. So
            every Item also carries a short
            <span class="font-medium text-ink">closeDelay</span> (200ms by default): a pointer that
            reaches the panel inside that window cancels the close. Hover-opened panels only; a
            clicked one stays until it is dismissed.
          </p>
          <p class="mt-3 text-sm text-muted">
            The bridge is the trigger's
            <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">::before</code>. Never style that pseudo-element or put
            <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">overflow-hidden</code> anywhere up the chain — draw arrows and
            decorations with real child elements.
          </p>
        </section>

        <section id="keyboard" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Keyboard</h2>
          <p class="mb-3 text-sm text-body">
            All of it lives in the web component; this piece adds no key handling of its own.
          </p>
          <div class="text-sm">
            {#for row in keyRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>
        </section>

        <section id="reference" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Reference</h2>

          <h3 class="mb-2 mt-6 text-sm font-semibold text-ink">NavigationMenu</h3>
          <div class="text-sm">
            {#for row in rootRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">NavigationMenu.Item</h3>
          <div class="text-sm">
            {#for row in itemRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">NavigationMenu.Trigger</h3>
          <div class="text-sm">
            {#for row in triggerRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">NavigationMenu.Content</h3>
          <div class="text-sm">
            {#for row in contentRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">NavigationMenu.Group</h3>
          <div class="text-sm">
            {#for row in groupRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>

          <h3 class="mb-2 mt-8 text-sm font-semibold text-ink">NavigationMenu.Link</h3>
          <div class="text-sm">
            {#for row in linkRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>
        </section>
      </div>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import NavigationMenu from '@/components/ui/NavigationMenu/index.js';
import ExampleBox from '@/components/docs/ExampleBox.pzl';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';
import Button from '@/components/ui/Button.pzl';
import Badge from '@/components/ui/Badge.pzl';

// Docs page for the NavigationMenu family. Code samples live as
// template-literal consts because literal tag names and {#…} tokens would be
// parsed as template syntax in prose.
const installCmd = 'puzzle add piece navigation-menu';
const installDep = 'npm install @magic-spells/dropdown-panel@^2.1.1';
const installCss = `/* app/styles/styles.css */
@import "tailwindcss";
@import "@magic-spells/dropdown-panel/css" layer(components);         /* required */
@import "@magic-spells/dropdown-panel/css/effects" layer(components); /* optional */`;

const usageImport = `import NavigationMenu from '@/components/ui/NavigationMenu';`;

const usageMarkup = `<NavigationMenu label="Main">
  <NavigationMenu.Item>
    <NavigationMenu.Trigger>Products</NavigationMenu.Trigger>
    <NavigationMenu.Content columns={ 2 } class="w-max max-w-lg">
      <NavigationMenu.Link href="/analytics" label="Analytics" description="Traffic and funnels." />
      <NavigationMenu.Link href="/billing" label="Billing" description="Plans and invoices." />
    </NavigationMenu.Content>
  </NavigationMenu.Item>

  <li><NavigationMenu.Link variant="bar" href="/pricing" label="Pricing" /></li>
</NavigationMenu>`;

const codeHero = `// A whole site header. The logo and the sign-in button are bare <li>s, so
// the header IS the <nav> — and a wide panel spans all of it.
<NavigationMenu label="Main" class="w-full">
  <li class="mr-3 flex items-center gap-2 pl-2">…logo…</li>

  <NavigationMenu.Item>
    <NavigationMenu.Trigger>Products</NavigationMenu.Trigger>
    <NavigationMenu.Content wide>
      <NavigationMenu.Group label="Analyze">
        <NavigationMenu.Link href="/analytics" label="Analytics" description="Traffic, funnels and retention." />
        …
      </NavigationMenu.Group>
      <NavigationMenu.Group label="Automate">…</NavigationMenu.Group>
      <NavigationMenu.Group label="Connect">…</NavigationMenu.Group>
      <div class="rounded-lg bg-surface-sunken p-4">…promo…</div>
    </NavigationMenu.Content>
  </NavigationMenu.Item>

  <NavigationMenu.Item>
    <NavigationMenu.Trigger>Solutions</NavigationMenu.Trigger>
    <NavigationMenu.Content class="w-60">
      <NavigationMenu.Link href="/startups" label="For startups" />
      …
      <NavigationMenu.Item>
        <NavigationMenu.Trigger variant="card">By industry</NavigationMenu.Trigger>
        <NavigationMenu.Content opens="right" class="w-52">
          <NavigationMenu.Link href="/retail" label="Retail" />
          …
        </NavigationMenu.Content>
      </NavigationMenu.Item>
    </NavigationMenu.Content>
  </NavigationMenu.Item>

  <li><NavigationMenu.Link variant="bar" href="/pricing" label="Pricing" current={ true } /></li>
  <li><NavigationMenu.Link variant="bar" href="/docs" label="Docs" /></li>
  <li class="ml-auto"><Button variant="outline" size="sm">Sign in</Button></li>
</NavigationMenu>`;

const codeMega = `// One column per child from md up — each Group is a column.
<NavigationMenu.Content wide>
  <NavigationMenu.Group label="Software">
    <NavigationMenu.Link href="/web" label="Web apps" description="…" />
    <NavigationMenu.Link href="/mobile" label="Mobile apps" />
  </NavigationMenu.Group>
  <NavigationMenu.Group label="Hardware">…</NavigationMenu.Group>
  <NavigationMenu.Group label="Services">…</NavigationMenu.Group>
</NavigationMenu.Content>`;

const codeColumns = `// A flat run of links in a wide panel takes an explicit column count:
// 3 is one column on phones, two from sm, three from lg.
<NavigationMenu.Item>
  <NavigationMenu.Trigger>Platform</NavigationMenu.Trigger>
  <NavigationMenu.Content wide columns={ 3 } effect="slide">
    <NavigationMenu.Link href="/pipeline" label="Data pipeline" description="…" />
    …
  </NavigationMenu.Content>
</NavigationMenu.Item>`;

const codeSubmenu = `// A submenu is just an Item nested in a Content with opens="right",
// which moves the panel beside its trigger and rotates the hover
// bridge onto the horizontal axis.
<NavigationMenu.Content align="end" class="w-56">
  <NavigationMenu.Link href="/about" label="About" />

  <NavigationMenu.Item>
    <NavigationMenu.Trigger variant="card">Support</NavigationMenu.Trigger>
    <NavigationMenu.Content opens="right" class="w-48">
      <NavigationMenu.Link href="/contact" label="Contact us" />
    </NavigationMenu.Content>
  </NavigationMenu.Item>
</NavigationMenu.Content>`;

const keyRows = [
  { name: 'Enter / Space', desc: 'On a trigger: toggle its panel.' },
  { name: 'ArrowDown / ArrowUp', desc: 'On a closed trigger: open and focus the first (or last) link. Inside an open panel: move link focus, wrapping at the ends.' },
  { name: 'Home / End', desc: 'Inside an open panel: first / last link.' },
  { name: 'ArrowRight / ArrowLeft', desc: 'Open an opens="right" submenu, and close it again returning focus to its trigger.' },
  { name: 'Escape', desc: 'Close one level and focus its trigger. Only the innermost open panel answers.' },
  { name: 'Tab', desc: 'Normal order through the links. A closed panel is inert, so it is skipped.' },
];

const rootRows = [
  { name: 'label', desc: 'aria-label for the <nav>. Defaults to "Main".' },
  { name: 'gap', desc: 'Tailwind gap utility for the bar. Defaults to gap-0.5.' },
  { name: 'class', desc: 'Merged onto <nav>, after the bar chrome and the load-bearing `relative`.' },
];

const itemRows = [
  { name: 'trigger', desc: "'hover' | 'click' | 'both' (default), forwarded to the base." },
  { name: 'arrow', desc: "'flip' (default) | 'static' | 'none', forwarded to the base." },
  { name: 'open', desc: 'Optional-controlled and edge-triggered, forwarded. Omit it and the component owns its own state.' },
  { name: 'openDelay', desc: 'ms of hover intent before a hover-opened panel shows, forwarded.' },
  { name: 'closeDelay', desc: 'ms of grace after the pointer leaves before a hover-opened panel hides. Defaults to 200, so a diagonal trip to a wide panel survives leaving the bridge.' },
  { name: '@show / @hide', desc: "Fired when THIS item's panel opens or closes; a nested submenu's events are filtered out." },
  { name: 'class', desc: 'Merged onto the <li>.' },
];

const triggerRows = [
  { name: 'variant', desc: "'bar' (default) for a rounded pill in the bar, brand-tinted on hover and while its panel is open; 'card' for an in-panel submenu trigger — a full-width row with the arrow at the trailing edge." },
  { name: 'arrow', desc: 'true (default) renders the [data-dropdown-arrow] hook the effects stylesheet draws into. false drops it.' },
  { name: 'class', desc: 'Merged onto <dropdown-trigger>, after the variant chrome.' },
];

const contentRows = [
  { name: 'columns', desc: '1 (default), 2, 3 or 4. 2 is two from md up; 3 and 4 are two from sm and three or four from lg. Unset on a wide panel: one column per child from md up.' },
  { name: 'wide', desc: 'A full-width mega panel spanning the <nav>, with mega padding and gutters.' },
  { name: 'opens', desc: "'down' (default) | 'right' for a submenu." },
  { name: 'align', desc: "'start' (default) | 'end'. end is left-auto right-0 — pure CSS, no measuring." },
  { name: 'effect', desc: "'fade' | 'slide' | 'scale' | 'blur' | 'swing'. Needs the effects stylesheet." },
  { name: 'class', desc: 'Merged onto <dropdown-panel>, after the layout classes. Never overflow-hidden.' },
];

const groupRows = [
  { name: 'label', desc: 'The column heading — small, uppercase, tracked — and the group\'s accessible name. Optional.' },
  { name: 'class', desc: 'Merged onto the wrapper <div>.' },
];

const linkRows = [
  { name: 'href', desc: "Defaults to '#'." },
  { name: 'label', desc: "The text. Falls back to the component's children when unset, which is how you put an icon or a badge in a link." },
  { name: 'description', desc: 'A second line under the label, clamped to two lines. Card variant in practice.' },
