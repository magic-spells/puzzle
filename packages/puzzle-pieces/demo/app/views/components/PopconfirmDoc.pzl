<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full min-w-0 max-w-5xl">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Popconfirm</h1>
        <p class="mt-2 text-body">
          A lightweight inline confirmation bubble anchored to its trigger, for low-stakes
          confirmations that do not warrant a modal. It wraps the shared
          <a class="text-brand underline underline-offset-2" href="#/components/dropdown-panel">Dropdown Panel</a>
          base, so press-to-toggle, outside-press and Escape dismissal, focus return and
          one-open-at-a-time are the web component's. Reach for
          <a class="text-brand underline underline-offset-2" href="#/components/alert-dialog">Alert Dialog</a>
          when the action deserves a focus-trapping modal.
        </p>
        <p class="mt-3 text-body">
          Unlike its Popover and Hover Card cousins this stays a
          <strong class="font-medium text-ink">single component</strong>: the panel is entirely
          prescribed — a title, an optional description and two buttons — so the one content
          channel a piece gets goes to the trigger.
        </p>
        <div class="mt-4 rounded-lg border border-border bg-surface-sunken p-4">
          <p class="text-sm font-medium text-ink">Breaking changes in 0.7.0</p>
          <p class="mt-1 text-sm text-body">
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">message</code>
            is now <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">title</code>;
            the trigger slot is now plain children;
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">placement</code>
            is gone (bubbles open downward — use
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">align</code>
            for the horizontal edge). And dismissal is no longer cancel: Escape and an outside
            press close the bubble without firing
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">@cancel</code>,
            which now means the Cancel button was pressed. Listen to
            <code class="rounded bg-surface px-1 py-0.5 font-mono text-[13px] text-ink">@hide</code>
            if you need every close.
          </p>
        </div>
      </header>

      <ExampleBox code={ codeHero }>
        <div class="flex w-full max-w-xl flex-wrap items-center justify-center gap-4 pb-32 pt-8">
          <Popconfirm
            title="Delete this item?"
            confirmLabel="Delete"
            variant="danger"
            @confirm={ onConfirm('deleted') }
            @cancel={ onCancel }>
            <span class={ dangerTrigger }>Delete</span>
          </Popconfirm>

          <Popconfirm
            title="Publish these changes?"
            description="Everyone on the team sees them immediately."
            confirmLabel="Publish"
            label="Publish"
            @confirm={ onConfirm('published') }
            @cancel={ onCancel }/>
        </div>
      </ExampleBox>

      <p class="mt-3 text-sm text-muted">Last action: <span class="font-medium text-ink">{ status }</span></p>

      <section id="installation" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Installation</h2>
        <p class="mb-3 text-sm text-body">
          Copy the piece into your app. It pulls the shared
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">dropdown-panel</code>
          base along with it:
        </p>
        <CodeBlock code={ installCmd }/>
        <p class="mb-3 mt-4 text-sm text-body">
          That base has a runtime dependency — the web component it wraps:
        </p>
        <CodeBlock code={ installDep }/>
        <p class="mb-3 mt-4 text-sm text-body">
          Then merge its stylesheets into your app's style entry. The first is required; the
          second adds the entrance effects and the drawn trigger arrow:
        </p>
        <CodeBlock code={ installCss }/>
        <p class="mt-3 text-sm text-muted">
          Requires the pieces.css tokens merged into your app styles (see Introduction).
        </p>
      </section>

      <section id="usage" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Usage</h2>
        <CodeBlock code={ usageImport }/>
        <CodeBlock code={ usageMarkup } class="mt-3"/>
        <p class="mt-3 text-sm text-body">
          The children are the trigger, and the stock secondary button is their
          <span class="font-medium text-ink">fallback</span>: pass none and
          <code class="rounded bg-surface-sunken px-1 py-0.5 font-mono text-[13px] text-ink">label</code>
          renders that button; pass your own and they replace it entirely, so a custom trigger
          must carry its own accessible name. Keep that content non-interactive — the trigger
          element is the control, so a nested button would be a second tab stop.
        </p>
      </section>

      <div class="mt-12 space-y-12">
        <ExampleBox id="rows" title="In a row of records" code={ codeRows }>
          <div class="w-full max-w-xl pb-40">
            <ul class="divide-y divide-border rounded-xl border border-border bg-surface">
              {#for row in records}
                <li key={ row.id } class="flex items-center justify-between gap-4 p-3">
                  <span class="text-sm text-ink">{ row.name }</span>
                  <Popconfirm
                    title={ row.question }
                    description="This cannot be undone."
                    confirmLabel="Delete"
                    variant="danger"
                    align="end"
                    @confirm={ onConfirm(row.id) }>
                    <span class={ dangerTrigger }>Delete</span>
                  </Popconfirm>
                </li>
              {/for}
            </ul>
            <p class="mt-3 text-sm text-muted">
              align="end" keeps each bubble inside the card — pure CSS, no measuring pass.
            </p>
          </div>
        </ExampleBox>

        <section id="reference" class="scroll-mt-20">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Reference</h2>
          <div class="text-sm">
            {#for row in propRows}
              <div key={ row.name } class="flex gap-4 border-b border-border py-2">
                <code class="w-44 shrink-0 font-mono text-ink">{ row.name }</code>
                <span class="text-body">{ row.desc }</span>
              </div>
            {/for}
          </div>
        </section>
      </div>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Popconfirm from '@/components/ui/Popconfirm.pzl';
import ExampleBox from '@/components/docs/ExampleBox.pzl';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';

// Docs page for Popconfirm. Code samples live as template-literal consts
// because literal tag names and {#…} tokens would be parsed as template syntax
// in prose.
const installCmd = 'puzzle add piece popconfirm';
const installDep = 'npm install @magic-spells/dropdown-panel';
const installCss = `/* app/styles/styles.css */
@import "tailwindcss";
@import "@magic-spells/dropdown-panel/css" layer(components);         /* required */
@import "@magic-spells/dropdown-panel/css/effects" layer(components); /* optional */`;

const usageImport = `import Popconfirm from '@/components/ui/Popconfirm';`;

const usageMarkup = `<Popconfirm title="Delete this item?" confirmLabel="Delete" variant="danger" @confirm={ remove }>
  <span class="…">Delete</span>
</Popconfirm>

// No children? The stock secondary button renders from the label prop:
<Popconfirm title="Publish these changes?" label="Publish" @confirm={ publish } />`;

const codeHero = `// Your own trigger, or the stock one from the label prop.
<Popconfirm title="Delete this item?" confirmLabel="Delete" variant="danger" @confirm={ remove }>
  <span class="…">Delete</span>
</Popconfirm>

<Popconfirm
  title="Publish these changes?"
  description="Everyone on the team sees them immediately."
  confirmLabel="Publish"
  label="Publish"
  @confirm={ publish }
  @cancel={ dismiss } />`;

const codeRows = `// One bubble per record, hugging the right edge of the card.
<Popconfirm
  title={ row.question }
  description="This cannot be undone."
  confirmLabel="Delete"
  variant="danger"
  align="end"
  @confirm={ onConfirm(row.id) }>
  <span class="…">Delete</span>
</Popconfirm>`;

const propRows = [
  { name: 'title', desc: 'The question. (Was `message` before 0.7.0.)' },
  { name: 'description', desc: 'A second line under the question.' },
  { name: 'label', desc: 'Text for the STOCK trigger — the fallback only. Call-site children win over it.' },
  { name: 'confirmLabel', desc: 'Defaults to "Confirm".' },
  { name: 'cancelLabel', desc: 'Defaults to "Cancel".' },
  { name: 'variant', desc: "'danger' tints the confirm button destructive." },
  { name: 'align', desc: "'start' (default) | 'end' — which edge the bubble hangs from." },
  { name: 'open', desc: 'Optional-controlled and edge-triggered. Omit it and the component owns its own state.' },
  { name: 'class', desc: 'Merged onto the panel.' },
  { name: 'triggerClass', desc: 'Merged onto the trigger element.' },
  { name: '@confirm', desc: 'The Confirm button was pressed; the bubble then closes and focus returns to the trigger.' },
  { name: '@cancel', desc: 'The Cancel button was pressed. Escape and outside presses do NOT fire this.' },
  { name: '@show / @hide', desc: 'Every open and close, dismissals included.' },
];

const DANGER_TRIGGER =
  'inline-flex h-9 cursor-pointer items-center rounded-lg px-3 text-sm font-medium text-danger ' +
  'transition-colors hover:bg-danger-tint outline-ring focus-visible:outline-2 focus-visible:outline-offset-2';

const RECORDS = [
  { id: 'invoice-118', name: 'Invoice #118', question: 'Delete invoice #118?' },
  { id: 'invoice-119', name: 'Invoice #119', question: 'Delete invoice #119?' },
];

export default class PopconfirmDoc extends PuzzleView {
  created() {
    this.setData({ status: 'nothing yet' });
  }

  data() {
    return {
      status: this.getData().status,
      dangerTrigger: DANGER_TRIGGER,
      records: RECORDS,
      installCmd,
      installDep,
      installCss,
      usageImport,
      usageMarkup,
      codeHero,
      codeRows,
      propRows,
      toc: [
        { label: 'Installation', href: '#installation' },
        { label: 'Usage', href: '#usage' },
        { label: 'In a row of records', href: '#rows' },
        { label: 'Reference', href: '#reference' },
      ],
    };
  }

  events = {
    onConfirm: (what) => {
      this.setData('status', `confirmed ${what}`);
      this.refresh();
    },
    onCancel: () => {
      this.setData('status', 'cancelled');
      this.refresh();
    },
  };
}
</script>
