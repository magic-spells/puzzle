<puzzle-view class="w-full">
  <div class="flex gap-12">
    <article class="mx-auto w-full max-w-5xl min-w-0">
      <header class="mb-8">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Theming</h1>
        <p class="mt-2 text-body">
          Every piece styles itself through the same set of semantic tokens —
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">bg-surface</code>,
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">text-ink</code>,
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">border-border</code>,
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">shadow-panel</code> —
          and never a colour of its own. The package ships four palettes and three modes,
          twelve appearances in all, and nothing inside a piece changes when you switch
          between them: the token names stay put, only their values move.
        </p>
      </header>

      <section id="model" class="mt-12 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">The model</h2>
        <p class="mb-3 text-sm/relaxed text-body">
          Two attributes on
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">{ htmlTag }</code>
          decide the appearance, and they are independent of each other.
        </p>
        <dl class="mb-5 space-y-3 text-sm/relaxed text-body">
          <div>
            <dt class="font-mono text-[13px] text-ink">data-scheme</dt>
            <dd class="mt-1">
              The palette — <span class="font-mono text-[13px] text-ink">dim</span>, <span class="font-mono text-[13px] text-ink">warm</span> or <span class="font-mono text-[13px] text-ink">void</span>. The default palette
              needs no attribute at all, because the
              <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">@theme</code>
              block is its values. Writing the attribute with the value <span class="font-mono text-[13px] text-ink">default</span> is still valid, and
              is how a preview restates the default palette inside a page that is currently
              in another one.
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[13px] text-ink">data-theme</dt>
            <dd class="mt-1">
              The mode — <span class="font-mono text-[13px] text-ink">light</span>, <span class="font-mono text-[13px] text-ink">medium</span> or <span class="font-mono text-[13px] text-ink">dark</span>. With the attribute
              absent the page follows the OS between light and dark; medium is never chosen
              by the OS, only by a person.
            </dd>
          </div>
        </dl>
        <p class="mb-3 text-sm/relaxed text-body">
          Every token is one
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">light-dark()</code>
          pair, so a mode block only has to set
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">color-scheme</code>
          and both halves resolve for free. Having
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">color-scheme</code>
          follow the mode is also what keeps native UI in step — form controls, scrollbars and
          dialog backdrops agree with the page, with no duplicate dark-mode class list.
        </p>
        <p class="mb-4 text-sm/relaxed text-body">
          Medium is <span class="text-ink">soft dark</span>: it runs on
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">color-scheme: dark</code>,
          so every pair already resolves to its dark half, then lifts the grounds to mid grey
          of the palette’s own hue and dims the type a stop. Each file’s medium block therefore
          lists only the tokens whose medium value differs from dark — light text on grey
          rather than on near-black, and a frame-to-panel contrast visibly softer than dark’s.
        </p>
        <CodeBlock code={ mechanismSnippet } lang="css"/>
      </section>

      <section id="install" class="mt-14 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Install</h2>
        <p class="mb-4 text-sm/relaxed text-body">
          The package exports the four stylesheets and the two runtime files:
        </p>
        <ul class="mb-5 space-y-2 text-sm/relaxed">
          {#for e in exportRows}
            <li key={ e.path } class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-3">
              <span class="shrink-0 font-mono text-[13px] text-ink">{ e.path }</span>
              <span class="text-muted">{ e.note }</span>
            </li>
          {/for}
        </ul>
        <p class="mb-4 text-sm/relaxed text-body">
          Always import the default stylesheet. It is
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">registry/theme/pieces.css</code>,
          it holds the
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">@theme</code>
          block every utility is generated from, and the other three only override its values.
          Add a palette file for each palette you want available; a palette is inert until
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">data-scheme</code>
          selects it, so importing one costs nothing but its bytes.
        </p>
        <CodeBlock code={ importSnippet } lang="css"/>
        <p class="mt-4 text-sm/relaxed text-body">
          A copy-in path — <span class="font-mono text-[13px] text-ink">puzzle add theme { nameArg }</span> —
          is planned, so a palette can be vendored into an app and retuned in place. Until it
          lands, copy the files out of
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">registry/theme/*.css</code>
          by hand.
        </p>
      </section>

      <section id="runtime" class="mt-14 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Switching at runtime</h2>
        <p class="mb-4 text-sm/relaxed text-body">
          The
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">appearance</code>
          export owns the two attributes; nothing else should write them. Call
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">boot()</code>
          first thing in <span class="font-mono text-[13px] text-ink">app.js</span> to make the
          module agree with the document, then
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">set({ setArg })</code>
          for changes,
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">current()</code>
          to read the choice in force, and
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">subscribe(fn)</code>
          to hear every apply — including one caused by another tab. A
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">mode</code>
          of <span class="font-mono text-[13px] text-ink">null</span> means follow the OS. The
          choice persists under one key,
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">puzzle:appearance</code>,
          as the JSON object
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">{ storedShape }</code>;
          a legacy stored mode of <span class="font-mono text-[13px] text-ink">mixed</span> reads as <span class="font-mono text-[13px] text-ink">medium</span>.
        </p>
        <CodeBlock code={ runtimeSnippet } lang="js"/>
        <p class="mt-6 mb-4 text-sm/relaxed text-body">
          One thing has to happen earlier than any module can: painting the stored choice.
          Inline the whole of
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">pre-paint</code>
          in the shell’s <span class="font-mono text-[13px] text-ink">{ headTag }</span>, before
          the stylesheet, and configure it with data attributes on the script tag itself:
          <span class="font-mono text-[13px] text-ink">data-key</span> is the storage key to
          read (an app that owns another key passes it here), <span class="font-mono text-[13px] text-ink">data-default-mode</span> the mode to
          paint when nothing is stored — omit it and the page follows the OS — and <span class="font-mono text-[13px] text-ink">data-default-scheme</span> the palette
          for that same case. A module arriving with <span class="font-mono text-[13px] text-ink">app.js</span> is a frame too late: the
          page paints the default first, and that is the flash.
        </p>
        <CodeBlock code={ prePaintSnippet } lang="html"/>
      </section>

      <section id="scoping" class="mt-14 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Scoping a subtree</h2>
        <p class="mb-4 text-sm/relaxed text-body">
          The palette selectors are deliberately unanchored — not tied to
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">:root</code> —
          so putting both attributes on any element renders that whole subtree in another
          palette and mode while the page around it keeps its own. That is the entire mechanism
          behind this demo’s compare grid and scheme panels. Give a scoped preview an explicit
          ground and ink
          (<code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">bg-surface</code>,
          <code class="rounded bg-surface-sunken px-1.5 py-0.5 font-mono text-[13px] text-ink">text-ink</code>)
          or it inherits the page’s.
        </p>
        <CodeBlock code={ scopeSnippet } lang="html"/>
      </section>

      <section id="tokens" class="mt-14 scroll-mt-20">
        <h2 class="mb-2 text-xl font-semibold tracking-tight text-ink">Tokens</h2>
        <p class="mb-6 max-w-2xl text-sm/relaxed text-body">
          The vocabulary is one contract shared by all four palettes: the same names, in the
          same groups, in every file. Text and surfaces cover content; the shell group covers
          the frame, bar, rail, panel and card a whole app window is built from; the alpha
          family holds the translucent wells, scrims and shadow colours that the composed
          shadows are built out of.
        </p>
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-border text-left text-xs text-muted">
              <th class="py-2 pr-4 font-medium">Group</th>
              <th class="py-2 pr-4 font-medium">Size</th>
              <th class="py-2 font-medium">What it covers</th>
            </tr>
          </thead>
          <tbody>
            {#for g in tokenRows}
              <tr key={ g.id } class="border-b border-border align-top">
                <td class="py-2.5 pr-4 font-mono text-[13px] text-ink">{ g.title }</td>
                <td class="py-2.5 pr-4 text-muted">{ g.count }</td>
                <td class="py-2.5 text-body">{ g.description }</td>
              </tr>
            {/for}
          </tbody>
        </table>
        <p class="mt-6 mb-3 text-sm/relaxed text-body">
          Every token, with its live value and its measured contrast, is on the palette pages:
        </p>
        <div class="flex flex-wrap gap-2">
          {#for l in tokenLinks}
            <a
              key={ l.href }
              href={ l.href }
              class="rounded-full border border-border bg-surface px-3 py-1 text-sm text-body transition-colors hover:border-border-strong hover:text-ink">{ l.label }</a>
          {/for}
        </div>
        <p class="mt-6 text-sm/relaxed text-body">
          The rule that holds all of this together: never write a colour in a piece. Reach for
          the utility the token already generates, and the piece is right in all twelve
          appearances without knowing any of them.
        </p>
      </section>

      <section id="adding" class="mt-14 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Adding a palette</h2>
        <p class="mb-4 text-sm/relaxed text-body">
          A palette is one file plus five registrations. Copy an existing scheme file, rename
          its selectors to the new name, and retune the values — keeping every token, because
          the tests compare token sets across files.
        </p>
        <ol class="mb-4 list-decimal space-y-2 pl-5 text-sm/relaxed text-body">
          {#for step in addSteps}
            <li key={ step }>{ step }</li>
          {/for}
        </ol>
        <p class="text-sm/relaxed text-body">
          Then run <span class="font-mono text-[13px] text-ink">npm test</span>. It enforces
          that every palette declares an identical token set, and that every palette clears AA
          in all three modes, so a half-finished palette fails loudly instead of shipping with
          holes.
        </p>
      </section>

      <section id="contrast" class="mt-14 scroll-mt-20">
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">Contrast</h2>
        <p class="text-sm/relaxed text-body">
          Every palette in every mode passes WCAG 2.2 AA on every pair the token list declares —
          4.5:1 for text roles against each ground they are allowed to sit on, 3:1 for non-text
          roles such as the focus ring and the dashed outline. The bar is part of the contract,
          not a review step: the tests measure it on each run, and the scheme panels in this
          demo show the ratios computed live from the stylesheet, so a retuned value is visibly
          in or out before it is committed.
        </p>
      </section>
    </article>

    <Toc class="sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block" items={ toc }/>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import CodeBlock from '@/components/docs/CodeBlock.pzl';
import Toc from '@/components/docs/Toc.pzl';
import { TOKEN_GROUPS } from '@/lib/tokenNames.js';

// Theming — the written model of the theme system. Prose and code only; the
// live token grids, swatches and contrast chips live on the /themes/* pages
// this page links out to. Kept accurate against registry/theme/pieces.css,
// registry/theme/appearance.js and registry/theme/pre-paint.js — when an
// export name, attribute or storage key changes there, change it here.
//
// Two hard rules in this file:
//  - NO colour literals anywhere, code samples included (a guard test greps for
//    hex). Samples carry placeholders in angle brackets where a value would go.
//  - Tags and braces that would otherwise be parsed as markup or as the brace
//    grammar go through data() as strings ({ htmlTag }, { headTag },
//    { storedShape }); a closing script tag inside a template literal is
//    written escaped, since an inline script ends at the first literal one.

const mechanismSnippet = `/* The mode sets color-scheme; every token is one light-dark() pair. */
:root                 { color-scheme: light dark; }  /* no attribute: the OS decides */
[data-theme='light']  { color-scheme: light; }
[data-theme='dark'],
[data-theme='medium'] { color-scheme: dark; }

@theme {
  --color-surface: light-dark(<light>, <dark>);
  --color-ink:     light-dark(<light>, <dark>);
  /* …every token, one pair… */
}

/* Medium already resolves to the dark half, so its block re-declares only
   the tokens whose medium value differs from dark: grounds lifted to mid
   grey, type dimmed a stop. */
[data-theme='medium'] {
  --color-surface: <lifted mid grey>;
  --color-ink:     <dimmed one stop>;
}

/* A palette overrides values under its own attribute — unanchored, so the
   same rules apply on the root and on any scoped subtree. */
[data-scheme='warm'] {
  --color-surface: light-dark(<light>, <dark>);
}`;

const importSnippet = `@import "tailwindcss";

/* Always: the default palette, and the @theme block every utility comes from. */
@import "@magic-spells/puzzle-pieces/themes/default.css";

/* Then a palette per scheme you want available — inert until data-scheme picks it. */
@import "@magic-spells/puzzle-pieces/themes/warm.css";`;

const runtimeSnippet = `import * as appearance from '@magic-spells/puzzle-pieces/appearance';

// First thing in app.js — makes the module agree with what pre-paint painted.
appearance.boot();

appearance.set({ scheme: 'warm', mode: 'medium' }); // both axes
appearance.set({ mode: null });                     // follow the OS
appearance.current();                               // -> { scheme, mode }

const off = appearance.subscribe(({ scheme, mode }) => update(scheme, mode));
// call off() in destroyed()`;

const prePaintSnippet = `<head>
  <script data-key="puzzle:appearance" data-default-mode="dark">
    /* the whole of registry/theme/pre-paint.js, inlined here */
  <\/script>

  <link rel="stylesheet" href="/styles.css">
<\/head>`;

const scopeSnippet = `<div data-scheme="void" data-theme="light" class="bg-surface text-ink">
  <!-- this subtree renders Void / light, whatever the page around it is -->
<\/div>`;

const exportRows = [
	{ path: '@magic-spells/puzzle-pieces/themes/default.css', note: 'the default palette and the @theme block — always imported' },
	{ path: '@magic-spells/puzzle-pieces/themes/dim.css', note: 'Dim — blue-grey at half chroma, type a stop softer' },
	{ path: '@magic-spells/puzzle-pieces/themes/warm.css', note: 'Warm — ivory, tan and brown with a clay accent' },
	{ path: '@magic-spells/puzzle-pieces/themes/void.css', note: 'Void — monochrome, borderless, high contrast' },
	{ path: '@magic-spells/puzzle-pieces/appearance', note: 'the runtime: boot, set, current, subscribe' },
	{ path: '@magic-spells/puzzle-pieces/pre-paint', note: 'the anti-flash snippet, inlined in the shell head' },
];

const tokenRows = TOKEN_GROUPS.map((g) => ({
	id: g.id,
	title: g.title,
	count: `${g.tokens.length} token${g.tokens.length === 1 ? '' : 's'}`,
	description: g.description,
}));

const tokenLinks = [
	{ href: '#/themes/default', label: 'Default' },
	{ href: '#/themes/dim', label: 'Dim' },
	{ href: '#/themes/warm', label: 'Warm' },
	{ href: '#/themes/void', label: 'Void' },
	{ href: '#/themes/compare', label: 'Compare' },
	{ href: '#/themes/shell', label: 'Shell' },
	{ href: '#/themes/pieces', label: 'Pieces' },
];

const addSteps = [
	'Copy a scheme file in registry/theme/ to the new name and rename its selectors — the palette block and its medium block.',
	'Retune the values. Keep every token name; only values change.',
	'Add { name, file, label, description } to the themes array in registry/registry.json.',
	'Add the name to SCHEMES in registry/theme/appearance.js AND to SCHEMES in registry/theme/pre-paint.js — the two lists have to agree.',
	'Add it to demo/app/lib/tokenNames.js and to test/lib/parse-theme.mjs, so the demo and the tests can see it.',
];

export default class Theming extends PuzzleView {
	data(params, props) {
		return {
			htmlTag: '<html>',
			headTag: '<head>',
			storedShape: '{ scheme, mode }',
			setArg: '{ scheme, mode }',
			nameArg: '<name>',
			exportRows,
			tokenRows,
			tokenLinks,
			addSteps,
			mechanismSnippet,
			importSnippet,
			runtimeSnippet,
			prePaintSnippet,
			scopeSnippet,
			toc: [
				{ label: 'The model', href: '#model' },
				{ label: 'Install', href: '#install' },
				{ label: 'Switching at runtime', href: '#runtime' },
				{ label: 'Scoping a subtree', href: '#scoping' },
				{ label: 'Tokens', href: '#tokens' },
				{ label: 'Adding a palette', href: '#adding' },
				{ label: 'Contrast', href: '#contrast' },
			],
		};
	}
}
</script>
