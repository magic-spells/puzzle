<puzzle-view class="w-full">
  <!-- Toc-width right inset — see ComponentsIndex.pzl for why. -->
  <div class="xl:pr-60">
    <article class="mx-auto w-full max-w-5xl min-w-0">
      <header class="mb-8 max-w-3xl">
        <h1 class="text-3xl font-semibold tracking-tight text-ink">Demos</h1>
        <p class="mt-2 text-body">
