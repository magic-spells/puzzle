<puzzle-view class="flex h-dvh flex-col bg-surface-frame text-body">
  <!-- TOP BAR — the frame's horizontal arm. bg-bar equals surface-frame in every
       theme file, so the bar and the rail read as one flat L around the panel. -->
  <header class="grid h-12 shrink-0 grid-cols-[minmax(0,1fr)_minmax(0,36rem)_minmax(0,1fr)] items-center gap-3 bg-bar px-3 text-bar-ink">
    <!-- THREE COLUMNS, not a flex row with a `justify-between`. The wings are
         equal `1fr` tracks and the search sits in the `auto` one between them,
         which is what centres it on the WINDOW rather than on whatever is left
         over after the right cluster (the app template's TopBar grid). The
         centre track is `minmax(0,36rem)` rather than the template's `auto`
         because the trigger here is content-sized: on `auto` the pill collapses
         to 149px and reads as a chip instead of a field. It still shrinks. -->
    <div class="flex min-w-0 items-center gap-3">
      <button
        type="button"
        class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md text-bar-muted transition-colors hover:bg-bar-hover hover:text-bar-ink outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 lg:hidden"
        aria-label="Toggle navigation"
        aria-expanded={ mobileNavOpen ? 'true' : 'false' }
        @click={ toggleMobileNav }>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
      <a
        href="#/"
        class="flex items-center gap-2 rounded-md text-brand font-semibold tracking-tight text-bar-ink outline-ring focus-visible:outline-2 focus-visible:outline-offset-4">
        <span class="flex size-6 items-center justify-center rounded-md bg-brand text-xs font-bold text-brand-ink" aria-hidden="true">P</span>
        <span class="truncate">Puzzle Pieces</span>
      </a>
      <span class="hidden text-xs text-bar-muted md:inline">{ pieceCount } pieces · v{ version }</span>
    </div>
    <!-- THE SEARCH, centred on the window: the docs SearchDialog's trigger,
         dressed as the template's search field. The dialog still morphs out of
         it — the trigger is the morph source, whatever its box. -->
    <div class="flex min-w-0 items-center justify-center">
      <SearchDialog/>
    </div>

    <div class="flex min-w-0 items-center justify-end gap-2">
      <a
        href="https://github.com/magic-spells/puzzle-pieces"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub repository"
        class="inline-flex size-8 items-center justify-center rounded-md text-bar-muted transition-colors hover:bg-bar-hover hover:text-bar-ink outline-ring focus-visible:outline-2 focus-visible:outline-offset-2">
        <svg class="size-4.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
    </div>
  </header>

  <!-- MOBILE NAV — below lg the rail is a drawer under the bar, painted with the
       same rail roles; the switcher rides along so phones can pick a theme too. -->
  {#if mobileNavOpen}
    <div class="max-h-[70dvh] overflow-y-auto border-b border-rail-edge bg-rail px-3 pb-3 lg:hidden">
      <SideNav path={ path } class="py-2"/>
      <AppearanceSwitcher class="mt-2 border-t border-rail-edge pt-3"/>
    </div>
  {/if}

  <div class="flex min-h-0 flex-1">
    <!-- RAIL — the sidebar piece in its `rail` variant: the frame's vertical arm.
         Items come from the docs nav config; the footer holds the live
         scheme × mode switcher. -->
    <div class="hidden min-h-0 shrink-0 lg:flex">
      <!-- `collapsible={false}`: this rail is always open. The docs shell has one
           nav and no second pane to give room to, and the piece's icon-only mode
           hid the very labels the site is a list of. The Sidebar docs page still
           demonstrates collapsing — the prop defaults to true. -->
      <Sidebar variant="rail" collapsible={ false } items={ navItems } activePath={ activeHref } label="Docs">
        <div slot="footer">
          <AppearanceSwitcher/>
        </div>
      </Sidebar>
    </div>

    <!-- PANEL — the work surface set down inside the frame: one step lighter
         than the frame, a lip along its top edge (panel-edge: a hairline in
         light, a light lip in dark), and the panel shadow seating it. -->
    <main class="min-w-0 flex-1 overflow-y-auto border-t border-panel-edge bg-surface-panel shadow-panel lg:rounded-tl-xl lg:border-l">
      <div class="px-gutter py-10">
        <Slot/>

        <footer class="mt-16 border-t border-border pt-6 text-sm text-muted">
          Puzzle Pieces · { pieceCount } copy-in components, rendered live from the registry · built with the Puzzle framework.
        </footer>
      </div>
    </main>
  </div>

  <Toaster position="bottom-right"/>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Toaster from '../components/ui/Toaster.pzl';
import Sidebar from '../components/ui/Sidebar.pzl';
import SideNav from '../components/docs/SideNav.pzl';
import SearchDialog from '../components/docs/SearchDialog.pzl';
import AppearanceSwitcher from '../components/docs/AppearanceSwitcher.pzl';
import { GETTING_STARTED, SECTIONS, COMPONENTS, THEMES, SCHEME_PANELS, ICONS } from '../docs/nav.js';

// Docs shell — the frame / rail / panel composition every theme file is built
// around, made from the pieces themselves: a top bar (bg-bar), the Sidebar piece
// as the rail (variant="rail"), and the content as the panel (bg-surface-panel)
// with the AppearanceSwitcher in the rail's foot. Appearance state lives in
// app/lib/appearance.js (booted in app.js, pre-painted by the inline script in
// public/index.html); this layout never touches data-theme / data-scheme itself.
//
// Rail items: the Sidebar piece takes hrefs, and the demo is hash-routed, so
// every href is `#` + path and the active match is `#` + the current path.
// Shown in the bar; bump with package.json (the bundler has no JSON import).
const VERSION = '0.7.1';

const KEYS = { '/': 'introduction', '/components': 'components', '/theming': 'theming' };

const link = (item, icon) => ({ label: item.title, href: `#${item.path}`, icon });

const NAV_ITEMS = [
  ...GETTING_STARTED.map((item) => link(item, ICONS[KEYS[item.path]])),
  { group: 'Themes' },
  { label: 'Schemes', icon: ICONS.schemes, children: SCHEME_PANELS.map((s) => ({ label: s.title, href: `#${s.path}` })) },
  ...THEMES.map((item) => link(item, ICONS[item.title.toLowerCase()])),
  { group: 'Components' },
  ...SECTIONS.map((section) => ({
    label: section.label,
    icon: ICONS[section.label],
    badge: String(section.items.length),
    children: section.items.map((item) => ({ label: item.title, href: `#${item.path}` })),
  })),
];

export default class DefaultLayout extends PuzzleView {
  data(params, props) {
    // this.route is the per-navigation snapshot (D47), readable here in data();
    // fall back to the live router when it isn't set yet.
    const path =
      (this.route && this.route.path) ||
      (this.ctx && this.ctx.router && this.ctx.router.current && this.ctx.router.current.path) ||
      '/';
    const state = this.getData();
    return {
      path,
      activeHref: `#${path}`,
      navItems: NAV_ITEMS,
      pieceCount: COMPONENTS.length,
      version: VERSION,
      mobileNavOpen: !!state.mobileNavOpen,
    };
  }

  events = {
    toggleMobileNav: () => {
      this.setData({ mobileNavOpen: !this.getData().mobileNavOpen });
      this.refresh();
    },
  };
}
</script>
