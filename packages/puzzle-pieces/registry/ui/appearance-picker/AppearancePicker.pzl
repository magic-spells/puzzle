<puzzle-view>
  <div class={ rootClass }>
    <fieldset class="m-0 min-w-0 border-0 p-0">
      <legend class="mb-2 text-sm font-medium text-ink">{ schemeLegend }</legend>
      <div class="grid grid-cols-2 gap-3">
        {#for card in cards}
          <label key={ card.value } class={ card.cardClass } title={ card.description }>
            <input
              type="radio"
              name={ radioName }
              class="sr-only"
              value={ card.value }
              checked={ card.selected }
              @change={ pickScheme(card.value) } />
            <span class={ card.frameClass }>
              <!-- THE PREVIEW IS A REAL SURFACE, NOT A PICTURE. `data-scheme` is
                   scoped on this element, so every token inside resolves to THAT
                   palette in the CURRENT mode (inherited from the page): the
                   frame in an L, the rail on it, the panel set down inside with
                   cards on it. Nothing here knows a colour. -->
              <span data-scheme={ card.value } class="flex aspect-3/2 w-full flex-col bg-surface-frame p-1 text-body">
                <span class="flex h-2 shrink-0 items-center gap-0.5 px-1">
                  <span class="size-1 shrink-0 rounded-full bg-brand"></span>
                  <span class="ml-1 h-1 w-6 rounded-full bg-bar-hover"></span>
                  <span class="ml-auto h-1 w-3 rounded-full bg-bar-ink/40"></span>
                </span>
                <span class="flex min-h-0 flex-1 gap-1 pt-1">
                  <span class="flex w-1/3 shrink-0 flex-col gap-1 px-1 pb-1">
                    <span class="h-1.5 w-full rounded-sm bg-rail-active"></span>
                    <span class="h-1 w-4/5 rounded-full bg-rail-ink/30"></span>
                    <span class="h-1 w-3/5 rounded-full bg-rail-ink/30"></span>
                    <span class="mt-auto flex items-center gap-1">
                      <span class="size-2 shrink-0 rounded-full bg-rail-ink/45"></span>
                      <span class="h-1 flex-1 rounded-full bg-rail-ink/30"></span>
                    </span>
                  </span>
                  <span class="mr-1 mb-1 flex min-w-0 flex-1 flex-col gap-1 rounded-sm border border-x-border border-b-border border-t-panel-edge bg-surface-panel p-1.5 shadow-panel">
                    <span class="h-1.5 w-3/5 rounded-full bg-ink/80"></span>
                    <span class="h-1 w-4/5 rounded-full bg-muted/50"></span>
                    <span class="mt-auto flex gap-1">
                      <span class="h-4 flex-1 rounded-sm bg-brand"></span>
                      <span class="h-4 flex-1 rounded-sm border border-border bg-surface-card shadow-card"></span>
                      <span class="h-4 flex-1 rounded-sm border border-border bg-surface-card shadow-card"></span>
                    </span>
                  </span>
                </span>
              </span>
            </span>
            <span class="mt-2 block text-sm font-medium text-ink">{ card.label }</span>
            {#if card.description}
              <span class="block text-xs text-muted">{ card.description }</span>
            {/if}
          </label>
        {/for}
      </div>
    </fieldset>

    <fieldset class="m-0 mt-5 min-w-0 border-0 p-0">
      <legend class="mb-2 text-sm font-medium text-ink">{ modeLegend }</legend>
      <div
        class={ styleGridClass }
        role="radiogroup"
        aria-label={ modeLegend }
        @keydown={ moveMode(event) }>
        {#for opt in segments}
          <button
            key={ opt.key }
            type="button"
            role="radio"
            aria-checked={ opt.checked }
            tabindex={ opt.tabindex }
            data-mode-option={ opt.key }
            title={ opt.description }
            class={ opt.class }
            @click={ pickMode(opt.key) }>
            <span class={ opt.frameClass }>
              {#if opt.key === 'system'}
                <!-- A monitor: whatever the operating system says. -->
                <span class="flex aspect-4/3 w-full items-center justify-center bg-surface-sunken text-muted">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5">
                    <rect x="3" y="4" width="18" height="12" rx="2"/>
                    <path d="M8 20h8M12 16v4"/>
                  </svg>
                </span>
              {:else}
                <!-- THE SAME TRICK, ON THE OTHER AXIS. The tile names BOTH the
                     current palette and its own style, so the theme files paint
                     it as that palette in that style: the frame with its rail,
                     the panel set down inside it. -->
                <span data-scheme={ previewScheme } data-theme={ opt.key } class="flex aspect-4/3 w-full gap-0.5 bg-surface-frame p-0.5">
                  <span class="flex w-1/4 shrink-0 flex-col gap-0.5 p-0.5">
                    <span class="h-1 w-full rounded-sm bg-rail-active"></span>
                    <span class="h-0.5 w-4/5 rounded-full bg-rail-ink/40"></span>
                    <span class="h-0.5 w-3/5 rounded-full bg-rail-ink/40"></span>
                  </span>
                  <span class="flex min-w-0 flex-1 flex-col gap-0.5 rounded-sm border border-x-border border-b-border border-t-panel-edge bg-surface-panel p-1 shadow-panel">
                    <span class="h-1 w-3/5 rounded-full bg-ink/80"></span>
                    <span class="h-0.5 w-4/5 rounded-full bg-muted/50"></span>
                    <span class="mt-auto h-1.5 w-1/3 rounded-sm bg-brand"></span>
                  </span>
                </span>
              {/if}
            </span>
            <span class="mt-1.5 block truncate text-xs font-medium">{ opt.label }</span>
          </button>
        {/for}
      </div>
    </fieldset>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// AppearancePicker — the palette + style form: four (or however many) theme
// cards, each a live miniature of the app shell painted in the palette it
// offers, and a Dark / Dim / Mixed / Light style radiogroup — each style a live
// miniature too, painted in the current palette — with an optional "System"
// tile. Ported from Pyramid's AppearancePanel / Sites' Appearance
// dialog so every Puzzle app can copy ONE picker instead of keeping its own.
//
// THIS IS THE FORM, NOT THE POPOVER. It renders inline wherever you put it —
// a settings page, a popover parked in a corner, a menu panel — and it owns no
// appearance state: it is CONTROLLED. You pass the current `scheme` and `mode`
// and hear `@change` on every click; wiring it to storage is the caller's job.
// The pieces demo wires it to `@magic-spells/puzzle-pieces/appearance`
// (`set({ scheme, mode })`); Pyramid wires it to its preferences store, which
// also mirrors the choice to the account.
//
//   import { SCHEMES, MODES, current, set } from '@magic-spells/puzzle-pieces/appearance';
//   <AppearancePicker scheme={ scheme } mode={ mode } @change={ apply }/>
//   // apply: ({ scheme, mode }) => set({ scheme, mode })
//
// WHY THE CARDS ARE REAL SURFACES. `data-scheme` is scoped ON each card, so
// every token inside resolves to that palette straight out of the theme files,
// in whatever style the page is currently in (the card inherits `color-scheme`
// and `data-theme` from the page). Each style tile names both attributes — the
// current palette and its own style — so it shows THIS palette in THAT style.
// Change a value in cool.css and the Cool card changes with it; nothing in this
// file knows a hex. It is also why no palette or style block in the theme files
// may be anchored to `:root`.
//
// THE CARDS NEED THEIR PALETTES. Cool, Warm and Void paint only once their theme
// files are in the app — `puzzle add piece` prints `puzzle add theme cool warm void`.
//
// APPLIES ON THE CLICK, NO SAVE BUTTON. Both groups fire `@change` immediately —
// the whole point is watching the app repaint behind the picker.
//
// THE RADIOS ARE REAL INPUTS (sr-only inside their label), so the theme group
// keeps native radio semantics: one tab stop, arrow keys move between cards
// and apply as they land, Space/Enter select. The style group is a hand-rolled
// radiogroup with a roving tabindex; arrow keys move and apply.
//
// PROPS
//   scheme       string        the current palette value ('default' | 'cool' | …)
//   mode         string|null   the current style ('dark' | 'dim' | 'mixed' | 'light');
//                              null = follow the operating system. The prop keeps
//                              the name `mode` — `style` is the HTML attribute.
//   schemes      array         [{ value, label, description? }] — the cards. Defaults
//                              to the four bundled palettes (DEFAULT_SCHEMES below,
//                              kept equal to the `appearance` module's SCHEMES).
//   modes        array         [{ value, label, description? }] — the styles. Defaults
//                              to the four bundled styles, darkest first.
//   system       bool          show the "System" (follow OS) tile (default true).
//                              Selecting it fires @change with mode: null.
//   schemeLegend string        heading for the cards (default 'Theme')
//   modeLegend   string        heading for the styles (default 'Style')
//   class        string        appended to the root
//
// EVENTS (callback props, value-first)
//   @change({ scheme, mode })  every pick; the full choice, not just the axis that moved.
//                              CONTROLLED means the parent must feed the new value back
//                              in — arrow keys and clicks only visibly move once it does.

export const DEFAULT_SCHEMES = [
  { value: 'default', label: 'Default', description: 'Tasteful dark grey with a slight blue tint and an indigo accent.' },
  { value: 'cool', label: 'Cool', description: 'A little more blue — blue-black grounds and periwinkle type, a lit-blue accent.' },
  { value: 'warm', label: 'Warm', description: 'Browns and oranges — ivory and tan, brown-black, a clay accent.' },
  { value: 'void', label: 'Void', description: 'Very black, dark greys and white type — monochrome, high contrast.' },
];

export const DEFAULT_MODES = [
  { value: 'dark', label: 'Dark', description: 'Everything dark, the frame a step darker than the panel.' },
  { value: 'dim', label: 'Dim', description: 'Between light and dark — lower contrast, more subtle.' },
  { value: 'mixed', label: 'Mixed', description: 'The darker sidebar with a white main panel.' },
  { value: 'light', label: 'Light', description: 'Everything lit — a light-grey frame with a white panel on it.' },
];

const SYSTEM = { value: null, key: 'system', label: 'System', description: 'Follow the operating system between light and dark.' };

const CARD =
  'group block cursor-pointer select-none rounded-xl outline-ring ' +
  'has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2';
const FRAME =
  'block overflow-hidden rounded-lg border transition-transform duration-150 ' +
  'motion-safe:group-hover:-translate-y-0.5 motion-reduce:transition-none';
const FRAME_ON = 'border-brand ring-2 ring-brand';
const FRAME_OFF = 'border-border';
const TILE =
  'group block min-w-0 cursor-pointer select-none rounded-lg text-center transition-colors outline-ring ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2';
const TILE_ON = 'text-ink';
const TILE_OFF = 'text-muted hover:text-ink';
// Literal class strings, so Tailwind's scan sees both column counts.
const STYLE_GRID = { 4: 'grid grid-cols-4 gap-2', 5: 'grid grid-cols-5 gap-2' };

let uid = 0;

export default class AppearancePicker extends PuzzleView {
  // A radio group is scoped to the document, so two mounted pickers need
  // distinct names or they would steal each other's checked state.
  _radioName = `appearance-picker-${++uid}`;

  data(params, props) {
    const schemes = Array.isArray(props.schemes) && props.schemes.length ? props.schemes : DEFAULT_SCHEMES;
    const modes = Array.isArray(props.modes) && props.modes.length ? props.modes : DEFAULT_MODES;
    const system = props.system !== false;
    const { scheme, mode } = this._current();

    const options = [...modes.map((m) => ({ ...m, key: m.value })), ...(system ? [SYSTEM] : [])];
    const currentKey = mode === null ? 'system' : mode;

    return {
      rootClass: ['min-w-0', props.class || ''].join(' '),
      radioName: this._radioName,
      schemeLegend: props.schemeLegend || 'Theme',
      modeLegend: props.modeLegend || 'Style',
      // The style tiles paint the CURRENT palette in each style.
      previewScheme: scheme,
      styleGridClass: STYLE_GRID[options.length] || 'grid grid-cols-4 gap-2',
      cards: schemes.map((s) => {
        const selected = s.value === scheme;
        return {
          value: s.value,
          label: s.label || s.value,
          description: s.description || '',
          selected,
          cardClass: CARD,
          frameClass: [FRAME, selected ? FRAME_ON : FRAME_OFF].join(' '),
        };
      }),
      segments: options.map((o) => {
        const on = o.key === currentKey;
        return {
          key: o.key,
          label: o.label,
          description: o.description || '',
          checked: on ? 'true' : 'false',
          // Roving tabindex: one tab stop, landing on the current choice.
          tabindex: on ? '0' : '-1',
          class: [TILE, on ? TILE_ON : TILE_OFF].join(' '),
          frameClass: [FRAME, on ? FRAME_ON : FRAME_OFF].join(' '),
        };
      }),
    };
  }

  // The one resolution of "current choice" both data() and _emit() use, so a
  // caller passing only `mode` still hears the first card as its scheme.
  _current() {
    const props = this.props || {};
    const schemes = Array.isArray(props.schemes) && props.schemes.length ? props.schemes : DEFAULT_SCHEMES;
    return {
      scheme: props.scheme || schemes[0].value,
      mode: props.mode === undefined ? null : props.mode,
    };
  }

  _emit(patch) {
    const change = this.props && this.props.change;
    if (typeof change !== 'function') return;
    change({ ...this._current(), ...patch });
  }

  events = {
    pickScheme: (value) => this._emit({ scheme: value }),
    pickMode: (key) => this._emit({ mode: key === 'system' ? null : key }),

    moveMode: (event) => {
      const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'];
      if (!keys.includes(event.key)) return;
      const buttons = Array.from(event.currentTarget.querySelectorAll('[data-mode-option]'));
      if (!buttons.length) return;
      const at = buttons.findIndex((b) => b.getAttribute('aria-checked') === 'true');
      let next = at < 0 ? 0 : at;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (at + 1) % buttons.length;
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (at - 1 + buttons.length) % buttons.length;
      else if (event.key === 'Home') next = 0;
      else next = buttons.length - 1;
      event.preventDefault();
      const key = buttons[next].getAttribute('data-mode-option');
      this._emit({ mode: key === 'system' ? null : key });
      // Focus follows selection; the button re-renders with tabindex 0.
      requestAnimationFrame(() => {
        const el = this.element && this.element.querySelector(`[data-mode-option="${key}"]`);
        if (el) el.focus();
      });
    },
  };
}
</script>
