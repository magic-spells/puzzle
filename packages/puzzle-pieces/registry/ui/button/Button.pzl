<puzzle-view>
  <button
    class={ classes }
    type={ type }
    disabled={ disabled }
    aria-busy={ busy }
    @click={ handleClick }>
    {#if loading}
      <span class="inline-block size-4 animate-spin rounded-full border-2 border-current/30 border-t-current" aria-hidden="true"></span>
    {/if}
    <Slot/>
  </button>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// Button — the puzzle-pieces exemplar. Variants and sizes are plain lookup
// maps composed into one class string in data(); a `class` prop appends the
// caller's utilities. `loading` disables the button and prepends a
// currentColor spinner ring, so it reads correctly on every variant.
//
//   <Button @press={ save }>Save</Button>
//   <Button variant="destructive" size="sm" @press={ remove }>Delete</Button>
//   <Button variant="outline" loading={ saving }>Saving…</Button>
//
// A disabled button keeps the pointer (a not-allowed cursor, not
// pointer-events-none) so its `title` tooltip still shows; every hover is
// written `not-disabled:hover:` so it stays off. A disabled <button> fires no
// click, and the press handler re-checks as a backstop.
const BASE =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap select-none ' +
  'rounded-lg font-medium cursor-pointer transition-colors ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 outline-ring focus-visible:outline-ring ' +
  'disabled:opacity-50 disabled:cursor-not-allowed';

// Quiet by design (Cory, 2026-10-22: "the blue buttons really stand out and
// when there are a lot of buttons on the screen it's too much to look at").
// No brand fill: brand stays for focus rings, selection and links.
//   primary    solid ink, the page colour as its text — near-black on light,
//              white on dark — softening a step on hover.
//   secondary  an ink TINT, not a surface token: 6% ink reads as a small,
//              visible step off any ground (page, panel, raised card) in every
//              style, where surface-sunken nearly vanished in dark.
//   outline    transparent with a strong hairline, the same tint on hover, so
//              it sits on any ground too.
//   ghost      no chrome until hover, then the same tint.
// The tint is translucent, so on a frame drawn in bar-* colours (the mixed
// style's dark rail) it inherits the panel's ink, not the bar's — style
// buttons placed on the frame with bar-* utilities.
const VARIANT = {
  primary: 'bg-ink text-page not-disabled:hover:bg-ink/85',
  secondary: 'bg-ink/6 text-ink not-disabled:hover:bg-ink/10',
  outline: 'border border-border-strong text-ink not-disabled:hover:bg-ink/6',
  ghost: 'text-body not-disabled:hover:bg-ink/6 not-disabled:hover:text-ink',
  destructive: 'bg-danger-solid text-danger-solid-ink not-disabled:hover:bg-danger-solid-hover',
};

const SIZE = {
  sm: 'h-8 px-3 text-sm',
  md: 'h-9 px-4 text-sm',
  lg: 'h-10 px-5 text-base',
};

export default class Button extends PuzzleView {
  data(params, props) {
    const loading = !!props.loading;
    return {
      classes: [
        BASE,
        VARIANT[props.variant] || VARIANT.primary,
        SIZE[props.size] || SIZE.md,
        props.class || '',
      ].join(' '),
      type: props.type || 'button',
      disabled: !!props.disabled || loading,
      busy: loading ? 'true' : false,
      loading,
    };
  }

  events = {
    handleClick: (event) => {
      if (this.getData().disabled) return;
      const { press } = this.props;
      if (typeof press === 'function') press(event);
    },
  };
}
</script>
