<puzzle-view>
  <div class={ rootClass }>
    <div island ref="host"></div>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import { RICH_TEXT_CLASSES as C, richTextClasses, isEmpty, safeLinkUrl, safePreviewUrl } from '../../lib/rich-text-doc.js';

// RichText — renders a stored rich text document (the RichTextEditor's
// Shopify-style JSON tree, see lib/rich-text-doc.js for the format) as
// semantic HTML. Zero npm dependencies: a document.createElement tree-walker
// building text via createTextNode, so stored content can never inject markup.
// Typography comes from the shared RICH_TEXT_CLASSES map — the same classes
// the editor applies — so what was edited is what renders.
// Re-render checks are by value (a JSON key), but prop delivery is by identity:
// pass a NEW doc object on change; mutating one in place will not re-render.
//
//   <RichText doc={ article.body } />
//   <RichText doc={ doc } class="max-w-prose" />
//
// Props:
//   doc    the document tree ({ type:'root', children:[…] }); null/empty
//          renders nothing
//   class  appended to the root
//   compact  tighter block spacing (lines ~4px apart, Notion-style) — the
//          spacing RichTextEditor uses in chrome="blocks", so a note reads the
//          same in both
//   resolveImage(ref, node) → url | null
//          the ONLY source of an image's src: called with an image's `ref`
//          (node = the image node) and a link preview's `imageRef` (node =
//          the link-preview node). The doc never carries a URL. Without it,
//          or on null, an image renders as a placeholder box holding its alt
//          text and a preview renders without its picture. Sources are
//          re-resolved on every render even when the doc is unchanged, so
//          pass a NEW function when the URLs behind your refs change.
// Callbacks:
//   @imageError(ref)  an image failed to load (an expired signed URL, say)
//
// Images render as <figure><img><figcaption>, width/height reserving the box;
// link previews as one card link through safePreviewUrl, target="_blank"
// rel="noopener noreferrer". Both are honored at the top level only, as the
// format defines. All of their text (alt, caption, title, description, site
// name) is set as text, never parsed as markup.
//
// The walk happens in mounted()/afterUpdate() inside an `island` (built DOM
// lives outside the vdom), which means content renders CLIENT-SIDE ONLY —
// prerendered (static/hybrid) pages show it after takeover, not in the baked
// markup. Link safety: javascript: URLs are neutralized; target="_blank"
// links get rel="noopener noreferrer".

function textWithBreaks(value) {
	const frag = document.createDocumentFragment();
	String(value ?? '')
		.split('\n')
		.forEach((part, i) => {
			if (i > 0) frag.appendChild(document.createElement('br'));
			if (part) frag.appendChild(document.createTextNode(part));
		});
	return frag;
}

function wrap(tag, child) {
	const el = document.createElement(tag);
	el.appendChild(child);
	return el;
}

function textDom(t) {
	let node = textWithBreaks(t.value);
	if (t.bold) node = wrap('strong', node);
	if (t.italic) node = wrap('em', node);
	if (t.underline) node = wrap('u', node);
	if (t.strike) node = wrap('s', node);
	return node;
}

function inlineDom(nodes) {
	const frag = document.createDocumentFragment();
	for (const n of nodes || []) {
		if (n.type === 'text') {
			frag.appendChild(textDom(n));
		} else if (n.type === 'link') {
			const a = document.createElement('a');
			// Stored link URLs are untrusted; safeLinkUrl is the same policy the
			// editor enforces through Tiptap (see lib/rich-text-doc.js).
			a.href = safeLinkUrl(n.url) ?? '#';
			if (n.title) a.title = n.title;
			if (n.target) {
				a.target = n.target;
				a.rel = 'noopener noreferrer';
			}
			a.className = C.link;
			a.appendChild(inlineDom(n.children));
			frag.appendChild(a);
		}
	}
	return frag;
}

// Inline text-align is deliberate — the sanctioned bend of the Tailwind-only
// rule. Tiptap's TextAlign extension emits exactly this inline style, so
// matching it keeps the editor and the renderer pixel-identical.
function alignStyle(el, node) {
	if (node.align === 'center' || node.align === 'right') {
		el.style.textAlign = node.align;
	}
}

// The image's media: an <img> when the host resolved a src, else a
// placeholder box holding the alt text (sized from width/height when known).
function imageMedia(url, node, ctx) {
	if (url) {
		const img = document.createElement('img');
		img.className = ctx.C.image;
		img.src = url;
		img.alt = node.alt || '';
		img.loading = 'lazy';
		img.decoding = 'async';
		if (node.width > 0) img.width = node.width;
		if (node.height > 0) img.height = node.height;
		img.addEventListener('error', () => ctx.onError(node.ref));
		return img;
	}
	const box = document.createElement('div');
	box.className = ctx.C.imagePlaceholder;
	box.textContent = node.alt || 'Image unavailable';
	if (node.width > 0 && node.height > 0) box.style.aspectRatio = `${node.width} / ${node.height}`;
	return box;
}

function imageDom(node, ctx) {
	const figure = document.createElement('figure');
	figure.className = ctx.C.figure;
	const media = document.createElement('div');
	figure.appendChild(media);
	// Registered, not filled: _syncImages resolves the src now and on every
	// later render, swapping only what changed.
	ctx.images.push({
		ref: node.ref,
		node,
		url: undefined,
		apply: (url) => {
			media.textContent = '';
			media.appendChild(imageMedia(url, node, ctx));
		},
	});
	if (node.caption) {
		const cap = document.createElement('figcaption');
		cap.className = ctx.C.caption;
		cap.textContent = node.caption;
		figure.appendChild(cap);
	}
	return figure;
}

function previewDom(node, ctx) {
	const href = safePreviewUrl(node.url);
	const card = document.createElement(href ? 'a' : 'div');
	card.className = ctx.C.preview;
	if (href) {
		card.href = href;
		card.target = '_blank';
		card.rel = 'noopener noreferrer';
	}
	let hostname = '';
	try {
		hostname = new URL(node.url).hostname;
	} catch {
		hostname = '';
	}
	const body = document.createElement('div');
	body.className = ctx.C.previewBody;
	const line = (cls, text) => {
		const d = document.createElement('div');
		d.className = cls;
		d.textContent = text;
		body.appendChild(d);
	};
	line(ctx.C.previewSite, node.siteName || hostname);
	line(ctx.C.previewTitle, node.title || node.url || '');
	if (node.description) line(ctx.C.previewDescription, node.description);
	card.appendChild(body);
	if (node.imageRef) {
		let img = null;
		ctx.images.push({
			ref: node.imageRef,
			node,
			url: undefined,
			apply: (url) => {
				img?.remove();
				img = null;
				if (!url) return;
				img = document.createElement('img');
				img.className = ctx.C.previewImage;
				img.src = url;
				img.alt = '';
				img.loading = 'lazy';
				img.decoding = 'async';
				img.addEventListener('error', () => ctx.onError(node.imageRef));
				card.appendChild(img);
			},
		});
	}
	return card;
}

function blockDom(node, ctx, atRoot = false) {
	switch (node.type) {
		case 'image':
			return atRoot ? imageDom(node, ctx) : document.createDocumentFragment();
		case 'link-preview':
			return atRoot ? previewDom(node, ctx) : document.createDocumentFragment();
		case 'paragraph': {
			const p = document.createElement('p');
			p.className = ctx.C.paragraph;
			alignStyle(p, node);
			const inline = inlineDom(node.children);
			// ProseMirror keeps empty paragraphs open with a <br>; match it so
			// blank lines survive the round trip visually.
			p.appendChild(inline.childNodes.length ? inline : document.createElement('br'));
			return p;
		}
		case 'heading': {
			const level = Math.min(6, Math.max(1, Math.round(node.level) || 2));
			const h = document.createElement(`h${level}`);
			// The block-style dropdown produces levels 1-4; anything deeper reuses
			// the h4 treatment rather than inventing unstyled sizes.
			h.className =
				level === 1
					? C.heading1
					: level === 2
						? C.heading2
						: level === 3
							? C.heading3
							: C.heading4;
			alignStyle(h, node);
			h.appendChild(inlineDom(node.children));
			return h;
		}
		case 'list': {
			const list = document.createElement(node.listType === 'ordered' ? 'ol' : 'ul');
			list.className = `${ctx.C.list} ${node.listType === 'ordered' ? ctx.C.orderedList : ctx.C.bulletList}`;
			for (const item of node.children || []) {
				const li = document.createElement('li');
				li.className = ctx.C.listItem;
				// A list-item mixes inline content and nested lists; preserve their order.
				let inlineNodes = [];
				for (const child of item.children || []) {
					if (child.type === 'list') {
						if (inlineNodes.length) li.appendChild(inlineDom(inlineNodes));
						li.appendChild(blockDom(child, ctx));
						inlineNodes = [];
					} else {
						inlineNodes.push(child);
					}
				}
				if (inlineNodes.length) li.appendChild(inlineDom(inlineNodes));
				list.appendChild(li);
			}
			return list;
		}
		case 'blockquote': {
			const bq = document.createElement('blockquote');
			bq.className = ctx.C.blockquote;
			for (const child of node.children || []) bq.appendChild(blockDom(child, ctx));
			return bq;
		}
		case 'code-block': {
			const pre = document.createElement('pre');
			pre.className = ctx.C.codeBlock;
			const code = document.createElement('code');
			code.textContent = (node.children || []).map((t) => t.value || '').join('');
			pre.appendChild(code);
			return pre;
		}
		default: {
			// Unknown block types render nothing rather than guessing.
			return document.createDocumentFragment();
		}
	}
}

export default class RichText extends PuzzleView {
	data(params, props) {
		return {
			rootClass: props.class || '',
		};
	}

	_resolve(ref, node) {
		const fn = this.props.resolveImage;
		if (typeof fn !== 'function' || !ref) return null;
		try {
			const url = fn(ref, node);
			return typeof url === 'string' && url !== '' ? url : null;
		} catch {
			return null;
		}
	}

	_ctx() {
		return {
			C: richTextClasses(!!this.props.compact),
			images: [],
			onError: (ref) => {
				const { imageError } = this.props;
				if (typeof imageError === 'function') imageError(ref);
			},
		};
	}

	// Image sources come from resolveImage, which can change while the doc
	// does not — so every render re-resolves and swaps only what changed.
	_syncImages() {
		for (const entry of this._images || []) {
			const url = this._resolve(entry.ref, entry.node);
			if (url === entry.url) continue;
			entry.url = url;
			entry.apply(url);
		}
	}

	_render() {
		const host = this.refs.host;
		if (!host) return;
		const doc = this.props.doc;
		const key = `${this.props.compact ? 'c' : ''}${JSON.stringify(doc ?? null)}`;
		if (key === this._renderedKey) {
			this._syncImages();
			return;
		}
		host.textContent = '';
		this._images = [];
		if (isEmpty(doc)) {
			this._renderedKey = key;
			return;
		}
		const ctx = this._ctx();
		const frag = document.createDocumentFragment();
		for (const block of doc.children) frag.appendChild(blockDom(block, ctx, true));
		host.appendChild(frag);
		this._renderedKey = key;
		this._images = ctx.images;
		this._syncImages();
	}

	mounted() {
		this._render();
	}

	afterUpdate() {
		this._render();
	}
}
</script>
