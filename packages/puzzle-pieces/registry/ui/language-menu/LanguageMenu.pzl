<puzzle-view>
  <DropdownMenu class={ rootClass }>
    <DropdownMenu.Trigger>
      <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20" />
      </svg>
      <span class="sr-only">{ labelPrefix }</span>
      <span lang={ activeLocale }>{ activeLabel }</span>
      <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </DropdownMenu.Trigger>
    <DropdownMenu.Content align={ align }>
      {#if routed}
        {#for option in options}
          <a
            key={ option.locale }
            href={ option.href }
            hreflang={ option.locale }
            lang={ option.locale }
            class={ option.rowClass }
            aria-current={ option.current }
            @click={ follow(event, option.locale) }>
            { option.label }
            {#if option.current}
              <svg class="ml-auto size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {/if}
          </a>
        {/for}
      {:else}
        {#for option in options}
          <button
            type="button"
            key={ option.locale }
            lang={ option.locale }
            class={ option.rowClass }
            aria-current={ option.current }
            @click={ pick(option.locale) }>
            { option.label }
            {#if option.current}
              <svg class="ml-auto size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {/if}
          </button>
        {/for}
      {/if}
    </DropdownMenu.Content>
  </DropdownMenu>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import DropdownMenu from './DropdownMenu/index.js';

// LanguageMenu — the compact form of LanguageSwitcher: a menu button showing
// the active language, dropping one row per configured locale. Same input,
// same props, same click handling; it composes the DropdownMenu family, whose
// @magic-spells/dropdown-panel web component owns the menu.
//
//   <LanguageMenu locales={ locales } align="end"/>
//
// THE LIST IS A PROP — PASS IT FROM THE LAYOUT OR VIEW. `i18n.locales` (D177)
// describes the page being shown, and inside a persistent layout only the
// layout's own data() re-runs for each navigation; a component that read
// `this.ctx.i18n.locales` itself would keep the first page's hrefs. So:
//
//   data() {
//     return { locales: this.ctx.i18n.locales };
//   }
//
// LINKS OR BUTTONS — DECIDED FROM THE LIST. Under `i18n.routing: 'prefix'`
// each entry's `href` is distinct, so every row is a real link (`href`,
// `hreflang`, `lang`, `aria-current="true"` on the active one): a modified or
// middle click, a new tab and copy-link-address work natively, and menu mode
// makes Enter and Space follow it. A PLAIN click (Enter and Space included —
// they click the row) prevents the default and calls
// `ctx.i18n.setLocale(locale)`, which stores the choice and loads the same page
// under the other prefix. With no `ctx.i18n` nothing is prevented. Without
// prefix routing every entry carries the same `href` (the current page, or
// ''), so the rows are <button>s that call `setLocale`.
//
// `@change(locale)` is a pure HOOK fired on a plain click before `setLocale`; it
// never changes what the click does.
//
// ACCESSIBILITY. Menu mode OWNS role="menu", role="menuitem" on the rows, the
// roving tabindex, the arrow keys, typeahead and Escape — so NO role or
// tabindex is authored here. The trigger reads "Language: English": an sr-only
// `label` prefix before the active language's name, which carries its own
// `lang`.
//
// Props
//   locales  the parent's `this.ctx.i18n.locales`: [{ locale, label, href, active }]
//   label    the trigger's accessible prefix (default 'Language')
//   align    'start' (default) | 'end', for a menu near the right edge
//   class    merged onto the DropdownMenu host
// Callbacks
//   @change(locale)  a plain click chose `locale` — a hook, fired before setLocale
//
// STYLESHEET. Through DropdownMenu this piece needs the dropdown-panel CSS in
// your app's style entry:
//   @import "@magic-spells/dropdown-panel/css" layer(components);

// Menu rows: DropdownMenu.Link's box, with the check pushed to the trailing edge.
const ROW =
  'flex w-full items-center gap-6 rounded-md px-2.5 py-1.5 text-sm cursor-pointer ' +
  'no-underline transition-colors hover:bg-surface-sunken hover:text-ink ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 outline-ring focus-visible:outline-ring';
const ROW_OFF = 'text-body';
const ROW_ON = 'font-medium text-ink';

// Real links only when every entry has its own URL — prefix routing. Without
// it the runtime hands every entry the current page (or '').
const hasOwnUrls = (list) => {
  const hrefs = list.map((entry) => entry.href);
  return (
    hrefs.length > 0 &&
    hrefs.every((href) => typeof href === 'string' && href !== '') &&
    new Set(hrefs).size === hrefs.length
  );
};

export default class LanguageMenu extends PuzzleView {
  data(params, props) {
    const list = (Array.isArray(props.locales) ? props.locales : []).filter(
      (entry) => entry && entry.locale != null
    );
    const options = list.map((entry) => ({
      locale: String(entry.locale),
      label: entry.label != null ? String(entry.label) : String(entry.locale),
      href: entry.href,
      // the string form; false omits the attribute
      current: entry.active ? 'true' : false,
      rowClass: [ROW, entry.active ? ROW_ON : ROW_OFF].join(' '),
    }));
    const active = options.find((option) => option.current) ?? options[0];
    const label = props.label != null ? String(props.label) : 'Language';

    return {
      options,
      routed: hasOwnUrls(list),
      labelPrefix: label + ': ',
      activeLocale: active ? active.locale : false,
      activeLabel: active ? active.label : '',
      align: props.align === 'end' ? 'end' : 'start',
      rootClass: props.class || false,
    };
  }

  events = {
    // A link row. A modified or middle click is the browser's; a plain one
    // stores the choice through setLocale, which loads the same page under the
    // other prefix.
    follow: (event, tag) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      this.props.change?.(tag);
      const i18n = this.ctx?.i18n;
      if (!i18n) return;
      event.preventDefault();
      i18n.setLocale(tag);
    },

    // A button row (no prefix routing): nothing native to defer to.
    pick: (tag) => {
      this.props.change?.(tag);
      this.ctx?.i18n?.setLocale(tag);
    },
  };
}
</script>
