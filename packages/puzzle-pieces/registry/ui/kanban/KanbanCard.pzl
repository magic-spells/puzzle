<puzzle-view>
  <div class="contents">
    <div class="flex items-start justify-between gap-2">
      <p class="text-sm font-medium text-ink">{ title }</p>
      {#if badge}
        <span class={ badgeClass }>{ badge }</span>
      {/if}
    </div>
    {#if meta}
      <p class="mt-1 text-xs text-muted">{ meta }</p>
    {/if}
    {#if assignee}
      <div class="mt-2 flex items-center gap-1.5">
        <span class="inline-flex size-5 items-center justify-center rounded-full text-[10px] font-medium text-white" style={ avatarStyle }>{ initials }</span>
        <span class="text-xs text-muted">{ assignee }</span>
      </div>
    {/if}
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// KanbanCard — the stock content of a Kanban card: title, badge, meta line and
// assignee disc. Presentational only. Kanban owns the card surface (role,
// focus, drag handlers, ghost chrome) and mounts this inside its `card` marker
// FALLBACK, so a caller's <Snippet fits="card" ...> replaces just this content.
// The root is `display: contents`, so the rows sit directly in Kanban's surface.
//
// Props
//   card   the raw card object: { id, title, badge, badgeVariant, meta, assignee }.

const BADGE_BASE =
  'inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap';
const BADGE_VARIANT = {
  default: 'bg-surface-sunken text-body',
  brand: 'bg-brand-tint text-brand',
  danger: 'bg-danger-tint text-danger',
  outline: 'border border-border bg-transparent text-body',
};

// First letters of the first and last words, uppercased; a single word gives its
// first two letters (ported from Avatar / pyramid's format.js).
function initials(label) {
  const parts = String(label || '').trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return '?';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function avatarStyle(name) {
  const hue = [...String(name)].reduce((s, ch) => s + ch.charCodeAt(0), 0) % 360;
  return `background:hsl(${hue} 45% 32%)`;
}

export default class KanbanCard extends PuzzleView {
  data(params, props) {
    const card = props.card || {};
    const assignee = card.assignee || '';
    return {
      title: card.title || '',
      badge: card.badge || '',
      badgeClass: `${BADGE_BASE} ${BADGE_VARIANT[card.badgeVariant] || BADGE_VARIANT.default}`,
      meta: card.meta || '',
      assignee,
      initials: assignee ? initials(assignee) : '',
      avatarStyle: assignee ? avatarStyle(assignee) : '',
    };
  }
}
</script>
