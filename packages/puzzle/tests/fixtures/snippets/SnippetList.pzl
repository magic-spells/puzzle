<puzzle-view>
<section class="snippet-list">
  <h2 class="snippet-heading">
    <Slot name="heading" group={ group }>Fallback heading</Slot>
  </h2>

  <ul>
    {#for user in users}
      <li key={ user.id }>
        <Slot name="row" user={ user } group={ group }>{ user.name }</Slot>
      </li>
    {/for}
  </ul>

  <p class="snippet-default">
    <Children group={ group }>Fallback default</Children>
  </p>

  <button class="component-update" @click={ renameFirst }>Update inside component</button>
</section>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

export default class SnippetList extends PuzzleView {
  data(params, props) {
    return { users: props.users, group: props.group };
  }

  events = {
    renameFirst: () => {
      const users = this.getData().users.map((user, index) => (
        index === 0 ? { ...user, name: `${user.name}!` } : user
      ));
      this.setData('users', users);
    },
  };
}
</script>
