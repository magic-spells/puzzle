<puzzle-view>
  <div class="inline-flex items-center gap-4 rounded-xl border border-gray-200 dark:border-gray-800 px-5 py-4">
    <button
      class="h-9 w-9 rounded-lg border border-gray-300 dark:border-gray-700 text-lg leading-none hover:bg-surface dark:hover:bg-gray-800 transition-colors"
      @click={ decrement }
      aria-label="Decrease">
      −
    </button>

    <div class="text-center min-w-[4rem]">
      <div class="font-mono text-2xl tabular-nums">{ count }</div>
      <div class="text-[11px] uppercase tracking-widest text-gray-500">{ label }</div>
    </div>

    <button
      class="h-9 w-9 rounded-lg bg-accent text-white text-lg leading-none hover:bg-accent-2 transition-colors"
      @click={ increment }
      aria-label="Increase">
      +
    </button>
  </div>
</puzzle-view>

<script lang="ts">
import { PuzzleView } from '@magic-spells/puzzle';

interface CounterProps {
  label?: string;
}

// Local UI state, owned by this component through setData().
interface CounterState {
  count: number;
}

// What data() hands the template.
interface CounterModel {
  count: number;
  label: string;
}

export default class Counter extends PuzzleView {
  // Local UI state — seeded once before the first data() run.
  created(): void {
    this.setData({ count: 0 });
  }

  data(_params: Record<string, string>, props: CounterProps): CounterModel {
    const { count = 0 } = this.getData<Partial<CounterState>>();
    return {
      count,
      label: props.label || 'Count',
    };
  }

  // Event handlers are a class field of arrow functions so `this` is always the
  // component instance. Method shorthand (increment() {}) gets the events object
  // as `this` instead, so it breaks as soon as it touches `this`.
  events = {
    increment: (): void => {
      this.setData('count', this.getData<CounterState>().count + 1);
    },
    decrement: (): void => {
      this.setData('count', this.getData<CounterState>().count - 1);
    },
  };
}
</script>
