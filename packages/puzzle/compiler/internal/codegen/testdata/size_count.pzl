<puzzle-view class="counts">
  <h2 title="{ items.size } items" data-count={ items.size }>{ items.size }</h2>
  <p>{ user.name.size } { list[0].size } { a?.b.size } { tags.size - 1 } { file.size.label }</p>
  {#if items.size > 0}
    <ul>
      {#for todo in todos}
        <li key={ todo.id } @click={ pick(todo.tags.size) }>{ todo.tags.size } { todo.size }</li>
      {/for}
    </ul>
  {/if}
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

export default class SizeCount extends PuzzleView {
  data() {
    return { items: [], user: { name: '' }, list: [], a: null, tags: [], file: null, todos: [] };
  }

  events = {
    pick: () => {},
  };
}
</script>
