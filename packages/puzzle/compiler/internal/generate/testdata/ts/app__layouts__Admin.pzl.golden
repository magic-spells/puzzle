<puzzle-view class="Admin">
  <header>
    <h1>{ title }</h1>
  </header>

  <main>
    <Outlet/>
  </main>
</puzzle-view>

<script lang="ts">
import { PuzzleView, type DataInput } from '@magic-spells/puzzle';

interface AdminProps {
  title?: string;
}

// What data() hands the template.
interface AdminModel {
  title: string;
}

export default class Admin extends PuzzleView<AdminProps> {
  data({ props }: DataInput<AdminProps>): AdminModel {
    return {
      title: props.title || 'Admin',
    };
  }
}
</script>

<style>
.Admin {
  display: block;
}
</style>
