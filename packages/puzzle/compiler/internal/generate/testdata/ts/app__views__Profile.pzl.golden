<puzzle-view class="Profile">
  <h1>{ title }</h1>
  <p>{ message }</p>
</puzzle-view>

<script lang="ts">
import { PuzzleView } from '@magic-spells/puzzle';

// What data() hands the template — every key the markup above reads.
interface ProfileModel {
  title: string;
  message: string;
}

export default class Profile extends PuzzleView {
  data(): ProfileModel {
    return {
      title: 'Profile',
      message: 'This view was scaffolded by puzzle generate.',
    };
  }
}
</script>

<style>
.Profile {
  display: block;
}
</style>
