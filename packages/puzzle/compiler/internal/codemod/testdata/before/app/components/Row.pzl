<puzzle-view>
  <li>{#for item in items}<Slot item={ item }/>{/for}</li>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import fns from '../formatters';

export default class Row extends PuzzleView {
  data(_params, props = {}) {
    return { items: props.items ?? [], title: fns.shout('rows') };
  }
}
</script>
