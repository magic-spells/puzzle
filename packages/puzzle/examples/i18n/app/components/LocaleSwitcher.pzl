<puzzle-view>
  <div class="flex items-center gap-2 text-sm">
    <span class="text-muted">{ t('language') }</span>
    {#for option in options}
      <button
        key={ option.locale }
        class="px-2.5 py-1 rounded-md border {#if option.active}border-brand bg-brand-tint text-brand{:else}border-line hover:bg-page{/if}"
        aria-pressed="{ option.active }"
        @click={ choose(option.locale) }
      >{ option.label }</button>
    {/for}
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

export default class LocaleSwitcher extends PuzzleView {
  data() {
    // One entry per configured locale: its tag, its own name (`Español`), the
    // current page in that locale, and whether it is the active one.
    return { options: this.ctx.i18n.locales };
  }

  events = {
    // setLocale fetches the new table first, then rebuilds the page at the same
    // location — no history entry, no scroll jump — and remembers the choice.
    // It rejects when the new file fails to load (nothing changes) or the page
    // could not be rebuilt (the error already went to onError).
    choose: (tag) => {
      this.ctx.i18n.setLocale(tag).catch((err) => {
        console.error(err);
      });
    },
  };
}
</script>
