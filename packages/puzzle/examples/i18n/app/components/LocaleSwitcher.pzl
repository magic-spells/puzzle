<puzzle-view>
  <div class="flex items-center gap-2 text-sm">
    <span class="text-muted">{ 'language' | t }</span>
    {#for option in options}
      <button
        key={ option.tag }
        class="px-2.5 py-1 rounded-md border {#if option.tag === current}border-brand bg-brand-tint text-brand{:else}border-line hover:bg-page{/if}"
        aria-pressed="{ option.tag === current }"
        @click={ choose(option.tag) }
      >{ option.name }</button>
    {/for}
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// Each language names itself, so these stay untranslated.
const NAMES = { en: 'English', es: 'Español', pl: 'Polski' };

export default class LocaleSwitcher extends PuzzleView {
  data() {
    const { i18n } = this.ctx;
    return {
      current: i18n.locale,
      options: i18n.locales.map((tag) => ({ tag, name: NAMES[tag] ?? tag })),
    };
  }

  events = {
    // setLocale fetches the new table first, then rebuilds the page at the same
    // location — no history entry, no scroll jump — and remembers the choice.
    choose: (tag) => {
      this.ctx.i18n.setLocale(tag);
    },
  };
}
</script>
