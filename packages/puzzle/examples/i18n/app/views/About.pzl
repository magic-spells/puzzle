<puzzle-view class="space-y-4">
  <h1 class="text-3xl font-semibold">{ 'about.title' | t }</h1>
  <p class="text-muted leading-relaxed">{ 'about.body' | t }</p>
  <p class="text-sm text-muted">{ locale }</p>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// Script code reads the same service: this.ctx.i18n.t(key, vars) is exactly
// what the `t` formatter calls, and .locale is the active tag.
export default class About extends PuzzleView {
  data() {
    return { locale: `${this.ctx.i18n.locale} · ${this.ctx.i18n.t('nav.about')}` };
  }
}
</script>
