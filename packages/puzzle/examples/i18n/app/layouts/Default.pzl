    <div class="max-w-2xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
      <a href="{ '/' | link }" class="font-semibold text-lg">{ 'brand' | t }</a>
      <nav class="flex items-center gap-4 text-sm text-muted">
        <a href="{ '/' | link }" class="hover:text-ink">{ 'nav.home' | t }</a>
