<puzzle-view class="min-h-screen bg-page text-ink">
  <header class="border-b border-line bg-surface">
    <div class="max-w-2xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
      <a href="{ link('/') }" class="font-semibold text-lg">{ t('brand') }</a>
      <nav class="flex items-center gap-4 text-sm text-muted">
        <a href="{ link('/') }" class="hover:text-ink">{ t('nav.home') }</a>
        <a href="{ link('/about') }" class="hover:text-ink">{ t('nav.about') }</a>
      </nav>
      <LocaleSwitcher options={ locales } />
    </div>
  </header>
  <main class="max-w-2xl mx-auto px-6 py-12">
    <Slot />
  </main>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import LocaleSwitcher from '../components/LocaleSwitcher.pzl';

// Chrome. Its strings come through `t` and its links through `link()`, so every
// locale's pages render it in their own language under their own prefix.
export default class DefaultLayout extends PuzzleView {
  // i18n.locales names the page being shown, so it is read here: the layout's
  // data() re-runs for every navigation's destination, while a component inside
  // it (the switcher) keeps its own data() from the first page. The switcher
  // gets the fresh list as a prop.
  data() {
    return { locales: this.ctx.i18n.locales };
  }
}
</script>
