<puzzle-view>
  <section class="max-w-2xl prose-doc">
    <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent">Principle { id }</p>
    {#if principle}
      <h1 class="font-display text-4xl md:text-5xl text-ink">{ principle.title }</h1>
      <p>{ principle.body }</p>
    {:else}
      <h1 class="font-display text-4xl md:text-5xl text-ink">No such principle</h1>
    {/if}
    <p>
      This page was generated by the route's <code>staticPaths: 'principle'</code> —
      one page per record of the <code>principle</code> model, its <code>:id</code>
      taken from the record's <code>id</code> field.
      <a href="{ link('/about') }" class="text-accent underline underline-offset-2 hover:text-accent-2">All principles</a>
    </p>
  </section>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// The view of the parameterised '/principles/:id' route (D179). The build renders
// it once per `staticPaths` entry with that entry's params, and the page's own
// module hands the browser the same `this.params`, so data() reads the same
// record from the rehydrated store on both sides.
export default class PrincipleView extends PuzzleView {
  data() {
    return {
      id: this.params.id,
      principle: this.ctx.store.findOne('principle', this.params.id),
    };
  }
}
</script>
