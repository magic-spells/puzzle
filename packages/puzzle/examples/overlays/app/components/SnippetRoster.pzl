<puzzle-view>
  <div class="snippet-roster">
    <header class="snippet-roster-head">
      <Slot name="heading" total={ members.length }>Team</Slot>
    </header>
    <ol class="snippet-roster-list">
      {#for member in members, index}
        <li key={ member.id }>
          <Children member={ member } index={ index }>{ member.name }</Children>
        </li>
      {/for}
    </ol>
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

export default class SnippetRoster extends PuzzleView {
  data(params, props) {
    return { members: props.members || [] };
  }
}
</script>

