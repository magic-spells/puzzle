<puzzle-view>
  <!-- 0.7.0 template grammar: D167 dotted family tags + the \{ \} brace escape. -->
  <Frame class="note">
    <Frame.Header>{ title | capitalize }</Frame.Header>
    <Frame.Body>
      A literal \{ stays a brace \}, and \{{ count }\} wraps an interpolation in
      real braces.
    </Frame.Body>
    <Frame.Footer/>
  </Frame>

  <ul>
    {#for 1...5, i}
      <li data-i={ i }>row { i }</li>
    {/for}
  </ul>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Frame from './Frame/index.js';

export default class GrammarSpecimen extends PuzzleView {
	data() {
		return { title: 'families', count: 2 };
	}
}
</script>

<style scoped>
.note {
  color: red;
}
</style>
