<puzzle-view>
  <!-- 0.8.0 template values (D173, D174, D176): formatter chains in every value
       position, object-literal formatter arguments, .size and ??. -->
  <Frame.Wrapper title={ name | trim | truncate(20) } class="card { tone ?? 'plain' }">
    <Badge label={ followers | compact_number } count={ items.size }/>
    <p>
      Posted by
      <b>{ author | capitalize }</b>,
      { items.size | pluralize('item') } for { price * qty | currency }.
    </p>
    <p>{ 'cart.count' | t({ count: items.size, unit }) }</p>
    <p>{ this.label(total, { digits: 2 }) }</p>
    <p>{ bio | newline_to_br }</p>
    <div>{ html | raw }</div>
  </Frame.Wrapper>

  <!-- D168: whitespace next to inline elements renders; <pre>/<textarea> keep
       their bytes. -->
  <p>tokens — <code>a</code>,
    <code>b</code>{ sep }<code>c</code></p>
  <pre>
    keep   these
	bytes exactly
  </pre>
  <textarea name="note">
    indented body
  </textarea>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Frame from './Frame/index.js';
import Badge from './Badge.pzl';

export default class GrammarSpecimen extends PuzzleView {
	data() {
		return { name: ' families ', tone: null, followers: 12400, items: [1, 2], author: 'ada', price: 3, qty: 2, unit: 'box', total: 1.5, bio: 'a\nb', html: '<b>hi</b>', sep: ' / ' };
	}
	label(n, opts) {
		return n.toFixed(opts.digits);
	}
}
</script>

<style scoped>
.card { color: red; }
</style>
