            new ViewNode('text', { value: 'Emoji Picker Simple' }),
          ]),
          new ViewNode('p', { class: 'mt-2 text-body' }, [
            new ViewNode('text', { value: 'The lightweight sibling of the ' }),
            new ViewNode('a', {
              href: '#/components/emoji-picker',
              class: 'text-brand hover:underline',
            }, [
              new ViewNode('text', { value: 'Emoji Picker' }),
            ]),
            new ViewNode('text', { value: ': no search box, a category tab bar along the bottom instead. One category renders at a time, and because there is nothing to search, the keyword data file is never copied or bundled — the piece depends on the emoji inventory alone.' }),
          ]),
        ]),
        new ViewNode(ExampleBox, { code: __d.codeHero }, [
