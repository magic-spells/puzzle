              placeholder: 'Say something…',
              value: __d.message,
              '@input': ((this.__h ??= {})[0] ??= (event) => this.events.onMessageInput(event)),
            }, []),
            new ViewNode(EmojiPickerSimple, {
              align: 'end',
              change: ((this.__h ??= {})[1] ??= (event) => this.events.addEmoji(event)),
