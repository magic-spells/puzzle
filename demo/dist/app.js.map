          ]),
          new ViewNode('p', { class: 'text-sm text-body' }, [
            new ViewNode('text', { value: 'The grid itself takes focus on open and tracks the highlighted cell with aria-activedescendant: arrows move it (Left/Right by one, Up/Down by a row of eight), Home and End jump, Enter or Space picks, Escape closes and refocuses the trigger. Tab moves on to the category bar — a tablist with Left/Right arrow navigation that switches categories as it goes.' }),
          ]),
        ]),
      ]),
      new ViewNode(Toc, {
        class: 'sticky top-24 hidden h-fit w-48 shrink-0 self-start xl:block',
