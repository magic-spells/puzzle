          ]),
          new ViewNode('p', { class: 'mt-2 text-body' }, [
            new ViewNode('text', { value: 'A trigger button opening a popover with a search box over a keyboard-navigable grid of the full Unicode emoji set, grouped by category. Search matches names and CLDR keywords — typing happy finds faces whose official names never say it. Picking emits the character and closes; the picker holds no value of its own.' }),
          ]),
