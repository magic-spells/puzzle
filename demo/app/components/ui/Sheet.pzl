<puzzle-view>
  <dialog
    class={ dialogClass }
    aria-labelledby={ labelledby }
    @cancel={ handleCancel }
    @close={ handleClose }>

    <div
      ref="backdrop"
      data-sheet-surface="backdrop"
      class={ backdropClass }></div>

    <div ref="panel" data-sheet-surface="panel" class={ panelClass }>
      {#if showGrabber}
        <div class={ grabberClass } aria-hidden="true"></div>
      {/if}

      <div
        ref="header"
        data-sheet-surface="header"
        class={ headerClass }>
        <Slot name="header">
          {#if title}
            <h2 id={ titleId } class={ titleClass }>{ title }</h2>
          {/if}
        </Slot>
      </div>

      <div
        ref="content"
        data-sheet-surface="content"
        class={ contentClass }
        @touchmove={ scrollVeto }>
        <Children/>
      </div>

      <div
        ref="footer"
        data-sheet-surface="footer"
        class={ footerClass }>
        <Slot name="footer"/>
      </div>
    </div>
  </dialog>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import {
  awayOffset,
  dismissAxis,
  EXIT_CUSHION,
  parseDismiss,
  parseSpring,
  SheetEngine,
} from '../../lib/sheet-engine.js';
import {
  contentClaimDirection,
  normalizeScrollLeft,
  resolveInitialSnap,
  resolveSnapPoints,
  resolveSnapTarget,
} from '../../lib/sheet-policy.js';
import { DragGesture } from '../../lib/sheet-drag.js';

// Sheet — a one-component Puzzle port of the @magic-spells/sheet web-component
// family. The native <dialog> is a transparent, full-viewport top-layer shell;
// the engine animates the inner panel div, and a real backdrop div makes the
// overlay a gesture surface while the native ::backdrop remains transparent.
//
// CONTROLLED CONTRACT. `open` is required and is never mutated here. Escape,
// a backdrop tap, an allowed swipe, or a native close calls @close(reason),
// where reason is 'escape', 'backdrop', 'swipe', or 'close'. The parent flips
// `open`; syncOpen() then
// asks SheetEngine to hide, and only the engine's `hidden` event closes the
// native dialog. Native `cancel` is always preventDefault'd. maxDisplayWidth is
// an opening ceiling: above it a closed open intent is suppressed without
// manufacturing a user-dismissal reason. It never tears down an already-open
// controlled sheet; shrinking below the ceiling opens while `open` remains true.
//
// SNAP CONTRACT. `snapPoints` accepts a space-separated CSS-length string or an
// array of CSS lengths; default '85vh'. A hidden browser probe resolves every
// top-level token independently while preserving whitespace inside functions,
// so viewport-unit variants and expressions such as calc(100dvh - 4rem),
// min(), clamp(), and var() keep their native CSS semantics. Invalid or
// zero-height tokens are discarded. `snapPoints` is a MOBILE-PROFILE prop and
// nothing else: only a bottom sheet below the breakpoint reads it, and it uses
// the full ascending list. Every other profile sizes itself by measurement —
// sides take their measured fixed width, and center at any width AND bottom
// past the breakpoint take their measured intrinsic content height (both are
// dismiss-only, so there is nothing to snap to). Mobile and desktop are
// therefore independent resting geometries that the breakpoint FLIPs between,
// and a content-sized desktop bottom panel may stand TALLER than the largest
// mobile snap — the recipe's max-h is its only ceiling. `snap` is
// optional-controlled: when
// present, the parent owns the index through @snapChange(index); when absent, the
// piece commits releases locally. `initialSnap` selects the first uncontrolled
// index on every open and defaults to largest.
//
// SLOTS. The named header slot replaces the stock header fallback — the title.
// Because Puzzle has no slot-filled probe, a custom header must bring its own
// accessible heading and pass `labelledby`; otherwise the title fallback
// supplies the generated heading id. The grabber pill is deliberately NOT in
// that fallback for any position (see the fifth surface below): it is hosted on
// the panel and floats, so it survives any header content and a custom header
// never re-adds it. The header wrapper owns the top padding and is
// `empty:hidden`; the footer wrapper is `empty:hidden`. Untagged call-site
// content renders through <Children/>.
//
// MEASUREMENT. prepareOpen() lays out the real panel (temporarily display:flex +
// visibility:hidden while the dialog is closed), then reads
// getBoundingClientRect(). Side width, center height, and every card-mode edge
// inset therefore match the caller's actual Tailwind overrides exactly. Bottom
// snaps use a hidden CSS measurement probe. Numeric props replace the remaining
// probes: exitCushion defaults to 28px;
// morphDuration defaults to 600ms and collapses to 0 under reduced motion.
//
// GESTURES AND DISMISS POLICY. Five DragGesture instances preserve the source's
// continuous tracking, independent axes, rolling velocity, and deferred pointer
// capture. Header/footer/backdrop always claim; content snapshots its complete
// scroll chain at pointerdown and delegates the finger-space decision to
// sheet-policy. The one template touchmove listener prevents native scrolling
// only after the sheet claims. `dismiss` is parsed LIVE at every escape,
// backdrop, and swipe guard. A refused swipe is redirected to the active snap
// and reports snapRelease({ prevented: true }); an allowed swipe queues release
// velocity on SheetEngine before asking the parent to close.
//
// THE FIFTH SURFACE. The panel itself is the fifth gesture, and it exists for one
// region: a side sheet's handle strip. Side profiles reserve the pill's own 12px
// footprint as panel padding no child surface covers, the pill floats over it as
// a pointer-events-none panel child, and the panel takes touch-action: none so no
// native pan can begin on the strip (the content's own touch-pan-x/y keeps nested
// scrolling working below it). It claims rigidly, like the header.
//
// An earlier port put the side pill inside the header slot fallback instead. That
// made the pill itself live — it is a header descendant, and the header always
// claims — but it did not satisfy the invariant: the claim surface was a 4px x
// 40px sliver rather than a full-height edge strip, the region beside the pill
// belonged to the content and so deferred to its scroll chain, and a caller
// filling the header slot deleted the side sheet's advertised swipe outright.
// Hosting the pill on the panel, as the source deliberately does, fixes all
// three.
//
// The trap is bubbling: every child surface's pointerdown reaches the panel's
// DragGesture too, and one that merely ignored the callbacks would still capture
// the pointer at slop and starve the surface that owns it. #dragStart therefore
// REFUSES any hit whose target is not the panel directly, via DragGesture's
// return-false seam, which leaves the refused gesture fully inert — no capture,
// no further callbacks. Desktop and fine-pointer profiles drop the strip and the
// pill, so there the panel is fully covered and every hit is refused.
//
// DESKTOP FALLBACK. Past `breakpoint` (default 768) the desktop* props take
// over, and each falls back to its mobile twin — except `desktopPosition` when
// `position` is bottom, which defaults to 'center' so a wide sheet sizes to its
// content instead of standing as a full-width 85vh slab. Pass
// desktopPosition="bottom" to opt back in. See #resolveProfile.
//
// PROFILE MORPH. A breakpoint/profile-key crossing while open is a synchronous
// FLIP split across Puzzle's patcher: beginMorph() parks the spring and pins the
// backdrop; the live FROM box is read; new literal class maps are patched; then
// afterUpdate() measures the unpinned TO box and transitions explicit
// top/left/width/height/border-radius pixels. transitionend and a duration+120ms
// timeout share one teardown. Re-entrant crossings always retarget from the
// currently painted box. Same-profile resizes remeasure without morphing —
// unless one arrives mid-morph, which retargets the flight synchronously
// (#retargetMorph) rather than waiting for it to land somewhere stale.
//
// IMPERATIVE INLINE STYLES. The panel and backdrop deliberately have NO
// `style={}` bindings and there is no <style> block. SheetEngine/DragGesture/
// morph code own panel inline styles between renders; the engine change listener
// alone writes backdrop opacity. The source's public --sheet-progress and
// --sheet-backdrop-progress CSS tokens are deliberately dropped: the real
// backdrop consumes engine.backdropProgress directly.
let uid = 0;

const POSITIONS = new Set(['bottom', 'left', 'right', 'center']);
const MODES = new Set(['edge', 'card']);
const EFFECTS = new Set(['slide', 'fade-scale', 'slide-fade', 'pop']);
const SCROLLABLE_OVERFLOW = new Set(['auto', 'scroll']);

const RESIZE_THROTTLE_MS = 100;
const FLICK_VELOCITY = 0.5;
const OVERSCROLL_RESISTANCE = 0.2;
const MORPH_TIMEOUT_PADDING_MS = 120;
const DEFAULT_MORPH_DURATION = 600;
const DEFAULT_MORPH_EASING = 'cubic-bezier(0.34, 1.32, 0.52, 1)';

const DIALOG =
  'fixed inset-0 m-0 h-[100dvh] max-h-none w-full max-w-none border-0 bg-transparent p-0 ' +
  'open:flex overflow-hidden text-body [&::backdrop]:bg-transparent';

const DIALOG_PROFILE = {
  bottom: 'flex-col justify-end',
  left: 'flex-row justify-start',
  right: 'flex-row justify-end',
  center: 'items-center justify-center',
};

const BACKDROP =
  'absolute inset-0 bg-black/50 backdrop-blur-sm touch-none';

const PANEL_BASE =
  'relative z-10 flex min-h-0 min-w-0 flex-col overflow-hidden bg-surface will-change-transform';

// A shadow is always transparent BLACK, never a theme colour. `--color-faint`
// is a text token and becomes light in dark mode, which paints a white halo.
// These recipes keep the source/BottomSheet ambient pair literally visible to
// Tailwind's scanner. The edge recipes add a surface-colour bleed skirt so
// rubber-band travel cannot expose the backdrop past a flush screen edge.
const PANEL_BOTTOM_EDGE =
  'max-h-[100dvh] rounded-t-2xl border-t border-border ' +
  'pb-[env(safe-area-inset-bottom,0px)] ' +
  'shadow-[0_60px_0_0_var(--color-surface),0_1px_20px_-4px_rgb(0_0_0/0.3),0_0_7px_0_rgb(0_0_0/0.1)]';

const PANEL_BOTTOM_CARD =
  'mx-auto mb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] max-h-[calc(100dvh-1.5rem)] ' +
  'rounded-2xl border border-border ' +
  'shadow-[0_1px_20px_-4px_rgb(0_0_0/0.3),0_0_7px_0_rgb(0_0_0/0.1)]';

// The bottom recipes deliberately carry NO height: mobile and desktop are two
// independent resting geometries and the height is the thing that differs.
// Mobile takes a snap point, so the class is the 85dvh fallback the snap
// resolution then overwrites; desktop ignores snapPoints entirely and measures
// its own content, exactly like center. These are appended rather than layered
// over a base height because registry class strings have no conflict resolver —
// stacking h-[85dvh] and h-fit would let Tailwind's stylesheet order decide,
// not the attribute order. The max-h caps stay on the recipes: they bound both
// profiles, and on desktop the cap is the ONLY ceiling, so a content-sized
// panel can legitimately stand taller than the largest mobile snap.
const BOTTOM_HEIGHT_MOBILE = 'h-[85dvh]';
const BOTTOM_HEIGHT_DESKTOP = 'h-fit';

// The two profiles whose height IS their content: center at any width, and
// bottom past the breakpoint. Both resolve their single snap by measurement and
// both need the content-resize observer.
const CONTENT_SIZED = (profile) =>
  profile.position === 'center' ||
  (profile.position === 'bottom' && profile.desktop);

const PANEL_LEFT_EDGE =
  'h-full rounded-r-2xl border-r border-border ' +
  'pl-[env(safe-area-inset-left,0px)] ' +
  'shadow-[-120px_0_0_0_var(--color-surface),0_1px_20px_-4px_rgb(0_0_0/0.3),0_0_7px_0_rgb(0_0_0/0.1)]';

const PANEL_RIGHT_EDGE =
  'h-full rounded-l-2xl border-l border-border ' +
  'pr-[env(safe-area-inset-right,0px)] ' +
  'shadow-[120px_0_0_0_var(--color-surface),0_1px_20px_-4px_rgb(0_0_0/0.3),0_0_7px_0_rgb(0_0_0/0.1)]';

const PANEL_LEFT_CARD =
  'my-[0.75rem] ml-[0.75rem] h-[calc(100%-1.5rem)] max-h-[calc(100dvh-1.5rem)] ' +
  'rounded-2xl border border-border ' +
  'shadow-[0_1px_20px_-4px_rgb(0_0_0/0.3),0_0_7px_0_rgb(0_0_0/0.1)]';

const PANEL_RIGHT_CARD =
  'my-[0.75rem] mr-[0.75rem] h-[calc(100%-1.5rem)] max-h-[calc(100dvh-1.5rem)] ' +
  'rounded-2xl border border-border ' +
  'shadow-[0_1px_20px_-4px_rgb(0_0_0/0.3),0_0_7px_0_rgb(0_0_0/0.1)]';

const PANEL_CENTER =
  'm-auto h-fit max-h-[calc(100dvh-1.5rem)] ' +
  'rounded-2xl border border-border ' +
  'shadow-[0_1px_20px_-4px_rgb(0_0_0/0.3),0_0_7px_0_rgb(0_0_0/0.1)]';

const PANEL_PROFILE = {
  'bottom:edge': PANEL_BOTTOM_EDGE,
  'bottom:card': PANEL_BOTTOM_CARD,
  'left:edge': PANEL_LEFT_EDGE,
  'left:card': PANEL_LEFT_CARD,
  'right:edge': PANEL_RIGHT_EDGE,
  'right:card': PANEL_RIGHT_CARD,
};

const PANEL_WIDTH = {
  'bottom:edge': 'w-full',
  'bottom:card': 'w-[calc(100%-1.5rem)]',
  'left:edge': 'w-[min(26rem,90vw)]',
  'left:card': 'w-[min(26rem,90vw)]',
  'right:edge': 'w-[min(26rem,90vw)]',
  'right:card': 'w-[min(26rem,90vw)]',
  center: 'w-[min(28rem,calc(100vw-1.5rem))]',
};

// Desktop bottom cards yield this default cap outright when the caller supplies
// any max-width utility. Registry class strings have no conflict resolver, and
// Tailwind's generated selector order otherwise makes a plain override win for
// some utility spellings and lose for others.
const PANEL_WIDTH_CAP = 'max-w-[26rem]';
const CALLER_MAX_WIDTH = /(?:^|\s)\S*max-w-/;
const CALLER_WIDTH = /(?:^|\s)(?:[\w-]+:)*w-/;

// pt-4 is unconditional so the header sits the same distance from the top edge
// on touch and on desktop. The pills float inside that padding instead of
// occupying flow, so hiding them (fine pointer, or desktop) cannot reflow the
// header. empty:hidden keeps a title-less, slot-less sheet from reserving it.
const HEADER = 'shrink-0 touch-none select-none px-4 pt-4 empty:hidden';
const HEADER_HANDLE = 'shrink-0 touch-none select-none px-4 pt-4';
const CONTENT =
  'min-h-0 min-w-0 flex-1 overflow-auto overscroll-contain touch-pan-x touch-pan-y px-4 py-4';
const FOOTER = 'shrink-0 touch-none bg-surface p-4 empty:hidden';

// Every pill is hosted on the PANEL and is `pointer-events-none` exactly like
// the source's `sheet-panel::before`: it floats over the space its neighbours
// already reserve, so a pointerdown there hits the panel itself — the fifth drag
// surface — rather than a 4px sliver of pill. Nothing here is in flow and
// nothing carries a margin: a pill appears and disappears (fine pointer, or
// desktop) without moving a single header pixel. The bottom pill rides inside
// the header's own pt-4, so it needs no reserved strip; the sides still get one
// because their pill sits beside the content rather than above it.
const GRABBER_BOTTOM =
  'pointer-fine:hidden pointer-events-none absolute left-1/2 top-2 h-1 w-10 -translate-x-1/2 rounded-full bg-faint';
const GRABBER_LEFT =
  'pointer-fine:hidden pointer-events-none absolute right-2 top-1/2 h-10 w-1 -translate-y-1/2 rounded-full bg-faint';
const GRABBER_RIGHT =
  'pointer-fine:hidden pointer-events-none absolute left-2 top-1/2 h-10 w-1 -translate-y-1/2 rounded-full bg-faint';

// The strip reserves only the pill's own footprint — 8px offset + 4px thickness
// = 12px — and nothing more: breathing room on top of it shifts every child over
// and reads as lopsided padding on a narrow panel, and the children's own px-4
// gutter already provides the clearance. Desktop drops the strip in JS (no touch
// swipes above the breakpoint, and a desktop sheet is dismiss-only); a fine
// pointer drops it in CSS, matching the two places the source hides the handle.
const PANEL_SIDE_STRIP = {
  left: 'pr-3 pointer-fine:pr-0',
  right: 'pl-3 pointer-fine:pl-0',
};

// HEADER owns the top padding for all three, so a title only spells out the gap
// below itself.
const TITLE_BOTTOM = 'pb-3 text-center text-base font-semibold text-ink';
const TITLE_SIDE = 'pb-4 text-left text-base font-semibold text-ink';
const TITLE_CENTER = 'text-center text-base font-semibold text-ink';

const MORPH_PROPERTIES = [
  'position',
  'top',
  'left',
  'right',
  'bottom',
  'width',
  'height',
  'maxWidth',
  'maxHeight',
  'margin',
  'borderRadius',
  'transition',
];

const MORPH_TRANSITION_PROPERTIES = [
  'top',
  'left',
  'width',
  'height',
  'border-radius',
];

function scrollMetrics(element) {
  const rtl = getComputedStyle(element).direction === 'rtl';
  return {
    scrollTop: element.scrollTop,
    scrollLeft: normalizeScrollLeft(
      element.scrollLeft,
      element.scrollWidth,
      element.clientWidth,
      rtl
    ),
    scrollHeight: element.scrollHeight,
    scrollWidth: element.scrollWidth,
    clientHeight: element.clientHeight,
    clientWidth: element.clientWidth,
  };
}

function scrollsOnAxis(element, axis) {
  const style = getComputedStyle(element);
  return SCROLLABLE_OVERFLOW.has(axis === 'x' ? style.overflowX : style.overflowY);
}

export default class Sheet extends PuzzleView {
  #mounted = false;
  #engine = null;
  #gestures = [];
  #profile = null;
  #renderProfile = null;
  #queuedProfile = null;
  #snaps = [];
  #drag = { active: false };
  #localSnap = null;
  #settleTarget = null;
  #programmaticSnap = null;
  #snapRun = 0;
  #returnFocus = null;
  #resizeHandler = null;
  #resizeTimer = null;
  #centerObserver = null;
  #centerTimer = null;
  #pendingMorph = null;
  #pendingMeasure = null;
  #morph = null;
  #measureSignature = null;
  #needsRemeasure = false;
  #springSignature = null;
  #appliedProfileSignature = null;

  #engineChange = ({ backdropProgress }) => {
    if (this.refs.backdrop) {
      const value = Number.isFinite(backdropProgress) ? backdropProgress : 0;
      this.refs.backdrop.style.opacity = String(Math.min(1, Math.max(0, value)));
    }
  };

  #engineShown = () => {
    if (this.refs.backdrop) this.refs.backdrop.style.opacity = '1';
    this.#syncCenterObserver();
    const { shown } = this.props;
    if (typeof shown === 'function') shown();
  };

  #engineHidden = () => {
    const dialog = this.element;
    if (dialog?.open) dialog.close();
    if (this.refs.backdrop) this.refs.backdrop.style.opacity = '0';
    this.#drag = { active: false };
    this.#localSnap = null;
    this.#settleTarget = null;
    this.#programmaticSnap = null;
    this.#syncCenterObserver();
    this.#unlockBody();
    this.#restoreFocus();
    const { hidden } = this.props;
    if (typeof hidden === 'function') hidden();
  };

  #engineSnapChange = (detail) => {
    const to = detail.to;
    const programmatic = this.#programmaticSnap === to;
    this.#settleTarget = null;
    this.#programmaticSnap = null;

    if (!this.#controlledSnap()) this.#localSnap = to;
    if (!programmatic) {
      const { snapChange } = this.props;
      if (typeof snapChange === 'function') snapChange(to);
    }
  };

  data(params, props) {
    const id = (this._id ??= `pp-sheet-${++uid}`);
    const requestedProfile = this.#resolveProfile(props);
    let renderedProfile = requestedProfile;

    if (!this.#renderProfile) {
      this.#renderProfile = requestedProfile;
    } else if (
      this.#mounted &&
      this.element?.open &&
      !!props.open &&
      this.#profileKey(requestedProfile) !== this.#profileKey(this.#renderProfile)
    ) {
      // Keep the old geometry through this patch. afterUpdate() reads its live
      // box, then performs a second class-only patch for the FLIP destination.
      this.#queuedProfile = requestedProfile;
      renderedProfile = this.#renderProfile;
    } else if (this.#pendingMorph || this.#morph) {
      renderedProfile = this.#renderProfile;
    } else {
      this.#renderProfile = requestedProfile;
    }

    const signature = this.#measurementSignature(props);
    if (this.#mounted && this.#measureSignature !== signature) {
      this.#needsRemeasure = true;
    }
    this.#measureSignature = signature;

    const title = props.title || '';
    return {
      // Read imperatively by syncOpen(); returned so a prop flip still schedules
      // the afterUpdate reconciliation.
      open: !!props.open,
      title,
      titleId: `${id}-title`,
      labelledby: props.labelledby || (title ? `${id}-title` : false),
      ...this.#classData(renderedProfile, props),
    };
  }

  #classData(profile, props = this.props) {
    const callerClass = props.class || '';
    const position = profile.position;
    const cardKey = `${position}:${profile.mode}`;
    const side = position === 'left' || position === 'right';
    const showGrabber =
      props.showGrabber !== false && !profile.desktop && position !== 'center';
    const desktopBottomCap =
      profile.desktop && position === 'bottom' && profile.mode === 'card';

    let grabberClass = GRABBER_BOTTOM;
    if (position === 'left') grabberClass = GRABBER_LEFT;
    if (position === 'right') grabberClass = GRABBER_RIGHT;

    let titleClass = TITLE_BOTTOM;
    if (position === 'left' || position === 'right') titleClass = TITLE_SIDE;
    if (position === 'center') titleClass = TITLE_CENTER;

    return {
      // Every pill belongs to the panel, not the header fallback, so it survives
      // any header content — see the fifth-surface note above.
      showGrabber,
      dialogClass: [DIALOG, DIALOG_PROFILE[position]].filter(Boolean).join(' '),
      backdropClass: [BACKDROP, props.backdropClass || ''].filter(Boolean).join(' '),
      panelClass: [
        PANEL_BASE,
        position === 'center' ? PANEL_CENTER : PANEL_PROFILE[cardKey],
        CALLER_WIDTH.test(callerClass)
          ? ''
          : PANEL_WIDTH[position === 'center' ? 'center' : cardKey],
        // The bottom recipes carry no height of their own — see the note above.
        position === 'bottom'
          ? profile.desktop
            ? BOTTOM_HEIGHT_DESKTOP
            : BOTTOM_HEIGHT_MOBILE
          : '',
        // A side panel is itself a rigid drag surface, so no native pan may begin
        // on it. Scroll containers inside the content declare their own pans
        // below this element, so nested scrolling is unaffected.
        side ? 'touch-none' : '',
        side && !profile.desktop ? PANEL_SIDE_STRIP[position] : '',
        desktopBottomCap && !CALLER_MAX_WIDTH.test(callerClass)
          ? PANEL_WIDTH_CAP
          : '',
        callerClass,
      ]
        .filter(Boolean)
        .join(' '),
      headerClass: position === 'bottom' && showGrabber ? HEADER_HANDLE : HEADER,
      contentClass: CONTENT,
      footerClass: FOOTER,
      grabberClass,
      titleClass,
    };
  }

  #resolveProfile(props = this.props) {
    const position = POSITIONS.has(props.position) ? props.position : 'bottom';
    const mode = MODES.has(props.mode) ? props.mode : 'edge';
    const effect = EFFECTS.has(props.effect) ? props.effect : 'slide';
    const breakpointValue = Number(props.breakpoint);
    const breakpoint = Number.isFinite(breakpointValue) ? breakpointValue : 768;
    const desktop =
      typeof window !== 'undefined' && window.innerWidth >= breakpoint;
    // Bottom is the one position whose desktop fallback is NOT itself. A bottom
    // panel takes its height from a snap point, so on a large display a sheet
    // holding one paragraph is still a full-width 85vh slab of mostly empty
    // surface. Center is the conventional wide answer and the only profile that
    // sizes to its content, so bottom fans out to it by default. Every other
    // position already reads the same at both widths and falls back to itself.
    // Pass desktopPosition="bottom" to keep a bottom sheet bottom on desktop.
    const desktopPosition = POSITIONS.has(props.desktopPosition)
      ? props.desktopPosition
      : position === 'bottom'
        ? 'center'
        : position;
    const desktopMode = MODES.has(props.desktopMode)
      ? props.desktopMode
      : 'card';
    const explicitDesktopEffect = EFFECTS.has(props.desktopEffect)
      ? props.desktopEffect
      : null;
    const desktopEffect =
      explicitDesktopEffect ||
      (desktopPosition === 'center' ? 'fade-scale' : effect);
    const exitEffect = EFFECTS.has(props.exitEffect)
      ? props.exitEffect
      : effect;
    let desktopExitEffect;
    if (EFFECTS.has(props.desktopExitEffect)) {
      desktopExitEffect = props.desktopExitEffect;
    } else if (EFFECTS.has(props.exitEffect)) {
      desktopExitEffect = props.exitEffect;
    } else {
      desktopExitEffect = desktopEffect;
    }
    const cushion = Number(props.exitCushion);

    return {
      desktop,
      position: desktop ? desktopPosition : position,
      mode: desktop ? desktopMode : mode,
      effect: desktop ? desktopEffect : effect,
      exitEffect: desktop ? desktopExitEffect : exitEffect,
      edgeInset: 0,
      exitCushion:
        Number.isFinite(cushion) && cushion >= 0 ? cushion : EXIT_CUSHION,
      viewportWidth:
        typeof window === 'undefined' ? 0 : window.innerWidth,
      viewportHeight:
        typeof window === 'undefined' ? 0 : window.innerHeight,
    };
  }

  #profileKey(profile) {
    return `${profile.desktop}:${profile.position}:${profile.mode}:${profile.effect}`;
  }

  #profileSignature(profile) {
    return [
      this.#profileKey(profile),
      profile.exitEffect,
      profile.edgeInset,
      profile.exitCushion,
      profile.viewportWidth,
      profile.viewportHeight,
    ].join(':');
  }

  #measurementSignature(props = this.props) {
    const snaps = Array.isArray(props.snapPoints)
      ? JSON.stringify(props.snapPoints)
      : String(props.snapPoints ?? '85vh');
    return [
      snaps,
      props.initialSnap ?? '',
      props.class || '',
      props.exitCushion ?? '',
    ].join('|');
  }

  #withinMaxDisplayWidth() {
    if (typeof window === 'undefined') return true;
    const raw = this.props.maxDisplayWidth;
    if (
      raw === undefined ||
      raw === null ||
      raw === '' ||
      raw === 'none' ||
      raw === Infinity
    ) {
      return true;
    }
    const value = Number(raw);
    return !Number.isFinite(value) || window.innerWidth <= value;
  }

  #shouldDisplayOpen() {
    if (!this.props.open) return false;
    // The controlled contract wins once the native dialog is open. There is no
    // resize close reason in the public callback union, so crossing the display
    // ceiling must not close behind the parent's still-true `open` prop.
    if (this.element?.open) return true;
    return this.#withinMaxDisplayWidth();
  }

  #reducedMotion() {
    return !!window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  }

  #morphDuration() {
    if (this.#reducedMotion()) return 0;
    const value = Number(this.props.morphDuration);
    return Number.isFinite(value) && value >= 0
      ? value
      : DEFAULT_MORPH_DURATION;
  }

  #morphEasing() {
    return this.props.morphEasing || DEFAULT_MORPH_EASING;
  }

  #lockBody() {
    this.element?.setAttribute('data-scroll-lock', '');
    document.body.style.overflow = 'hidden';
  }

  #unlockBody() {
    this.element?.removeAttribute('data-scroll-lock');
    if (!document.querySelector('[data-scroll-lock]')) {
      document.body.style.overflow = '';
    }
  }

  #restoreFocus() {
    const target = this.#returnFocus;
    this.#returnFocus = null;
    if (!target?.isConnected || typeof target.focus !== 'function') return;
    target.focus({ preventScroll: true });
  }

  #requestClose(reason) {
    const { close } = this.props;
    if (typeof close === 'function') close(reason);
  }

  #dismissPolicy() {
    // Deliberately parsed at the event site. `dismiss` is live policy, not
    // configuration cached at mount/profile resolution time.
    return parseDismiss(this.props.dismiss);
  }

  #syncSpring() {
    if (!this.#engine) return;
    let parsed = null;
    const value = this.props.spring;
    if (typeof value === 'string') {
      parsed = parseSpring(value);
    } else if (value && typeof value === 'object') {
      parsed = parseSpring(`${value.attraction} ${value.friction}`);
    }
    const signature = parsed
      ? `${parsed.attraction}:${parsed.friction}`
      : 'presets';
    if (signature === this.#springSignature) return;
    this.#springSignature = signature;
    this.#engine.setSpring(parsed);
  }

  #snapPointValue() {
    const value = this.props.snapPoints ?? '85vh';
    return Array.isArray(value) ? value.join(' ') : String(value);
  }

  #resolveBottomSnaps() {
    const viewportHeight = window.innerHeight;
    const viewportWidth = window.innerWidth;
    const rootFontSize =
      Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    const probe = document.createElement('div');
    Object.assign(probe.style, {
      position: 'fixed',
      visibility: 'hidden',
      pointerEvents: 'none',
      boxSizing: 'border-box',
    });
    document.body.append(probe);
    const measure = (token) => {
      probe.style.height = '';
      probe.style.height = token;
      const height = probe.getBoundingClientRect().height;
      return Number.isFinite(height) && height > 0 ? height : 0;
    };

    let snaps;
    try {
      snaps = resolveSnapPoints(this.#snapPointValue(), {
        viewportHeight,
        viewportWidth,
        rootFontSize,
        percentageBase: viewportHeight,
        measure,
      });
      if (!snaps.length) {
        snaps = resolveSnapPoints('85vh', {
          viewportHeight,
          viewportWidth,
          rootFontSize,
          percentageBase: viewportHeight,
          measure,
        });
      }
    } finally {
      probe.remove();
    }
    return snaps;
  }

  #controlledSnap() {
    return this.props.snap !== undefined;
  }

  #desiredSnap(snaps = this.#snaps) {
    if (!snaps.length) return -1;
    if (this.#controlledSnap()) {
      return resolveInitialSnap(this.props.snap, snaps);
    }
    if (this.#localSnap === null) {
      this.#localSnap = resolveInitialSnap(this.props.initialSnap, snaps);
    }
    this.#localSnap = resolveInitialSnap(this.#localSnap, snaps);
    return this.#localSnap;
  }

  #measurePanelBox() {
    const dialog = this.element;
    const panel = this.refs.panel;
    if (!dialog || !panel) {
      return {
        top: 0,
        left: 0,
        right: 0,
        bottom: 0,
        width: 0,
        height: 0,
        borderRadius: '0px',
      };
    }

    const closed = !dialog.open;
    const savedDisplay = dialog.style.display;
    const savedVisibility = dialog.style.visibility;
    if (closed) {
      dialog.style.display = 'flex';
      dialog.style.visibility = 'hidden';
    }

    const rect = panel.getBoundingClientRect();
    const borderRadius = getComputedStyle(panel).borderRadius;

    if (closed) {
      dialog.style.display = savedDisplay;
      dialog.style.visibility = savedVisibility;
    }

    return {
      top: rect.top,
      left: rect.left,
      right: rect.right,
      bottom: rect.bottom,
      width: rect.width,
      height: rect.height,
      borderRadius,
    };
  }

  #edgeInset(profile, box) {
    if (profile.mode !== 'card') return 0;
    if (profile.position === 'bottom') {
      return Math.max(0, profile.viewportHeight - box.bottom);
    }
    if (profile.position === 'left') return Math.max(0, box.left);
    if (profile.position === 'right') {
      return Math.max(0, profile.viewportWidth - box.right);
    }
    return 0;
  }

  #prepareOpen(requestedProfile = this.#resolveProfile()) {
    if (!this.#engine) return;

    const box = this.#measurePanelBox();
    const profile = {
      ...requestedProfile,
      edgeInset: this.#edgeInset(requestedProfile, box),
    };
    this.#profile = profile;
    this.#engine.setProfile(profile);

    let snaps;
    if (profile.position === 'bottom' && !profile.desktop) {
      snaps = this.#resolveBottomSnaps();
    } else if (CONTENT_SIZED(profile)) {
      // Desktop bottom and center share one rule: the panel is whatever height
      // its content is, so the single "snap" is the measured box. snapPoints is
      // a MOBILE-profile prop and has no say here — the two profiles are
      // independent resting geometries, and a desktop bottom panel may well
      // stand taller than the largest mobile snap. Only the recipe's max-h caps
      // it. The fallback matters when the panel measures 0 (never laid out).
      snaps = [
        box.height > 0
          ? box.height
          : Math.max(1, profile.viewportHeight * 0.5),
      ];
    } else {
      snaps = [
        box.width > 0
          ? box.width
          : Math.max(1, Math.min(26 * 16, profile.viewportWidth * 0.9)),
      ];
    }

    const alreadyOpen =
      this.element?.open && this.#engine.state !== 'hidden';
    let active = 0;
    if (profile.position === 'bottom' && !profile.desktop) {
      active = alreadyOpen
        ? Math.min(this.#engine.activeSnap, snaps.length - 1)
        : this.#desiredSnap(snaps);
    }

    this.#snaps = snaps;
    this.#engine.setSnaps(snaps, active);
    // While beginMorph() has the engine parked, setSnaps() deliberately writes
    // no frame. A bottom destination still needs its resolved height pinned
    // under the TO measurement — the mobile 85dvh class fallback on one side,
    // the measured content height on the other — otherwise the FLIP measures
    // the wrong box and endMorph() snaps to the real value after it lands.
    // #stripMorphPins clears this height again at teardown, which is what lets
    // a desktop bottom panel go back to being sized by h-fit.
    if (this.#engine.morphing && profile.position === 'bottom') {
      this.refs.panel.style.height = `${snaps[active]}px`;
    }
    this.#appliedProfileSignature = this.#profileSignature(profile);
    this.#needsRemeasure = false;
    this.#syncCenterObserver();
  }

  #syncProfileWithoutMeasure(profile) {
    if (!this.#engine || !this.#profile) return;
    const next = { ...profile, edgeInset: this.#profile.edgeInset };
    const signature = this.#profileSignature(next);
    if (signature === this.#appliedProfileSignature) return;
    this.#profile = next;
    this.#engine.setProfile(next);
    this.#appliedProfileSignature = signature;
  }

  #reconcileSnap() {
    const profile = this.#profile;
    if (
      !profile ||
      profile.position !== 'bottom' ||
      profile.desktop ||
      !this.element?.open ||
      this.#engine?.state !== 'shown' ||
      this.#engine.morphing ||
      this.#drag.active
    ) {
      return;
    }

    const desired = this.#desiredSnap();
    if (
      desired < 0 ||
      desired === this.#engine.activeSnap ||
      desired === this.#settleTarget
    ) {
      return;
    }

    this.#settleTarget = desired;
    this.#programmaticSnap = desired;
    const run = ++this.#snapRun;
    this.#engine.settleTo(desired, 0).then(() => {
      if (run !== this.#snapRun) return;
      this.#settleTarget = null;
      this.#programmaticSnap = null;
    });
  }

  syncOpen() {
    const dialog = this.element;
    if (!dialog || !this.#engine) return;
    const shouldOpen = this.#shouldDisplayOpen();

    if (shouldOpen) {
      if (dialog.open) {
        if (
          this.#engine.state === 'hiding' ||
          this.#engine.state === 'hidden'
        ) {
          this.#engine
            .show({ to: this.refs.panel, display: 'flex' })
            .then(() => this.#reconcileSnap());
          this.refs.backdrop.style.opacity = String(
            this.#engine.backdropProgress
          );
        }
        return;
      }

      const profile = this.#resolveProfile();
      this.#renderProfile = profile;
      this.#prepareOpen(profile);
      this.#returnFocus =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
      this.#lockBody();
      this.refs.backdrop.style.opacity = '0';

      // showModal() and the synchronous frame-0 write inside engine.show() stay
      // in this task, so the browser never paints the resting panel first.
      dialog.showModal();
      this.#engine
        .show({ to: this.refs.panel, display: 'flex' })
        .then(() => this.#reconcileSnap());
      this.refs.backdrop.style.opacity = String(
        this.#engine.backdropProgress
      );
      this.#syncCenterObserver();
      return;
    }

    if (!dialog.open) return;
    this.#finishMorph();
    this.#drag = { active: false };
    this.#engine.hide();
  }

  mounted() {
    this.#mounted = true;
    this.#engine = new SheetEngine();
    this.#engine.on('change', this.#engineChange);
    this.#engine.on('shown', this.#engineShown);
    this.#engine.on('hidden', this.#engineHidden);
    this.#engine.on('snapchange', this.#engineSnapChange);
    this.#syncSpring();

    for (const [surface, element] of [
      ['backdrop', this.refs.backdrop],
      ['header', this.refs.header],
      ['content', this.refs.content],
      ['footer', this.refs.footer],
      // The panel itself hosts a side sheet's handle: the pill is
      // pointer-events-none and floats over the strip the panel reserves in its
      // own padding, which no child surface covers. Without this binding the one
      // element that advertises the swipe is the one place a swipe is dead.
      // #dragStart refuses any hit that is not the panel directly, so gestures
      // bubbling up from the surfaces above stay owned by them.
      ['panel', this.refs.panel],
    ]) {
      this.#gestures.push(
        new DragGesture(element, this.#surfaceCallbacks(surface))
      );
    }

    this.#resizeHandler = () => {
      if (this.#resizeTimer !== null) return;
      this.#resizeTimer = setTimeout(() => {
        this.#resizeTimer = null;
        this.#handleResize();
      }, RESIZE_THROTTLE_MS);
    };
    window.addEventListener('resize', this.#resizeHandler);
    this.syncOpen();
  }

  afterUpdate() {
    if (!this.#mounted) return;
    this.#syncSpring();

    if (!this.#shouldDisplayOpen()) {
      this.#queuedProfile = null;
      this.#pendingMeasure = null;
      this.syncOpen();
      return;
    }

    if (this.#pendingMorph) {
      this.#continueMorph();
      return;
    }

    if (this.#pendingMeasure) {
      const profile = this.#pendingMeasure;
      this.#pendingMeasure = null;
      this.#prepareOpen(profile);
    }

    if (this.#queuedProfile && this.element?.open) {
      const next = this.#queuedProfile;
      this.#queuedProfile = null;
      this.#startProfileMorph(next);
      return;
    }

    const next = this.#resolveProfile();
    if (
      this.element?.open &&
      this.#profile &&
      this.#profileKey(next) !== this.#profileKey(this.#profile)
    ) {
      this.#startProfileMorph(next);
      return;
    }

    if (
      this.#needsRemeasure &&
      this.element?.open &&
      !this.#drag.active &&
      !this.#engine.morphing
    ) {
      this.#prepareOpen(next);
    } else if (this.element?.open && this.#profile) {
      this.#syncProfileWithoutMeasure(next);
    }

    this.#reconcileSnap();
    this.syncOpen();
  }

  destroyed() {
    this.#mounted = false;
    window.removeEventListener('resize', this.#resizeHandler);
    if (this.#resizeTimer !== null) clearTimeout(this.#resizeTimer);
    this.#resizeTimer = null;
    this.#resizeHandler = null;

    if (this.#centerTimer !== null) clearTimeout(this.#centerTimer);
    this.#centerTimer = null;
    this.#centerObserver?.disconnect();
    this.#centerObserver = null;

    this.#finishMorph();
    for (const gesture of this.#gestures) gesture.destroy();
    this.#gestures = [];
    this.#drag = { active: false };

    if (this.#engine) {
      this.#engine.off('change', this.#engineChange);
      this.#engine.off('shown', this.#engineShown);
      this.#engine.off('hidden', this.#engineHidden);
      this.#engine.off('snapchange', this.#engineSnapChange);
      this.#engine.destroy();
      this.#engine = null;
    }

    if (this.refs.backdrop) this.refs.backdrop.style.opacity = '';
    if (this.element?.open) this.element.close();
    this.#unlockBody();
    this.#restoreFocus();
  }

  #surfaceCallbacks(surface) {
    return {
      onStart: (info) => this.#dragStart(surface, info?.event),
      onMove: (info) => this.#dragMove(surface, info),
      onEnd: (info) => this.#dragEnd(surface, info),
    };
  }

  #dragStart(surface, event) {
    // The panel surface exists for the side handle strip — the only region where
    // the panel itself is the hit target. Every child surface's pointerdown
    // bubbles through the panel's gesture too, and it must be refused outright
    // (not merely ignored): DragGesture would otherwise capture the pointer at
    // slop and starve the surface that owns it. Returning false is that refusal,
    // and it leaves the refused gesture fully inert.
    if (surface === 'panel' && event?.target !== this.refs.panel) return false;
    if (this.#engine?.state !== 'shown' || this.#engine.morphing) {
      this.#drag = { active: false };
      return false;
    }
    this.#settleTarget = null;
    this.#programmaticSnap = null;
    this.#drag = {
      active: true,
      claimed: false,
      direction: 0,
      scrollChain: this.#scrollChain(event?.target),
    };
  }

  #scrollChain(target) {
    const content = this.refs.content;
    if (!content) return [];

    const axis = dismissAxis(this.#profile.position);
    const chain = [];
    let node = target instanceof Element ? target : null;
    while (node && node !== content && content.contains(node)) {
      if (scrollsOnAxis(node, axis)) chain.push(scrollMetrics(node));
      node = node.parentElement;
    }
    if (scrollsOnAxis(content, axis)) chain.push(scrollMetrics(content));
    return chain;
  }

  #matchesActiveAxis(direction) {
    if (dismissAxis(this.#profile.position) === 'y') {
      return direction === 'up' || direction === 'down';
    }
    return direction === 'left' || direction === 'right';
  }

  #dragMove(surface, info) {
    const drag = this.#drag;
    if (!drag.active) return;

    const offset = awayOffset(
      this.#profile.position,
      info.deltaX,
      info.deltaY
    );
    if (!drag.claimed) {
      if (surface === 'content') {
        if (!this.#matchesActiveAxis(info.direction)) return;
        const position = this.#profile.position;
        const direction = contentClaimDirection(
          drag.scrollChain,
          dismissAxis(position),
          position,
          offset
        );
        if (!direction) return;
        drag.direction = direction;
      } else {
        if (!offset) return;
        drag.direction = Math.sign(offset);
      }
      drag.claimed = true;
    }

    this.#applyLiveOffset(offset);
  }

  #applyLiveOffset(offset) {
    const activeSize = this.#snaps[this.#engine.activeSnap];
    if (!Number.isFinite(activeSize)) return;
    const maximum = this.#snaps[this.#snaps.length - 1];
    let size = activeSize - offset;
    if (size > maximum) {
      size =
        maximum +
        Math.sqrt(size - maximum) * 10 * OVERSCROLL_RESISTANCE;
    }
    if (size < 0) {
      size = -Math.sqrt(-size) * 10 * OVERSCROLL_RESISTANCE;
    }
    this.#engine.dragBy(activeSize - size);
  }

  #settleBack() {
    if (this.#profile.position === 'bottom') {
      this.#engine.settleTo(this.#engine.activeSnap, 0);
    } else {
      this.#engine.returnToRest(0);
    }
  }

  #dragEnd(surface, info) {
    const drag = this.#drag;
    if (!drag.active) return;
    this.#drag = { active: false };

    if (
      !info.cancelled &&
      surface === 'backdrop' &&
      Math.hypot(info.deltaX, info.deltaY) < 10 &&
      info.duration < 300
    ) {
      if (this.#dismissPolicy().backdrop) {
        this.#requestClose('backdrop');
      } else if (drag.claimed) {
        this.#settleBack();
      }
      return;
    }
    if (!drag.claimed) return;

    if (info.cancelled) {
      this.#settleBack();
      return;
    }

    const velocityAway = awayOffset(
      this.#profile.position,
      info.velocityX,
      info.velocityY
    );
    const releasedSize = this.#engine.currentSize;
    const resolved = resolveSnapTarget({
      currentSize: releasedSize,
      velocityAway,
      snaps: this.#snaps,
      flickVelocity: FLICK_VELOCITY,
    });
    const prevented = resolved === null && !this.#dismissPolicy().swipe;
    const target = prevented ? this.#engine.activeSnap : resolved;

    const detail = {
      velocity: velocityAway,
      flick: Math.abs(velocityAway) > FLICK_VELOCITY,
      direction:
        velocityAway > 0
          ? 'away'
          : velocityAway < 0
            ? 'toward'
            : 'none',
      size: releasedSize,
      target,
      prevented,
    };
    const { snapRelease } = this.props;
    if (typeof snapRelease === 'function') snapRelease(detail);

    if (target === null) {
      this.#engine.setDismissVelocity(Math.max(0, velocityAway));
      this.#requestClose('swipe');
      return;
    }

    this.#settleTarget = target;
    const run = ++this.#snapRun;
    let settle;
    if (this.#profile.position === 'bottom') {
      settle = this.#engine.settleTo(target, -velocityAway);
    } else {
      settle = this.#engine.returnToRest(-velocityAway);
    }
    settle.then(() => {
      if (run === this.#snapRun) {
        this.#settleTarget = null;
        this.#reconcileSnap();
      }
    });
  }

  #handleResize() {
    if (!this.#mounted) return;
    if (!this.#shouldDisplayOpen()) {
      this.syncOpen();
      return;
    }

    const next = this.#resolveProfile();
    if (!this.element?.open) {
      this.#renderProfile = next;
      this.setData(this.#classData(next));
      return;
    }

    if (
      this.#profile &&
      this.#profileKey(next) !== this.#profileKey(this.#profile)
    ) {
      this.#startProfileMorph(next);
      return;
    }
    if (this.#drag.active) return;

    if (this.#engine?.morphing) {
      this.#retargetMorph(next);
      return;
    }

    this.#renderProfile = next;
    this.#prepareOpen(next);
  }

  // Mid-morph, the instant remeasure above would read pinned, interpolating
  // geometry — a centre profile would publish the animating height as its
  // intrinsic one. But simply waiting leaves the morph flying toward a
  // destination measured at the crossing tick, and when the pins strip the panel
  // snaps to wherever the still-moving window ended up. So retarget instead.
  //
  // Unlike #startProfileMorph this must NOT route through setData: the profile
  // key has not changed, so the class data is identical and the patcher may not
  // schedule an update at all — which would strand #pendingMorph and leave the
  // engine parked forever. The FLIP is therefore re-entered synchronously.
  #retargetMorph(profile) {
    const panel = this.refs.panel;
    if (!panel || !this.#engine?.morphing) return;
    // Read before the pins go: the animated rect is the exact starting point.
    const from = this.#readBox(panel);
    this.#clearMorphTimers();
    this.#stripMorphPins(panel);
    this.#renderProfile = profile;
    this.#pendingMorph = { from, profile };
    this.#continueMorph();
  }

  #startProfileMorph(next) {
    const panel = this.refs.panel;
    if (!panel || !this.#engine || !this.element?.open) {
      this.#deferMeasure(next);
      return;
    }

    this.#drag = { active: false };
    let from;
    if (this.#engine.morphing) {
      // Read before removing an active transition: the animated rect is the
      // exact re-entrant starting point.
      from = this.#readBox(panel);
      this.#clearMorphTimers();
      this.#pendingMorph = null;
    } else {
      if (!this.#engine.beginMorph()) {
        this.#deferMeasure(next);
        return;
      }
      from = this.#readBox(panel);
    }

    this.refs.backdrop.style.opacity = '1';
    this.#stripMorphPins(panel);
    this.#pendingMorph = { from, profile: next };
    this.#renderProfile = next;
    this.setData(this.#classData(next));
  }

  #deferMeasure(profile) {
    this.#renderProfile = profile;
    this.#pendingMeasure = profile;
    this.setData(this.#classData(profile));
  }

  #continueMorph() {
    const pending = this.#pendingMorph;
    if (!pending) return;
    this.#pendingMorph = null;

    const panel = this.refs.panel;
    this.#prepareOpen(pending.profile);
    const to = this.#readBox(panel);
    const duration = this.#morphDuration();
    const finish = () => {
      this.#finishMorph();
      this.#reconcileSnap();
    };
    if (duration <= 0) {
      finish();
      return;
    }

    this.#pinBox(panel, pending.from);
    void panel.offsetWidth;

    const easing = this.#morphEasing();
    panel.style.transition = MORPH_TRANSITION_PROPERTIES.map(
      (property) => `${property} ${duration}ms ${easing}`
    ).join(', ');
    this.#pinBox(panel, to);

    const onEnd = (event) => {
      if (
        event.target === panel &&
        MORPH_TRANSITION_PROPERTIES.includes(event.propertyName)
      ) {
        finish();
      }
    };
    this.#morph = {
      panel,
      onEnd,
      timer: setTimeout(
        finish,
        duration + MORPH_TIMEOUT_PADDING_MS
      ),
    };
    panel.addEventListener('transitionend', onEnd);
  }

  #readBox(panel) {
    const rect = panel.getBoundingClientRect();
    return {
      top: rect.top,
      left: rect.left,
      width: rect.width,
      height: rect.height,
      borderRadius: getComputedStyle(panel).borderRadius,
    };
  }

  #pinBox(panel, box) {
    Object.assign(panel.style, {
      position: 'fixed',
      top: `${box.top}px`,
      left: `${box.left}px`,
      right: 'auto',
      bottom: 'auto',
      width: `${box.width}px`,
      height: `${box.height}px`,
      maxWidth: 'none',
      maxHeight: 'none',
      margin: '0',
      borderRadius: box.borderRadius,
    });
  }

  #stripMorphPins(panel) {
    for (const property of MORPH_PROPERTIES) panel.style[property] = '';
  }

  #clearMorphTimers() {
    if (!this.#morph) return;
    clearTimeout(this.#morph.timer);
    this.#morph.panel.removeEventListener(
      'transitionend',
      this.#morph.onEnd
    );
    this.#morph = null;
  }

  #finishMorph() {
    if (
      !this.#pendingMorph &&
      !this.#morph &&
      !this.#engine?.morphing
    ) {
      return;
    }
    this.#pendingMorph = null;
    this.#clearMorphTimers();
    if (this.refs.panel) this.#stripMorphPins(this.refs.panel);
    if (this.#engine?.morphing) this.#engine.endMorph();
    if (this.refs.backdrop && this.element?.open) {
      this.refs.backdrop.style.opacity = '1';
    }
  }

  #syncCenterObserver() {
    const want =
      !!this.#profile &&
      CONTENT_SIZED(this.#profile) &&
      !!this.element?.open &&
      typeof ResizeObserver === 'function';
    if (want && !this.#centerObserver) {
      this.#centerObserver = new ResizeObserver(() => {
        this.#scheduleCenterRemeasure();
      });
      this.#centerObserver.observe(this.refs.panel);
    } else if (!want && this.#centerObserver) {
      this.#centerObserver.disconnect();
      this.#centerObserver = null;
      if (this.#centerTimer !== null) clearTimeout(this.#centerTimer);
      this.#centerTimer = null;
    }
  }

  #scheduleCenterRemeasure() {
    if (this.#centerTimer !== null) clearTimeout(this.#centerTimer);
    this.#centerTimer = setTimeout(() => {
      this.#centerTimer = null;
      if (
        !this.#profile ||
        !CONTENT_SIZED(this.#profile) ||
        !this.element?.open
      ) {
        return;
      }
      if (
        this.#drag.active ||
        this.#engine?.morphing ||
        this.#engine?.state !== 'shown' ||
        this.#settleTarget !== null
      ) {
        this.#scheduleCenterRemeasure();
        return;
      }
      const height = this.#measurePanelBox().height;
      if (Math.abs(height - (this.#snaps[0] ?? 0)) <= 1) return;
      this.#prepareOpen(this.#resolveProfile());
    }, RESIZE_THROTTLE_MS);
  }

  events = {
    handleCancel: (event) => {
      event.preventDefault();
      if (!this.#dismissPolicy().escape) return;
      this.#requestClose('escape');
    },
    handleClose: () => {
      const state = this.#engine?.state;
      if (
        !state ||
        state === 'hidden' ||
        state === 'hiding' ||
        state === 'showing'
      ) {
        return;
      }
      this.#finishMorph();
      this.#drag = { active: false };
      this.#engine.hide();
      this.#requestClose('close');
    },
    scrollVeto: (event) => {
      if (this.#drag.active && this.#drag.claimed && event.cancelable) {
        event.preventDefault();
      }
    },
  };
}
</script>
