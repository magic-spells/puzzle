<puzzle-view>
  <nav class={ rootClass } aria-label={ navLabel }>
    <div class="shrink-0 overflow-hidden empty:hidden">
      <Slot name="header"/>
    </div>

    <ul class="flex-1 min-h-0 space-y-0.5 overflow-y-auto overflow-x-hidden p-2">
      {#for item in items}
        <li class={ item.rowClass }>
          {#if item.kind === 'divider'}
            <div class="mx-1 my-2 border-t border-border" role="separator" aria-hidden="true"></div>

          {:else if item.kind === 'group'}
            <!-- The unpadded wrapper is the grid item: padding on the item itself would floor the 0fr track at padding height, so the padded heading clips inside it instead. -->
            <div class="min-h-0 overflow-hidden">
              <p class="truncate px-3 pb-1 pt-4 text-xs font-semibold uppercase tracking-wide text-muted">{ item.label }</p>
            </div>

          {:else if item.kind === 'parent'}
            <button
              type="button"
              id={ item.triggerId }
              data-sidebar-trigger
              data-index={ item.index }
              class={ item.triggerClass }
              title={ collapsed ? item.label : false }
              aria-current={ item.ariaCurrent }
              aria-haspopup={ item.hasPopup }
              aria-expanded={ item.ariaExpanded }
              aria-controls={ item.ariaControls }
              @click={ toggleSubmenu(item.index) }
              @keydown:escape={ onFlyoutEscape(event) }>
              {#if item.icon}
                <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={ item.icon }/>
                </svg>
              {:else}
                <span class="size-5 shrink-0" aria-hidden="true"></span>
              {/if}
              <span class={ labelClass }>{ item.label }</span>
              {#if item.badge}
                <span class={ badgeClass }>{ item.badge }</span>
              {/if}
              <svg
                class={ item.chevronClass }
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true">
                <path d="M7 5l5 5-5 5z"/>
              </svg>
            </button>
            <div
              id={ item.submenuId }
              data-sidebar-submenu
              data-index={ item.index }
              class="overflow-hidden"
              role="region"
              aria-labelledby={ item.triggerId }
              aria-hidden={ item.visualOpen ? false : 'true' }
              inert={ !item.visualOpen }>
              <ul class={ item.submenuClass }>
                {#for child in item.children}
                  <li>
                    <a
                      href={ child.href }
                      class={ child.linkClass }
                      aria-current={ child.active ? 'page' : false }>
                      <span class="min-w-0 flex-1 truncate text-left">{ child.label }</span>
                      {#if child.badge}
                        <span class={ badgeClass }>{ child.badge }</span>
                      {/if}
                    </a>
                  </li>
                {/for}
              </ul>
            </div>
            {#if item.flyoutOpen}
              <!-- Never add data-sidebar-submenu here: the WAAPI walker would animate the flyout to 0px. -->
              <div
                id={ item.flyoutId }
                data-sidebar-flyout
                class={ flyoutClass }
                style={ flyoutStyle }
                aria-labelledby={ item.triggerId }
                @keydown:escape={ onFlyoutEscape(event) }>
                <p class={ flyoutHeadingClass }>{ item.label }</p>
                <ul class="space-y-0.5">
                  {#for child in item.children}
                    <li>
                      <a
                        href={ child.href }
                        class={ child.linkClass }
                        aria-current={ child.active ? 'page' : false }
                        @click={ onFlyoutLink }>
                        <span class="min-w-0 flex-1 truncate text-left">{ child.label }</span>
                        {#if child.badge}
                          <span class={ badgeStatic }>{ child.badge }</span>
                        {/if}
                      </a>
                    </li>
                  {/for}
                </ul>
              </div>
            {/if}

          {:else}
            <a
              href={ item.href }
              class={ item.linkClass }
              title={ collapsed ? item.label : false }
              aria-current={ item.ariaCurrent }>
              {#if item.icon}
                <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={ item.icon }/>
                </svg>
              {:else}
                <span class="size-5 shrink-0" aria-hidden="true"></span>
              {/if}
              <span class={ labelClass }>{ item.label }</span>
              {#if item.badge}
                <span class={ badgeClass }>{ item.badge }</span>
              {/if}
            </a>
          {/if}
        </li>
      {/for}
    </ul>

    <div class="mt-auto shrink-0 border-t border-border p-2">
      <div class="overflow-hidden empty:hidden">
        <Slot name="footer"/>
      </div>
      <button
        type="button"
        class={ toggleClass }
        aria-label={ toggleLabel }
        title={ toggleLabel }
        aria-pressed={ collapsed ? 'true' : 'false' }
        @click={ toggleCollapsed }>
        <svg
          class="size-5 shrink-0 text-muted transition-[rotate] duration-200 motion-reduce:transition-none {#if collapsed}rotate-180{/if}"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M13 6l-6 6 6 6M19 6l-6 6 6 6"/>
        </svg>
        <span class={ labelClass }>Collapse</span>
      </button>
    </div>
  </nav>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// Sidebar — a config-first app-shell navigation rail done the Puzzle way: ONE
// component driven by an `items` array, no compound subcomponents.
// It renders grouped links with optional icons and badges, animated collapsible
// submenus (disclosure adapted inline from the Collapsible piece — height eases
// 0 ↔ measured via the Web Animations API, closed regions carry inert +
// aria-hidden), active-route highlighting, and an optional-controlled icon-only
// collapsed mode. Header/footer named slots hold the brand/logo and user-card.
//
// SCOPE — this piece is the RAIL only. Off-canvas mobile behavior is NOT built in:
// compose it at the app level (e.g. render the Sidebar inside a Sheet on small
// screens and show it inline on `md:` and up). The rail assumes a bounded-height
// parent (it is h-full / flex-col with a scrollable middle).
//
//   <Sidebar items={ items } activePath={ path } @collapse={ setCollapsed }>
//     <div slot="header">…brand…</div>
//     <div slot="footer">…user card…</div>
//   </Sidebar>
//
// ITEMS — a flat array mixing three shapes (order preserved):
//   { group: 'Label' }                              a section heading (fades out and
//                                                   collapses to zero height when collapsed)
//   { divider: true }                               a hairline separator
//   { label, href, icon?, badge?, children? }       a navigation entry
//     children: [{ label, href, badge? }]           → renders a collapsible submenu
//
// ICON CONTRACT — `icon` is an SVG path `d` string, NOT markup. It is rendered into
// a standard inline <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
// stroke-width="2"> — so author paths on a 24×24 grid, stroked (fill none). This is
// the config-first equivalent of an icon slot. Example (a house / "Home"):
//   icon: 'M3 12l9-7 9 7M5 10v10h14V10'
// Icons are strongly recommended: the collapsed rail shows ONLY the icon while the
// mounted label fades and clips, so an icon-less item is blank there.
//
// PROPS
//   items       array   the navigation config described above.
//   activePath  string  the href of the current route. The matching link (top-level
//                       OR submenu child) gets aria-current="page" + the active
//                       treatment (bg-brand-tint text-ink). A submenu containing the
//                       active child auto-opens on first render (and whenever
//                       activePath changes to land inside it).
//   collapsed   bool    OPTIONAL-CONTROLLED (DatePicker's shape): omit it and the rail
//                       owns its collapsed state internally, toggled by the built-in
//                       control at the bottom; pass it and the PARENT owns it — the
//                       rail only reflects the prop and *asks* to change via @collapse.
//                       Collapsed = an icon-only w-[3.75rem] rail (expanded is w-64); the
//                       width eases via transition-[width] (motion-reduce disables it).
//   label       string  accessible <nav> label (default 'Main').
//   class       string  appended to the root <nav>.
//
// SLOTS
//   header  brand / logo area pinned to the top (collapses via empty:hidden when unused).
//   footer  user-card / account area pinned to the bottom (mt-auto). Slotted chrome should
//           use shrink-0/px-3 where appropriate; both wrappers clip rather than reflow as
//           the rail narrows.
//
// CALLBACK
//   @collapse(next)  fired with the NEXT collapsed boolean when the built-in toggle is
//                    pressed. A controlled parent flips `collapsed` in response.
//
// COLLAPSED + SUBMENUS — FLYOUT. A collapsed parent remains a disclosure button; click
// pops its children out to the RIGHT in a fixed panel anchored at rect.right + 8,
// rect.top, then clamped above the viewport bottom in afterUpdate. One flyout opens at
// a time. Outside pointerdown, Escape, a child-link click, any capture-phase scroll or
// resize, and any collapsed change dismiss it. Escape is wired on trigger AND panel and
// refocuses the trigger. Listeners attach in openFlyout and detach in closeFlyout plus
// destroyed(). The inline `_openMap` survives a collapsed round trip. The trigger uses
// aria-haspopup="true", aria-expanded, and aria-controls switching between its region
// and flyout ids; the plain-link panel is labelled by the trigger and intentionally has
// no menu role. It carries data-sidebar-flyout, never data-sidebar-submenu. A consumer
// ancestor with transform/filter/backdrop-filter/perspective/contain/will-change becomes
// the fixed panel's containing block and can clip it. Skipped in v1: horizontal flip,
// hover-to-open, arrow-key roving focus, and enter animation (floating panels in this
// registry appear without one). A parent's own href is unused while it has children;
// normalizeItems keeps the fallback because it still serves kind:'link'.
//
// COLLAPSE ANIMATION — one DOM serves both states: fixed row padding keeps each icon in
// place and only class/attribute values change. The list p-2 plus row px-3 puts a size-5
// icon center 1.875rem from the rail edge, so the collapsed width is twice that:
// w-[3.75rem]. Labels, badges, and chevrons stay mounted and fade while row overflow
// clips them. Group headings use a CSS grid 1fr ↔ 0fr track animation — deliberately
// the one CSS-only, height-agnostic deviation from the established WAAPI height idiom;
// unsupported browsers degrade to a snap plus fade. Submenu height continues through
// the WAAPI path, and all transitions honor reduced motion. Never add an `{#if
// collapsed}` structural branch inside a row. The last-child `{#if item.flyoutOpen}` is
// the one allowed state branch because it does not replace or shift preceding row DOM.
// A collapsed group leaves the list's ~2px space-y-0.5 residual. Submenu children must
// not wrap because region scrollHeight is measured at the collapsed width.

let uid = 0;

const NAV_BASE =
  'flex h-full flex-col bg-surface border-r border-border ' +
  'transition-[width] duration-200 ease-out motion-reduce:transition-none';

// Shared row chrome. Unconditional outline COLOR (outline-ring) sits alongside the
// focus-visible reveal so the outline never flashes from the default on focus.
const ROW_BASE =
  'group flex items-center gap-3 rounded-md text-sm overflow-hidden ' +
  'transition-[color,background-color] duration-200 ease-out motion-reduce:transition-none ' +
  'outline-ring focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring';
const IDLE = 'text-muted hover:bg-surface-sunken hover:text-ink';
const ACTIVE = 'bg-brand-tint text-ink font-medium';
const BADGE =
  'shrink-0 rounded-full bg-surface-sunken px-2 py-0.5 text-xs font-medium text-muted';

// ROW_PAD is load-bearing geometry: list p-2 + row px-3 centers the size-5 icon
// at 1.875rem, exactly half the collapsed rail. Keep gap-3/px-3/size-5 together;
// badges land on the clip edge, so another shrink-0 item between icon and label
// could peek into the 0.75rem gutter.
const ROW_PAD = 'px-3 py-2';
const LABEL_BASE =
  'min-w-0 flex-1 overflow-hidden whitespace-nowrap text-left transition-opacity duration-200 ease-out motion-reduce:transition-none';
const CHEVRON_BASE =
  'size-4 shrink-0 text-muted transition-[rotate,opacity] duration-200 ease-out motion-reduce:transition-none';
const GROUP_ROW =
  'grid transition-[grid-template-rows,opacity] duration-200 ease-out motion-reduce:transition-none';
const FLYOUT_GAP = 8;
const FLYOUT_MARGIN = 8;
const FLYOUT =
  'fixed z-50 min-w-[10rem] rounded-lg border border-border bg-surface p-1 shadow-lg';
const FLYOUT_HEADING =
  'px-2.5 pb-1 pt-2 text-xs font-medium uppercase tracking-wide text-muted';

const linkClass = (active) =>
  [ROW_BASE, ROW_PAD, active ? ACTIVE : IDLE].join(' ');

const childLinkClass = (active) =>
  [ROW_BASE, 'px-3 py-1.5', active ? ACTIVE : IDLE].join(' ');

// Normalize the raw items prop into tagged rows the template branches on, resolving
// active state against activePath. The array index is kept as a stable key for the
// per-parent open map and the submenu/trigger ids.
function normalizeItems(items, activePath) {
  const list = Array.isArray(items) ? items : [];
  return list.map((it, i) => {
    if (it && it.divider) return { kind: 'divider', index: i, rowClass: '' };
    if (it && it.group != null) {
      return { kind: 'group', index: i, label: String(it.group), rowClass: '' };
    }

    const children = Array.isArray(it && it.children)
      ? it.children.map((c) => {
          const href = (c && c.href) || '#';
          return {
            label: c && c.label != null ? String(c.label) : '',
            href,
            badge: c && c.badge != null ? String(c.badge) : '',
            active: !!(activePath && href === activePath),
          };
        })
      : [];
    const hasChildren = children.length > 0;
    const ownHref = (it && it.href) || '';
    const href = ownHref || (hasChildren ? children[0].href : '#');
    const active = !!(activePath && ownHref && ownHref === activePath);
    const childActive = children.some((c) => c.active);

    return {
      kind: hasChildren ? 'parent' : 'link',
      index: i,
      rowClass: '',
      label: it && it.label != null ? String(it.label) : '',
      href,
      icon: (it && it.icon) || '',
      badge: it && it.badge != null ? String(it.badge) : '',
      children,
      hasChildren,
      active,
      childActive,
    };
  });
}

export default class Sidebar extends PuzzleView {
  created() {
    this._uid = ++uid;
    // Per-parent open state keyed by item index (instance field, not view data — the
    // submenu-open booleans feed the render via data() and are flipped with refresh()).
    this._openMap = {};
    // Last activePath we auto-opened for, so navigation into a submenu opens it once.
    this._lastActive = undefined;
    // Per-region open state the animation loop diffs against (keyed by data-index).
    this._regionState = {};
    // Uncontrolled collapsed state — instance field, NOT view data: the visible
    // layout (rail width, icon-only rows) is derived from it inside data(), so
    // the toggle must refresh() to re-run data(). A setData key would update
    // silently without re-deriving the render model (setData never re-runs
    // data()), leaving the click with no visible effect.
    this._uncontrolledCollapsed = false;
    // Flyout state stays in instance fields because data() derives the panel model.
    this._flyoutIndex = null;
    this._flyoutPos = { left: 0, top: 0 };
    this._flyoutBound = false;
    this._needsFlyoutClamp = false;
    this._onDocPointerDown = (event) => {
      if (this._flyoutIndex === null) return;
      const panel = this.element && this.element.querySelector('[data-sidebar-flyout]');
      if (panel && panel.contains(event.target)) return;
      // A trigger's own click handler owns closing or switching the flyout.
      if (event.target.closest && event.target.closest('[data-sidebar-trigger]')) return;
      this.closeFlyout({ refocus: false });
    };
    // Scroll and resize invalidate the measured anchor, so dismiss instead of chasing it.
    this._onFlyoutDismiss = () => {
      if (this._flyoutIndex !== null) this.closeFlyout({ refocus: false });
    };
  }

  // ---- collapsed: optional-controlled resolution ---------------------------

  _collapsedControlled() {
    return this.props.collapsed !== undefined;
  }

  _collapsed() {
    return this._collapsedControlled()
      ? !!this.props.collapsed
      : !!this._uncontrolledCollapsed;
  }

  _requestCollapsed(next) {
    this.closeFlyout({ refocus: false });
    const { collapse } = this.props;
    if (typeof collapse === 'function') collapse(next);
    if (!this._collapsedControlled()) this._uncontrolledCollapsed = next;
  }

  _regionOpen(index) {
    return this._openMap[index] === true && !this._collapsed();
  }

  // ---- collapsed submenu flyout --------------------------------------------

  openFlyout(index) {
    const trigger =
      this.element &&
      this.element.querySelector(`[data-sidebar-trigger][data-index="${index}"]`);
    if (!trigger) return;
    const rect = trigger.getBoundingClientRect();
    this._flyoutIndex = index;
    this._flyoutPos = { left: rect.right + FLYOUT_GAP, top: rect.top };
    this._needsFlyoutClamp = true;
    if (!this._flyoutBound) {
      document.addEventListener('pointerdown', this._onDocPointerDown);
      window.addEventListener('scroll', this._onFlyoutDismiss, true);
      window.addEventListener('resize', this._onFlyoutDismiss);
      this._flyoutBound = true;
    }
    this.refresh();
  }

  closeFlyout({ refocus = false } = {}) {
    if (this._flyoutIndex === null) return;
    const index = this._flyoutIndex;
    if (this._flyoutBound) {
      document.removeEventListener('pointerdown', this._onDocPointerDown);
      window.removeEventListener('scroll', this._onFlyoutDismiss, true);
      window.removeEventListener('resize', this._onFlyoutDismiss);
      this._flyoutBound = false;
    }
    this._flyoutIndex = null;
    this._needsFlyoutClamp = false;
    this.refresh();
    if (refocus) {
      const trigger =
        this.element &&
        this.element.querySelector(`[data-sidebar-trigger][data-index="${index}"]`);
      if (trigger) trigger.focus();
    }
  }

  _clampFlyout() {
    const panel = this.element && this.element.querySelector('[data-sidebar-flyout]');
    if (!panel || typeof window === 'undefined') return;
    const maxY = Math.max(
      FLYOUT_MARGIN,
      window.innerHeight - panel.offsetHeight - FLYOUT_MARGIN
    );
    const top = Math.min(Math.max(this._flyoutPos.top, FLYOUT_MARGIN), maxY);
    if (top !== this._flyoutPos.top) {
      this._flyoutPos = { ...this._flyoutPos, top };
      this.refresh();
    }
  }

  // ---- render model --------------------------------------------------------

  data(params, props) {
    const activePath = props.activePath || '';
    const collapsed = this._collapsed();
    const items = normalizeItems(props.items, activePath);
    const base = `pieces-sidebar-${this._uid}`;
    const flyoutIndex = collapsed ? this._flyoutIndex : null;
    const labelClass = [LABEL_BASE, collapsed ? 'opacity-0' : ''].join(' ');

    // Auto-open the submenu containing the active child — on first render and again
    // whenever activePath changes to land inside a (different) submenu. Never
    // force-closes what the user opened.
    if (activePath !== this._lastActive) {
      this._lastActive = activePath;
      items.forEach((it) => {
        if (it.kind === 'parent' && it.childActive) this._openMap[it.index] = true;
      });
    }

    // Decorate each row with its open flag, ids, and precomputed classes.
    items.forEach((it) => {
      if (it.kind === 'group') {
        it.rowClass = [
          GROUP_ROW,
          collapsed ? 'grid-rows-[0fr] opacity-0' : 'grid-rows-[1fr]',
        ].join(' ');
      } else if (it.kind === 'parent') {
        it.open = this._openMap[it.index] === true;
        it.visualOpen = it.open && !collapsed;
        it.triggerId = `${base}-trigger-${it.index}`;
        it.submenuId = `${base}-submenu-${it.index}`;
        it.flyoutId = `${base}-flyout-${it.index}`;
        it.flyoutOpen = flyoutIndex === it.index;
        it.hasPopup = collapsed ? 'true' : false;
        it.ariaCurrent = collapsed && it.childActive ? 'page' : false;
        it.ariaControls = collapsed ? it.flyoutId : it.submenuId;
        it.ariaExpanded = (collapsed ? it.flyoutOpen : it.visualOpen) ? 'true' : 'false';
        it.triggerClass = [
          linkClass(collapsed && (it.childActive || it.active)),
          'w-full cursor-pointer',
        ].join(' ');
        it.chevronClass = [
          CHEVRON_BASE,
          it.visualOpen ? 'rotate-90' : '',
          collapsed ? 'opacity-0' : '',
        ].join(' ');
        it.submenuClass = [
          'ml-[1.375rem] mt-0.5 space-y-0.5 border-l border-border pl-2 transition-opacity duration-200 ease-out motion-reduce:transition-none',
          collapsed ? 'opacity-0' : '',
        ].join(' ');
        it.children = it.children.map((c) => ({ ...c, linkClass: childLinkClass(c.active) }));
      } else if (it.kind === 'link') {
        it.linkClass = linkClass(it.active);
        it.ariaCurrent = it.active ? 'page' : false;
      }
    });

    const toggleLabel = collapsed ? 'Expand sidebar' : 'Collapse sidebar';

    return {
      items,
      collapsed,
      labelClass,
      navLabel: props.label || 'Main',
      // Badges ride the same fade as labels — kept mounted, clipped by the row.
      badgeClass: [
        BADGE,
        'transition-opacity duration-200 motion-reduce:transition-none',
        collapsed ? 'opacity-0' : '',
      ].join(' '),
      badgeStatic: BADGE,
      flyoutClass: FLYOUT,
      flyoutHeadingClass: FLYOUT_HEADING,
      flyoutStyle: `left:${this._flyoutPos.left}px;top:${this._flyoutPos.top}px;`,
      toggleLabel,
      toggleClass: [
        ROW_BASE,
        ROW_PAD,
        'w-full cursor-pointer',
        IDLE,
      ].join(' '),
      rootClass: [NAV_BASE, collapsed ? 'w-[3.75rem]' : 'w-64', props.class || ''].join(' '),
    };
  }

  // ---- animated submenu regions (adapted inline from Collapsible) ----------

  // Set every visible region to its resting height on mount, then let afterUpdate
  // animate transitions. Regions that appear later (e.g. after expanding the rail)
  // are initialized on their first afterUpdate pass instead.
  mounted() {
    this._syncRegions(true);
  }

  afterUpdate() {
    // An outside-controlled expansion removes the panel before closeFlyout runs.
    if (this._flyoutIndex !== null && !this._collapsed()) this.closeFlyout();
    if (this._needsFlyoutClamp) {
      this._needsFlyoutClamp = false;
      this._clampFlyout();
    }
    this._syncRegions(false);
  }

  destroyed() {
    if (this._flyoutBound) {
      document.removeEventListener('pointerdown', this._onDocPointerDown);
      window.removeEventListener('scroll', this._onFlyoutDismiss, true);
      window.removeEventListener('resize', this._onFlyoutDismiss);
      this._flyoutBound = false;
    }
    if (!this.element) return;
    this.element.querySelectorAll('[data-sidebar-submenu]').forEach((body) => {
      if (body._pzAnim) {
        body._pzAnim.cancel();
        body._pzAnim = null;
      }
    });
  }

  _reducedMotion() {
    return (
      typeof matchMedia === 'function' &&
      matchMedia('(prefers-reduced-motion: reduce)').matches
    );
  }

  // Walk the mounted submenu regions and reconcile their height with open state:
  // fresh/uninitialized regions snap to their resting height; a changed open flag
  // animates. `initial` (mount) always snaps — no opening animation on first paint.
  _syncRegions(initial) {
    if (!this.element) return;
    this.element.querySelectorAll('[data-sidebar-submenu]').forEach((body) => {
      const idx = body.getAttribute('data-index');
      const open = this._regionOpen(idx);
      const prev = this._regionState[idx];
      const hasHeight = body.style.height !== '';
      if (initial || prev === undefined || !hasHeight) {
        this._cancelAnim(body);
        body.style.height = open ? 'auto' : '0px';
      } else if (prev !== open) {
        this._animateRegion(body, open);
      }
      this._regionState[idx] = open;
    });
  }

  _cancelAnim(body) {
    if (body._pzAnim) {
      body._pzAnim.cancel();
      body._pzAnim = null;
    }
  }

  _animateRegion(body, open) {
    const current = body.getBoundingClientRect().height;
    this._cancelAnim(body);

    if (this._reducedMotion()) {
      body.style.height = open ? 'auto' : '0px';
      return;
    }

    if (open) {
      const target = body.scrollHeight;
      body.style.height = `${target}px`;
      const anim = body.animate(
        [{ height: `${current}px` }, { height: `${target}px` }],
        { duration: 220, easing: 'ease' }
      );
      body._pzAnim = anim;
      anim.onfinish = () => {
        body._pzAnim = null;
        // Leave it at auto so later content changes reflow — only if still open.
        if (this._regionOpen(body.getAttribute('data-index'))) body.style.height = 'auto';
      };
    } else {
      body.style.height = '0px';
      const anim = body.animate(
        [{ height: `${current}px` }, { height: '0px' }],
        { duration: 220, easing: 'ease' }
      );
      body._pzAnim = anim;
      anim.onfinish = () => {
        body._pzAnim = null;
      };
    }
  }

  events = {
    toggleSubmenu: (index) => {
      if (this._collapsed()) {
        // Collapsed submenus pop out to the right, one at a time. Preserve
        // _openMap so expanded disclosure state survives a collapsed round trip.
        if (this._flyoutIndex === index) this.closeFlyout({ refocus: false });
        else this.openFlyout(index);
        return;
      }
      this._openMap[index] = !this._openMap[index];
      this.refresh();
    },

    toggleCollapsed: () => {
      this._requestCollapsed(!this._collapsed());
      if (!this._collapsedControlled()) this.refresh();
    },

    onFlyoutEscape: (event) => {
      if (this._flyoutIndex === null) return;
      event.preventDefault();
      this.closeFlyout({ refocus: true });
    },

    // Deliberately do not preventDefault: navigation proceeds after dismissal.
    onFlyoutLink: () => { this.closeFlyout({ refocus: false }); },
  };
}
</script>
