{
	"name": "@magic-spells/puzzle-devtools",
	"version": "0.1.0",
	"private": true,
	"description": "Chrome DevTools extension for the Puzzle framework — inspects views, store records, subscriptions, and routes through the dev-only runtime bridge",
	"type": "module",
