	},
	"dependencies": {
		"@magic-spells/puzzle": "file:../puzzle"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.2",
		"jsdom": "^26.1.0",
		"tailwindcss": "^4.3.2",
		"vitest": "^3.2.4"
	}
}
