{
	"name": "@magic-spells/puzzle-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Monorepo shell — the framework and everything that releases in lockstep with it live under packages/. Nothing publishes from this root.",
	"scripts": {
		"test": "npm test --prefix packages/puzzle",
		"build:compiler": "npm run build:compiler --prefix packages/puzzle",
		"release:prep": "npm run release:prep --prefix packages/puzzle",
		"verify:pack": "npm run verify:pack --prefix packages/puzzle",
		"verify:published": "npm run verify:published --prefix packages/puzzle",
		"measure:size": "npm run measure:size --prefix packages/puzzle"
	}
}
